{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Local": {
      "PasswordRequiredLength": 12,
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    },
    "OAuth": {
      "Enabled": false
    }
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "AllowedEnvironments": [ "Development" ]
  },
  "DeletionSafety": {
    "RequireTypedConfirmationAbove": 50
  },
  "AllowedHosts": "*"
}
