@using Landscape.Tsi.Application.Identity
@model Landscape.Tsi.Web.Models.LocalUserDetailViewModel
@{ ViewData["Title"] = "Detalle de usuario"; }
<nav class="breadcrumbs" aria-label="Migas de pan"><a asp-action="Users">Usuarios</a><span aria-hidden="true">›</span><span>@Model.User.UserName</span></nav>
<section class="admin-shell" aria-labelledby="detail-title"><div class="page-heading"><div><p class="eyebrow">USUARIO LOCAL</p><h1 id="detail-title">@Model.User.UserName</h1><p class="supporting-text">@(Model.User.IsActive ? "Activo" : "Inactivo")</p></div><a class="md-button md-button-text" asp-action="EditUser" asp-route-userId="@Model.User.Id">Editar</a></div>
<div class="detail-grid"><div><h2>Datos básicos</h2><dl><dt>Usuario</dt><dd>@Model.User.UserName</dd><dt>Estado</dt><dd>@(Model.User.IsActive ? "Activo" : "Inactivo")</dd><dt>Vigencia</dt><dd>@(Model.User.ValidUntilUtc?.ToString("yyyy-MM-dd") ?? "Sin vencimiento")</dd></dl></div><div><h2>Roles</h2><ul>@if (Model.User.Roles.Count == 0) { <li>Sin roles</li> } @foreach (var role in Model.User.Roles) { <li>@role.Name <form asp-action="ChangeUserRole" asp-route-userId="@Model.User.Id" method="post" class="inline-form"><input type="hidden" name="roleCode" value="@role.Code" /><input type="hidden" name="assign" value="false" /><input type="hidden" name="justification" value="Retiro administrativo de rol" /><button class="md-button md-button-text" type="submit">Quitar</button></form></li> }</ul>@if (Model.Roles.Count > Model.User.Roles.Count) { <form asp-action="ChangeUserRole" asp-route-userId="@Model.User.Id" method="post" class="stacked-form"><label for="roleCode">Agregar rol</label><select id="roleCode" name="roleCode">@foreach (var role in Model.Roles.Where(role => !Model.User.Roles.Any(existing => existing.Code == role.Code))) { <option value="@role.Code">@role.Name</option> }</select><input type="hidden" name="assign" value="true" /><label for="roleJustification">Justificación</label><input id="roleJustification" name="justification" required value="Asignación administrativa" /><button class="md-button md-button-filled" type="submit">Asignar</button></form>}</div></div>
<div class="form-actions"><a class="md-button md-button-text" asp-action="ResetPassword" asp-route-userId="@Model.User.Id">Restablecer contraseña</a><form asp-action="SetUserState" asp-route-userId="@Model.User.Id" method="post" class="inline-form"><input type="hidden" name="active" value="@(!Model.User.IsActive)" /><input type="hidden" name="justification" value="Cambio de estado administrativo" /><button class="md-button md-button-text" type="submit">@(Model.User.IsActive ? "Desactivar" : "Activar")</button></form></div>
<section aria-labelledby="scope-title"><h2 id="scope-title">Alcance organizacional</h2><p class="supporting-text">La autorización efectiva requiere permiso y alcance vigente.</p><ul>@if (Model.Scopes.Count == 0) { <li>Sin alcance asignado</li> } @foreach (var scope in Model.Scopes) { <li>@(scope.IsCorporateScope ? "Corporativo" : $"Subsidiaria {scope.EmpresaSubsidiariaId}") · desde @scope.ValidFromUtc.ToString("u") · @(scope.ValidUntilUtc?.ToString("u") ?? "vigente") @if (scope.ValidUntilUtc is null) { <form asp-action="RevokeScope" asp-route-userId="@Model.User.Id" asp-route-scopeId="@scope.Id" method="post" class="inline-form"><input type="hidden" name="justification" value="Retiro administrativo de alcance" /><button class="md-button md-button-text" type="submit">Retirar</button></form> }</li> }</ul>@if (Model.Approvers.Count > 0 && !Model.Scopes.Any(x => x.IsCorporateScope && x.ValidUntilUtc is null)) { <form asp-action="AssignCorporateScope" asp-route-userId="@Model.User.Id" method="post" class="stacked-form"><label for="approvedByUserId">Aprobador SYSTEM_ADMINISTRATOR</label><select id="approvedByUserId" name="approvedByUserId" required>@foreach (var approver in Model.Approvers) { <option value="@approver.Id">@approver.UserName</option> }</select><label for="scopeJustification">Justificación</label><input id="scopeJustification" name="justification" required value="Configuración de alcance corporativo DEV" /><label for="validUntilUtc">Vigencia hasta (opcional)</label><input id="validUntilUtc" name="validUntilUtc" type="datetime-local" /><button class="md-button md-button-filled" type="submit">Asignar alcance corporativo</button></form> }</section>
<section aria-labelledby="audit-title"><h2 id="audit-title">Auditoría relacionada</h2><div class="responsive-table"><table><thead><tr><th>Fecha UTC</th><th>Acción</th><th>Resultado</th><th>Actor</th></tr></thead><tbody>@if (Model.Audit.Count == 0) { <tr><td colspan="4">No hay eventos.</td></tr> } @foreach (var item in Model.Audit) { <tr><td>@item.OccurredAtUtc.ToString("u")</td><td>@item.EventType</td><td>@item.Result</td><td>@(item.ActorUserId?.ToString() ?? "Sistema")</td></tr> }</tbody></table></div></section></section>
