@model Landscape.Tsi.Web.Models.LocalUserCreateViewModel
@{ ViewData["Title"] = "Crear usuario local"; }
<nav class="breadcrumbs" aria-label="Migas de pan"><a asp-action="Users">Usuarios</a><span aria-hidden="true">›</span><span>Crear</span></nav>
<section class="form-shell" aria-labelledby="create-user-title"><h1 id="create-user-title">Crear usuario local</h1><form asp-action="CreateUser" method="post" class="stacked-form"><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><label asp-for="UserName"></label><input asp-for="UserName" autocomplete="username" /><span asp-validation-for="UserName"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span><label asp-for="ValidFromUtc"></label><input asp-for="ValidFromUtc" type="datetime-local" /><label asp-for="ValidUntilUtc"></label><input asp-for="ValidUntilUtc" type="datetime-local" /><label asp-for="Justification"></label><textarea asp-for="Justification" rows="3"></textarea><span asp-validation-for="Justification"></span><div class="form-actions"><button class="md-button md-button-filled" type="submit">Crear usuario</button><a class="md-button md-button-text" asp-action="Users">Cancelar</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
