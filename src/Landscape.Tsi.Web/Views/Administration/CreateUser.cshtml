@model Landscape.Tsi.Web.Models.LocalUserCreateViewModel
@{
    ViewData["Title"] = "Crear usuario local";
}
<nav class="breadcrumbs" aria-label="Migas de pan">
    <a asp-controller="Home" asp-action="Index">Inicio</a>
    <span aria-hidden="true">›</span>
    <a asp-action="Index">Administración</a>
    <span aria-hidden="true">›</span>
    <a asp-action="Users">Usuarios locales</a>
    <span aria-hidden="true">›</span>
    <span>Crear</span>
</nav>

<section class="admin-shell" aria-labelledby="create-user-title">
    <div class="page-heading">
        <div>
            <p class="eyebrow">IDENTIDAD LOCAL</p>
            <h1 id="create-user-title">Crear usuario local</h1>
            <p class="supporting-text">Registre una nueva cuenta de identidad local en ASP.NET Core Identity con vigencia y justificación de auditoría.</p>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="app-alert app-alert-error mb-4" role="alert">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card p-4 shadow-sm border-0">
                <form asp-action="CreateUser" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="UserName" class="form-label fw-bold">Nombre de usuario <span class="text-danger">*</span></label>
                            <input asp-for="UserName" class="form-control" autocomplete="username" placeholder="ej. usuario.corp o nombre.apellido" required autofocus />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                            <div class="form-text">Identificador único que se empleará para el inicio de sesión local.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold">Contraseña <span class="text-danger">*</span></label>
                            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" placeholder="Mínimo 8 caracteres" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text">Debe contener al menos una letra mayúscula y 8 caracteres.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirmar contraseña <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" placeholder="Repita la contraseña" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ValidFromUtc" class="form-label fw-bold">Vigencia desde (UTC)</label>
                            <input asp-for="ValidFromUtc" type="datetime-local" class="form-control" />
                            <div class="form-text">Momento a partir del cual la cuenta podrá autenticarse.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ValidUntilUtc" class="form-label fw-bold">Vigencia hasta (UTC - opcional)</label>
                            <input asp-for="ValidUntilUtc" type="datetime-local" class="form-control" />
                            <div class="form-text">Dejar vacío si la cuenta no tiene expiración programada.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Justification" class="form-label fw-bold">Justificación de creación <span class="text-danger">*</span></label>
                            <textarea asp-for="Justification" class="form-control" rows="3" placeholder="Indique el motivo técnico o administrativo para registrar esta cuenta de usuario (requerido para trazabilidad de auditoría)" required></textarea>
                            <span asp-validation-for="Justification" class="text-danger small"></span>
                            <div class="form-text">Este motivo quedará registrado en la bitácora inmutable de auditoría.</div>
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
                            <a class="md-button md-button-text" asp-action="Users">Cancelar</a>
                            <button class="md-button md-button-filled" type="submit">Crear usuario</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
