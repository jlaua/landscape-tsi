@model Landscape.Tsi.Web.Models.LocalUserEditViewModel
@{ ViewData["Title"] = "Editar usuario"; }
<nav class="breadcrumbs" aria-label="Migas de pan"><a asp-action="Users">Usuarios</a><span aria-hidden="true">›</span><span>Editar</span></nav>
<section class="form-shell" aria-labelledby="edit-user-title"><h1 id="edit-user-title">Editar usuario</h1><form asp-action="EditUser" asp-route-userId="@Model.UserId" method="post" class="stacked-form"><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><label asp-for="UserName"></label><input asp-for="UserName" autocomplete="username" /><span asp-validation-for="UserName"></span><label asp-for="ValidFromUtc"></label><input asp-for="ValidFromUtc" type="datetime-local" /><label asp-for="ValidUntilUtc"></label><input asp-for="ValidUntilUtc" type="datetime-local" /><label asp-for="Justification"></label><textarea asp-for="Justification" rows="3"></textarea><span asp-validation-for="Justification"></span><div class="form-actions"><button class="md-button md-button-filled" type="submit">Guardar cambios</button><a class="md-button md-button-text" asp-action="UserDetails" asp-route-userId="@Model.UserId">Cancelar</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
