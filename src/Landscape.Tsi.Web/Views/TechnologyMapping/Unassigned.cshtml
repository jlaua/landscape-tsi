@model Landscape.Tsi.Web.Models.UnassignedTechnologiesViewModel
@{ ViewData["Title"] = "Tecnologías sin asignar"; }
<section class="admin-shell" aria-labelledby="unassigned-title">
<nav class="mapping-view-switch" aria-label="Vista de mapeo"><a class="md-button md-button-text" asp-action="Index">Por Building Block</a><a class="md-button md-button-tonal" asp-action="Unassigned" aria-current="page">Tecnologías sin asignar</a></nav><h1 id="unassigned-title">Tecnologías sin asignar</h1>
<form method="get" class="filter-bar"><div class="md-field"><label for="Search">Buscar tecnología</label><input id="Search" name="Search" value="@Model.Query.Search" type="search" /></div><div class="md-field"><label for="FamilyId">Familia</label><select id="FamilyId" name="FamilyId"><option value="">Todas</option>@foreach(var family in Model.Page.Families){<option value="@family.Id" selected="@(Model.Query.FamilyId == family.Id ? "selected" : null)">@family.Name</option>}</select></div><button class="md-button md-button-filled">Filtrar</button></form>
<div class="responsive-table"><table><thead><tr><th>Tecnología TSI</th><th>Familia</th><th>Estado</th><th>Asignar</th></tr></thead><tbody>@if(Model.Page.Items.Count == 0){<tr><td colspan="4">No existen Tecnologías TSI sin asignar.</td></tr>}@foreach(var technology in Model.Page.Items){<tr><td data-label="Tecnología"><a href="@technology.DetailRoute">@technology.Name</a></td><td data-label="Familia">@(technology.FamilyName ?? "Sin familia")</td><td data-label="Estado">@(technology.AdoptionStateName ?? "No definido")</td><td data-label="Asignar"><form method="post" asp-action="Associate" class="mapping-assign-form"><input type="hidden" name="technologyId" value="@technology.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" /><select name="buildingBlockId" aria-label="Building Block para @technology.Name" required><option value="">Seleccione</option>@foreach(var block in Model.Page.BuildingBlocks){<option value="@block.Id">@block.Name</option>}</select><button class="md-button md-button-filled" type="submit">Asociar</button></form></td></tr>}</tbody></table></div>
<nav class="pagination" aria-label="Paginación de Tecnologías sin asignar"><span>@Model.Page.TotalCount Tecnologías</span>@if(Model.Page.Page > 1){<a asp-route-Page="@(Model.Page.Page-1)" asp-route-Search="@Model.Query.Search" asp-route-FamilyId="@Model.Query.FamilyId">Anterior</a>}<span>Página @Model.Page.Page de @Model.TotalPages</span>@if(Model.Page.Page < Model.TotalPages){<a asp-route-Page="@(Model.Page.Page+1)" asp-route-Search="@Model.Query.Search" asp-route-FamilyId="@Model.Query.FamilyId">Siguiente</a>}</nav>
</section>
