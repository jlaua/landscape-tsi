@model Landscape.Tsi.Web.Models.BuildingTechnologyRelationsViewModel
@{ ViewData["Title"] = "Administrar Tecnologías TSI"; var associated = Model.Relation.Technologies.Where(x => x.Selected).ToArray(); var available = Model.Relation.Technologies.Where(x => !x.Selected).ToArray(); }
<section class="admin-shell" aria-labelledby="building-relations-title">
<nav aria-label="Ruta de navegación"><ol class="breadcrumb-list"><li><a asp-action="Index">Mapeo</a></li><li aria-current="page">Administrar tecnologías</li></ol></nav>
<h1 id="building-relations-title">Administrar Tecnologías TSI</h1>
<dl class="mapping-context"><div><dt>Building Block</dt><dd>@Model.Relation.BuildingBlockName</dd></div><div><dt>Dominio</dt><dd>@(Model.Relation.DomainName ?? "No definido")</dd></div><div><dt>Actualmente relacionadas</dt><dd>@associated.Length</dd></div></dl>
<section aria-labelledby="associated-title"><h2 id="associated-title">Tecnologías actualmente asociadas</h2>
@if (associated.Length == 0) { <p class="empty-state">Este Building Block todavía no tiene Tecnologías TSI asociadas.</p> }
else { <div class="responsive-table"><table><thead><tr><th>Tecnología TSI</th><th>Familia</th><th>Estado de adopción</th><th>Acciones</th></tr></thead><tbody>@foreach (var technology in associated) { <tr><td data-label="Tecnología TSI">@technology.Name</td><td data-label="Familia">@(technology.FamilyName ?? "Sin familia")</td><td data-label="Estado de adopción">@(technology.AdoptionStateName ?? "No definido")</td><td data-label="Acciones"><a class="md-button md-button-text" href="@technology.DetailRoute">Ver</a><form method="post" asp-action="Disassociate" asp-route-buildingBlockId="@Model.Relation.BuildingBlockId" asp-route-technologyId="@technology.Id" class="inline-form" onsubmit="return confirm('Se eliminará únicamente esta relación. ¿Desea continuar?');"><button class="md-button md-button-text" type="submit">Desasociar</button></form></td></tr> }</tbody></table></div> }</section>
<section aria-labelledby="available-title"><h2 id="available-title">Agregar Tecnología TSI</h2>
<form method="get" asp-action="BuildingBlockRelations" class="filter-bar"><input type="hidden" name="buildingBlockId" value="@Model.Relation.BuildingBlockId" /><div class="md-field"><label for="search">Buscar tecnología</label><input id="search" name="search" value="@Model.Search" type="search" /></div><div class="md-field"><label for="familyId">Familia</label><select id="familyId" name="familyId"><option value="">Todas</option>@foreach (var family in Model.Families) { <option value="@family.Id" selected="@(Model.FamilyId == family.Id ? "selected" : null)">@family.Name</option> }</select></div><button class="md-button md-button-filled" type="submit">Filtrar</button></form>
@if (available.Length == 0) { <p class="empty-state">No hay Tecnologías disponibles para los filtros seleccionados.</p> }
else { <div class="responsive-table"><table><thead><tr><th>Tecnología TSI</th><th>Familia</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach (var technology in available) { <tr><td data-label="Tecnología TSI">@technology.Name</td><td data-label="Familia">@(technology.FamilyName ?? "Sin familia")</td><td data-label="Estado">@(technology.AdoptionStateName ?? "No definido")</td><td data-label="Acciones"><a class="md-button md-button-text" href="@technology.DetailRoute">Ver</a><form method="post" asp-action="Associate" asp-route-buildingBlockId="@Model.Relation.BuildingBlockId" asp-route-technologyId="@technology.Id" class="inline-form"><button class="md-button md-button-filled" type="submit">Asociar</button></form></td></tr> }</tbody></table></div> }</section>
</section>
