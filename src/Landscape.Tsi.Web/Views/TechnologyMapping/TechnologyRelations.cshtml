@model Landscape.Tsi.Web.Models.TechnologyRelationsViewModel
<section class="admin-shell" aria-labelledby="technology-relations-title"><nav aria-label="Ruta de navegación"><ol class="breadcrumb-list"><li><a asp-controller="Home" asp-action="Index">Inicio</a></li><li><a asp-action="Index">Mapeo de Tecnologías TSI</a></li><li aria-current="page">@Model.Relation.TechnologyName</li></ol></nav><h1 id="technology-relations-title">Administrar relaciones</h1><p>Tecnología TSI: <strong>@Model.Relation.TechnologyName</strong></p><p>Familia: @(Model.Relation.FamilyName ?? "No definida")</p>
<form method="post" asp-action="TechnologyRelations" onsubmit="return confirm('Esta operación eliminará únicamente las relaciones desmarcadas entre la Tecnología TSI y sus Building Blocks. Ninguna de las dos entidades será eliminada. ¿Desea continuar?');"><input type="hidden" name="technologyId" value="@Model.Relation.TechnologyId" /><input type="hidden" name="returnUrl" value="@Model.ReturnUrl" /><fieldset><legend>Building Blocks relacionados</legend>@foreach (var block in Model.Relation.BuildingBlocks) { <label class="selection-row"><input type="checkbox" name="buildingBlockIds" value="@block.Id" checked="@(block.Selected ? "checked" : null)" /> <span>@block.Name</span></label> }</fieldset><p class="supporting-text">Desmarcar una relación la <strong>desasocia</strong>; no elimina la Tecnología ni el Building Block.</p><button class="md-button md-button-filled" type="submit">Guardar relaciones</button><a class="md-button md-button-text" asp-action="Index">Cancelar</a></form></section>
