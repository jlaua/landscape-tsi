@using Landscape.Tsi.Application.Catalogs
@using Landscape.Tsi.Application.Identity
@model Landscape.Tsi.Web.Models.CatalogDetailViewModel
@{ ViewData["Title"] = $"Detalle de {Model.Definition.Name}"; var editorModel = new Landscape.Tsi.Web.Models.CatalogEditorViewModel { Definition = Model.Definition, Record = Model.Record, Options = Model.Options }; }
<nav aria-label="Ruta de navegación"><ol class="breadcrumb-list"><li><a asp-controller="Home" asp-action="Index">Inicio</a></li><li><span aria-hidden="true">/</span> <a asp-controller="Home" asp-action="Index" asp-fragment="catalog-map">Mapa del Catálogo</a></li><li><span aria-hidden="true">/</span> <a asp-action="Index">Tablas Maestras</a></li><li><span aria-hidden="true">/</span> <a asp-action="Catalog" asp-route-catalogRoute="@Model.Definition.Route">@Model.Definition.Name</a></li><li aria-current="page"><span aria-hidden="true">/</span> Detalle</li></ol></nav>
<section class="catalog-shell" aria-labelledby="catalog-record-title">
    <div class="page-heading">
        <div>
            <p class="eyebrow">DETALLE</p>
            <h1 id="catalog-record-title">
                @if (Model.Definition.Route == "tecnologia-tsi-implementada" && Model.Record.DisplayValues.ContainsKey("empresa") && Model.Record.DisplayValues.ContainsKey("tecnologia"))
                {
                    <span>@(Model.Record.DisplayValues.GetValueOrDefault("empresa") ?? "Empresa") — @(Model.Record.DisplayValues.GetValueOrDefault("tecnologia") ?? "Tecnología")</span>
                }
                else
                {
                    @(Model.Record.DisplayValues.GetValueOrDefault(Model.Definition.DisplayColumnCode) ?? "Registro sin nombre")
                }
            </h1>
        </div>
        <partial name="_EntityDetailActions" model="Model" />
    </div>
    @if (TempData["SuccessMessage"] is string success) { <div class="app-alert app-alert-success" role="status">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="app-alert app-alert-error" role="alert">@error</div> }
    @if (Model.Definition.Route == "building-block" && User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
    {
        <form id="quick-bb-form" method="post" asp-action="UpdateBuildingBlockQuickFields" asp-route-id="@Model.Record.Id">
            @Html.AntiForgeryToken()
            <dl class="detail-grid">
                @foreach (var column in Model.Definition.Columns)
                {
                    if (column.Code == "faseAdopcion")
                    {
                        <div class="detail-field">
                            <dt>@column.Label</dt>
                            <dd>
                                <select class="form-select form-select-sm" name="faseAdopcion" style="max-width: 280px; display: inline-block;">
                                    <option value="">-- Sin asignar --</option>
                                    @if (Model.Options.TryGetValue("faseAdopcion", out var fases))
                                    {
                                        var currentVal = Model.Record.Values.GetValueOrDefault("faseAdopcion")?.ToString();
                                        foreach (var f in fases)
                                        {
                                            var isSelected = string.Equals(f.Id.ToString(), currentVal, StringComparison.OrdinalIgnoreCase)
                                                || string.Equals(f.Label, Model.Record.DisplayValues.GetValueOrDefault("faseAdopcion"), StringComparison.OrdinalIgnoreCase);
                                            if (isSelected)
                                            {
                                                <option value="@f.Id" selected>@f.Label</option>
                                            }
                                            else
                                            {
                                                <option value="@f.Id">@f.Label</option>
                                            }
                                        }
                                    }
                                </select>
                            </dd>
                        </div>
                    }
                    else if (column.Code == "rutaEntregable")
                    {
                        <div class="detail-field detail-field-wide">
                            <dt>@column.Label</dt>
                            <dd>
                                <input type="text" class="form-control form-control-sm" name="rutaEntregable" value="@Model.Record.DisplayValues.GetValueOrDefault("rutaEntregable")" placeholder="Ruta documental o repositorio del entregable" />
                            </dd>
                        </div>
                    }
                    else
                    {
                        <div class="detail-field @(column.IsMultiline ? "detail-field-wide" : null)">
                            <dt>@column.Label</dt>
                            <dd>@(Model.Record.DisplayValues.GetValueOrDefault(column.Code) ?? "—")</dd>
                        </div>
                    }
                }
            </dl>
            <div class="mt-2 mb-3 text-end">
                <button type="submit" class="md-button md-button-filled">Guardar cambios</button>
            </div>
        </form>
    }
    else
    {
        <dl class="detail-grid">
            @foreach (var column in Model.Definition.Columns)
            {
                var displayVal = Model.Record.DisplayValues.GetValueOrDefault(column.Code) ?? "—";
                var rawVal = Model.Record.Values.GetValueOrDefault(column.Code);
                <div class="detail-field @(column.IsMultiline ? "detail-field-wide" : null)">
                    <dt>@column.Label</dt>
                    <dd>
                        @if (!string.IsNullOrWhiteSpace(column.ReferenceCatalogCode) && rawVal is int refId && displayVal != "—")
                        {
                            <a class="text-primary text-decoration-underline" asp-action="CatalogDetails" asp-route-catalogRoute="@column.ReferenceCatalogCode" asp-route-id="@refId">@displayVal</a>
                        }
                        else
                        {
                            @displayVal
                        }
                    </dd>
                </div>
            }
        </dl>
    }
</section>
@if (Model.Definition.Route == "tecnologia-tsi-implementada")
{
    <section class="report-card related-entities-card" aria-labelledby="impl-tech-children-title">
        <p class="eyebrow">ENTIDADES HIJAS Y DETALLES ASOCIADOS</p>
        <h2 id="impl-tech-children-title">Contratos, Modelo de Operación y Drivers</h2>

        <div class="report-kpi-grid mb-4">
            <div class="report-kpi">
                <span class="report-kpi-value">@(Model.ImplementedContracts?.TotalCount ?? 0)</span>
                <span class="report-kpi-label">Contratos y Adendas</span>
            </div>
            <div class="report-kpi">
                <span class="report-kpi-value">@(Model.ImplementedOperationModels?.TotalCount ?? 0)</span>
                <span class="report-kpi-label">Modelos de Operación</span>
            </div>
            <div class="report-kpi">
                <span class="report-kpi-value">@(Model.ImplementedDrivers?.TotalCount ?? 0)</span>
                <span class="report-kpi-label">Drivers Operativos</span>
            </div>
            <div class="report-kpi">
                <span class="report-kpi-value">@(Model.ImplementedServices?.TotalCount ?? 0)</span>
                <span class="report-kpi-label">Servicios de TI Vinculados</span>
            </div>
        </div>

        <!-- 1. Contratos y Adendas -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <h3 class="h5 mb-0">Contratos y Adendas de la Tecnología <span class="result-count">(@(Model.ImplementedContracts?.TotalCount ?? 0))</span></h3>
                @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogCreate))
                {
                    <a class="md-button md-button-tonal" asp-action="Catalog" asp-route-catalogRoute="contrato-tecnologia">Ver Catálogo Contratos</a>
                }
            </div>
            @if (Model.ImplementedContracts is null || Model.ImplementedContracts.TotalCount == 0)
            {
                <p class="empty-state">No existen contratos ni adendas registrados para esta tecnología implementada.</p>
            }
            else
            {
                <div class="responsive-table" role="region" aria-label="Contratos y adendas relacionados" tabindex="0">
                    <table>
                        <thead>
                            <tr>
                                <th>N° Contrato</th>
                                <th>Tipo</th>
                                <th>PAYG</th>
                                <th>Fecha Inicio</th>
                                <th>Fecha Fin</th>
                                <th>Monto</th>
                                <th>Moneda</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ImplementedContracts.Items)
                            {
                                var esAdenda = string.Equals(row.DisplayValues.GetValueOrDefault("esAdenda"), "true", StringComparison.OrdinalIgnoreCase) || string.Equals(row.DisplayValues.GetValueOrDefault("esAdenda"), "1", StringComparison.OrdinalIgnoreCase);
                                var esPayg = string.Equals(row.DisplayValues.GetValueOrDefault("esPayg"), "true", StringComparison.OrdinalIgnoreCase) || string.Equals(row.DisplayValues.GetValueOrDefault("esPayg"), "1", StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td data-label="N° Contrato">
                                        <strong>@row.DisplayValues.GetValueOrDefault("numeroContrato")</strong>
                                    </td>
                                    <td data-label="Tipo">
                                        @if (esAdenda)
                                        {
                                            <span class="badge bg-secondary">Adenda</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Principal</span>
                                        }
                                    </td>
                                    <td data-label="PAYG">
                                        @if (esPayg)
                                        {
                                            <span class="badge bg-info text-dark">PAYG</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No</span>
                                        }
                                    </td>
                                    <td data-label="Fecha Inicio">
                                        @(esPayg ? "PAYG" : (row.DisplayValues.GetValueOrDefault("fechaInicio") ?? "—"))
                                    </td>
                                    <td data-label="Fecha Fin">
                                        @(esPayg ? "PAYG" : (row.DisplayValues.GetValueOrDefault("fechaFin") ?? "—"))
                                    </td>
                                    <td data-label="Monto">
                                        @(row.DisplayValues.GetValueOrDefault("montoContratado") ?? "—")
                                    </td>
                                    <td data-label="Moneda">
                                        @(row.DisplayValues.GetValueOrDefault("moneda") ?? "—")
                                    </td>
                                    <td class="table-actions">
                                        <a class="md-button md-button-text" asp-action="CatalogDetails" asp-route-catalogRoute="contrato-tecnologia" asp-route-id="@row.Id">Ver</a>
                                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                        {
                                            <a class="md-button md-button-text" asp-action="CatalogEditForm" asp-route-catalogRoute="contrato-tecnologia" asp-route-id="@row.Id">Editar</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- 2. Modelo de Operación -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <h3 class="h5 mb-0">Modelo de Operación <span class="result-count">(@(Model.ImplementedOperationModels?.TotalCount ?? 0))</span></h3>
                @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogCreate))
                {
                    <a class="md-button md-button-tonal" asp-action="Catalog" asp-route-catalogRoute="modelo-operacion">Ver Catálogo Modelos</a>
                }
            </div>
            @if (Model.ImplementedOperationModels is null || Model.ImplementedOperationModels.TotalCount == 0)
            {
                <p class="empty-state">No se ha configurado un modelo de operación para esta tecnología implementada.</p>
            }
            else
            {
                <div class="responsive-table" role="region" aria-label="Modelos de operación relacionados" tabindex="0">
                    <table>
                        <thead>
                            <tr>
                                <th>Tipo de Operación</th>
                                <th>Modalidad Laboral</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ImplementedOperationModels.Items)
                            {
                                <tr>
                                    <td data-label="Tipo de Operación">
                                        <strong>@(row.DisplayValues.GetValueOrDefault("tipoOperacion") ?? "No especificado")</strong>
                                    </td>
                                    <td data-label="Modalidad Laboral">
                                        @(row.DisplayValues.GetValueOrDefault("modalidadLaboral") ?? "No especificada")
                                    </td>
                                    <td class="table-actions">
                                        <a class="md-button md-button-text" asp-action="CatalogDetails" asp-route-catalogRoute="modelo-operacion" asp-route-id="@row.Id">Ver</a>
                                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                        {
                                            <a class="md-button md-button-text" asp-action="CatalogEditForm" asp-route-catalogRoute="modelo-operacion" asp-route-id="@row.Id">Editar</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- 3. Drivers Operativos -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <h3 class="h5 mb-0">Drivers de Costo y Volumetría <span class="result-count">(@(Model.ImplementedDrivers?.TotalCount ?? 0))</span></h3>
                @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogCreate))
                {
                    <a class="md-button md-button-tonal" asp-action="Catalog" asp-route-catalogRoute="driver">Ver Catálogo Drivers</a>
                }
            </div>
            @if (Model.ImplementedDrivers is null || Model.ImplementedDrivers.TotalCount == 0)
            {
                <p class="empty-state">No existen drivers operativos registrados para esta tecnología implementada.</p>
            }
            else
            {
                <div class="responsive-table" role="region" aria-label="Drivers relacionados" tabindex="0">
                    <table>
                        <thead>
                            <tr>
                                <th>Descripción del Driver</th>
                                <th>Unidad de Medida</th>
                                <th>Cantidad</th>
                                <th>Precio Unitario</th>
                                <th>Moneda</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ImplementedDrivers.Items)
                            {
                                <tr>
                                    <td data-label="Descripción">
                                        <strong>@row.DisplayValues.GetValueOrDefault("descripcionDriver")</strong>
                                    </td>
                                    <td data-label="Unidad de Medida">
                                        @(row.DisplayValues.GetValueOrDefault("unidadMedida") ?? "—")
                                    </td>
                                    <td data-label="Cantidad">
                                        @(row.DisplayValues.GetValueOrDefault("cantidad") ?? "—")
                                    </td>
                                    <td data-label="Precio Unitario">
                                        @(row.DisplayValues.GetValueOrDefault("precioUnitario") ?? "—")
                                    </td>
                                    <td data-label="Moneda">
                                        @(row.DisplayValues.GetValueOrDefault("moneda") ?? "USD")
                                    </td>
                                    <td class="table-actions">
                                        <a class="md-button md-button-text" asp-action="CatalogDetails" asp-route-catalogRoute="driver" asp-route-id="@row.Id">Ver</a>
                                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                        {
                                            <a class="md-button md-button-text" asp-action="CatalogEditForm" asp-route-catalogRoute="driver" asp-route-id="@row.Id">Editar</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- 4. Servicios de TI Vinculados -->
        <div class="mb-2">
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <h3 class="h5 mb-0">Servicios de TI Vinculados <span class="result-count">(@(Model.ImplementedServices?.TotalCount ?? 0))</span></h3>
                @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogCreate))
                {
                    <a class="md-button md-button-tonal" asp-action="Catalog" asp-route-catalogRoute="servicio-tecnologia">Ver Catálogo Servicios</a>
                }
            </div>
            @if (Model.ImplementedServices is null || Model.ImplementedServices.TotalCount == 0)
            {
                <p class="empty-state">No existen servicios de TI vinculados a esta tecnología implementada.</p>
            }
            else
            {
                <div class="responsive-table" role="region" aria-label="Servicios relacionados" tabindex="0">
                    <table>
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre del Servicio</th>
                                <th>Tipo de Servicio</th>
                                <th>Proveedor</th>
                                <th>Estado</th>
                                <th>Costo Estimado</th>
                                <th>Moneda</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ImplementedServices.Items)
                            {
                                <tr>
                                    <td data-label="Código">
                                        <strong>@row.DisplayValues.GetValueOrDefault("codigoServicio")</strong>
                                    </td>
                                    <td data-label="Servicio">
                                        @row.DisplayValues.GetValueOrDefault("nombreServicio")
                                    </td>
                                    <td data-label="Tipo">
                                        @(row.DisplayValues.GetValueOrDefault("tipoServicio") ?? "—")
                                    </td>
                                    <td data-label="Proveedor">
                                        @(row.DisplayValues.GetValueOrDefault("proveedor") ?? "—")
                                    </td>
                                    <td data-label="Estado">
                                        <span class="badge bg-secondary">@(row.DisplayValues.GetValueOrDefault("estadoServicio") ?? "EVALUACION")</span>
                                    </td>
                                    <td data-label="Costo Estimado">
                                        @(row.DisplayValues.GetValueOrDefault("costoTotalEstimado") ?? "—")
                                    </td>
                                    <td data-label="Moneda">
                                        @(row.DisplayValues.GetValueOrDefault("moneda") ?? "USD")
                                    </td>
                                    <td class="table-actions">
                                        <a class="md-button md-button-text" asp-action="CatalogDetails" asp-route-catalogRoute="servicio-tecnologia" asp-route-id="@row.Id">Ver</a>
                                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                        {
                                            <a class="md-button md-button-text" asp-action="CatalogEditForm" asp-route-catalogRoute="servicio-tecnologia" asp-route-id="@row.Id">Editar</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}
@if (Model.Definition.Route == "proceso-adopcion-tsi")
{
    <section class="report-card related-entities-card" aria-labelledby="adoption-process-children-title">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <p class="eyebrow">ENTIDADES HIJAS Y GESTIÓN INTEGRAL</p>
                <h2 id="adoption-process-children-title">Empresas Participantes, Estándares Designados y Servicios TSI</h2>
            </div>
            <div>
                <a class="md-button md-button-filled" asp-controller="AdoptionProcess" asp-action="Details" asp-route-id="@Model.Record.Id">
                    Gestionar en Tablero de Adopción (#@Model.Record.DisplayValues.GetValueOrDefault("codigoProceso")) →
                </a>
            </div>
        </div>

        <div class="report-kpi-grid mb-4">
            <div class="report-kpi">
                <span class="report-kpi-value">@(Model.ProcessCompanies?.TotalCount ?? 0)</span>
                <span class="report-kpi-label">Empresas Convocadas</span>
            </div>
            <div class="report-kpi">
                <span class="report-kpi-value">@(Model.ProcessStandards?.TotalCount ?? 0)</span>
                <span class="report-kpi-label">Estándares Designados</span>
            </div>
            <div class="report-kpi">
                <span class="report-kpi-value">@(Model.ProcessServices?.TotalCount ?? 0)</span>
                <span class="report-kpi-label">Servicios TSI Asociados</span>
            </div>
            <div class="report-kpi">
                <span class="report-kpi-value" style="font-size: 1.15rem; line-height: 1.3;">@(Model.AdoptionDetail?.EstandarPrincipalVigente?.TecnologiaNombre ?? "Pendiente")</span>
                <span class="report-kpi-label">Estándar Principal Vigente</span>
            </div>
        </div>

        <!-- 1. Empresas Participantes en el Proceso de Adopción -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <h3 class="h5 mb-0">Empresas en Proceso de Adopción <span class="result-count">(@(Model.ProcessCompanies?.TotalCount ?? 0))</span></h3>
                <div class="d-flex gap-2">
                    @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogCreate))
                    {
                        <a class="md-button md-button-tonal" asp-action="CatalogCreateForm" asp-route-catalogRoute="proceso-adopcion-empresa" asp-route-returnUrl="@Context.Request.Path" asp-route-initialKey="proceso" asp-route-initialValue="@Model.Record.Id.ToString()">+ Convocar Empresa</a>
                    }
                    <a class="md-button md-button-text" asp-action="Catalog" asp-route-catalogRoute="proceso-adopcion-empresa">Ver Catálogo</a>
                </div>
            </div>
            @if (Model.ProcessCompanies is null || Model.ProcessCompanies.TotalCount == 0)
            {
                <p class="empty-state">No existen empresas subsidiarias registradas para este proceso de adopción.</p>
            }
            else
            {
                <div class="responsive-table" role="region" aria-label="Empresas en proceso de adopción" tabindex="0">
                    <table>
                        <thead>
                            <tr>
                                <th>Empresa Subsidiaria</th>
                                <th>Participación / Aplica</th>
                                <th>Justificación por No Participar</th>
                                <th>Fecha Incorporación</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ProcessCompanies.Items)
                            {
                                var aplicaRaw = row.DisplayValues.GetValueOrDefault("aplica");
                                var aplica = string.Equals(aplicaRaw, "true", StringComparison.OrdinalIgnoreCase) || string.Equals(aplicaRaw, "1", StringComparison.OrdinalIgnoreCase) || string.Equals(aplicaRaw, "Aplica", StringComparison.OrdinalIgnoreCase) || string.Equals(aplicaRaw, "Sí", StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td data-label="Empresa">
                                        <strong>@(row.DisplayValues.GetValueOrDefault("empresa") ?? "Empresa no especificada")</strong>
                                    </td>
                                    <td data-label="Aplica">
                                        @if (aplica)
                                        {
                                            <span class="badge bg-success">Aplica</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No participa</span>
                                        }
                                    </td>
                                    <td data-label="Justificación">
                                        @(row.DisplayValues.GetValueOrDefault("justificacionNoAplica") ?? "—")
                                    </td>
                                    <td data-label="Fecha Incorporación">
                                        @(row.DisplayValues.GetValueOrDefault("fechaIncorporacion") ?? "—")
                                    </td>
                                    <td class="table-actions">
                                        <a class="md-button md-button-text" asp-action="CatalogDetails" asp-route-catalogRoute="proceso-adopcion-empresa" asp-route-id="@row.Id">Ver</a>
                                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                        {
                                            <a class="md-button md-button-text" asp-action="CatalogEditForm" asp-route-catalogRoute="proceso-adopcion-empresa" asp-route-id="@row.Id" asp-route-returnUrl="@Context.Request.Path">Editar</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- 2. Histórico y Designación de Estándares Tecnológicos -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <h3 class="h5 mb-0">Estándares y Tecnologías Asignadas <span class="result-count">(@(Model.ProcessStandards?.TotalCount ?? 0))</span></h3>
                <div class="d-flex gap-2">
                    @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogCreate))
                    {
                        <a class="md-button md-button-tonal" asp-action="CatalogCreateForm" asp-route-catalogRoute="estandar-tecnologia-historico" asp-route-returnUrl="@Context.Request.Path" asp-route-initialKey="proceso" asp-route-initialValue="@Model.Record.Id.ToString()">+ Asignar Estándar</a>
                    }
                    <a class="md-button md-button-text" asp-action="Catalog" asp-route-catalogRoute="estandar-tecnologia-historico">Ver Catálogo</a>
                </div>
            </div>
            @if (Model.ProcessStandards is null || Model.ProcessStandards.TotalCount == 0)
            {
                <p class="empty-state">No se han registrado asignaciones históricas de estándar para este proceso de adopción.</p>
            }
            else
            {
                <div class="responsive-table" role="region" aria-label="Estándares asignados" tabindex="0">
                    <table>
                        <thead>
                            <tr>
                                <th>Tecnología TSI</th>
                                <th>Rol de Estándar</th>
                                <th>Estado de Vigencia</th>
                                <th>Inicio Vigencia</th>
                                <th>Fin Vigencia</th>
                                <th>Sustento / Motivo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ProcessStandards.Items)
                            {
                                var rol = row.DisplayValues.GetValueOrDefault("rolEstandar") ?? "—";
                                var estado = row.DisplayValues.GetValueOrDefault("estadoVigencia") ?? "—";
                                var isPrincipal = rol.Contains("Principal", StringComparison.OrdinalIgnoreCase);
                                var isVigente = estado.Contains("VIGENTE", StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td data-label="Tecnología">
                                        <strong>@(row.DisplayValues.GetValueOrDefault("tecnologia") ?? "Tecnología no especificada")</strong>
                                    </td>
                                    <td data-label="Rol">
                                        @if (isPrincipal)
                                        {
                                            <span class="badge bg-primary">@rol</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@rol</span>
                                        }
                                    </td>
                                    <td data-label="Estado Vigencia">
                                        @if (isVigente)
                                        {
                                            <span class="badge bg-success">@estado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@estado</span>
                                        }
                                    </td>
                                    <td data-label="Inicio Vigencia">
                                        @(row.DisplayValues.GetValueOrDefault("fechaInicioVigencia") ?? "—")
                                    </td>
                                    <td data-label="Fin Vigencia">
                                        @(row.DisplayValues.GetValueOrDefault("fechaFinVigencia") ?? "—")
                                    </td>
                                    <td data-label="Sustento">
                                        @(row.DisplayValues.GetValueOrDefault("sustentoArquitectura") ?? row.DisplayValues.GetValueOrDefault("motivoCambio") ?? "—")
                                    </td>
                                    <td class="table-actions">
                                        <a class="md-button md-button-text" asp-action="CatalogDetails" asp-route-catalogRoute="estandar-tecnologia-historico" asp-route-id="@row.Id">Ver</a>
                                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                        {
                                            <a class="md-button md-button-text" asp-action="CatalogEditForm" asp-route-catalogRoute="estandar-tecnologia-historico" asp-route-id="@row.Id" asp-route-returnUrl="@Context.Request.Path">Editar</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- 3. Servicios Técnicos TSI Asociados -->
        <div class="mb-2">
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
