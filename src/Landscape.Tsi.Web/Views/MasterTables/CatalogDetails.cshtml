logDetails" asp-route-catalogRoute="@Model.Definition.Route" asp-route-id="@Model.Record.Id" asp-route-capabilityPage="@(Model.Related.Capabilities.Page + 1)">Siguiente</a> }</div> }

        @{
            var capSortAria = string.Equals(Model.FunctionalitySortBy, "capacity", StringComparison.OrdinalIgnoreCase)
