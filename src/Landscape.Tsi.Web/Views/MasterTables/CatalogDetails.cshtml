                <div class="d-flex gap-2">
                    @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogCreate))
                    {
                        <a class="md-button md-button-tonal" asp-action="CatalogCreateForm" asp-route-catalogRoute="servicio-tecnologia" asp-route-returnUrl="@Context.Request.Path" asp-route-initialKey="proceso" asp-route-initialValue="@Model.Record.Id.ToString()">+ Nuevo Servicio</a>
                    }
                    <a class="md-button md-button-text" asp-action="Catalog" asp-route-catalogRoute="servicio-tecnologia">Ver Catálogo</a>
                </div>
            </div>
            @if (Model.ProcessServices is null || Model.ProcessServices.TotalCount == 0)
            {
                <p class="empty-state">No existen servicios de TI vinculados directamente a este proceso de adopción.</p>
            }
            else
            {
                <div class="responsive-table" role="region" aria-label="Servicios relacionados" tabindex="0">
                    <table>
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre del Servicio</th>
                                <th>Tipo de Servicio</th>
                                <th>Tecnología</th>
                                <th>Empresa</th>
                                <th>Proveedor</th>
                                <th>Estado</th>
                                <th>Costo Estimado</th>
                                <th>Moneda</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ProcessServices.Items)
                            {
                                <tr>
                                    <td data-label="Código">
                                        <strong>@row.DisplayValues.GetValueOrDefault("codigoServicio")</strong>
                                    </td>
                                    <td data-label="Servicio">
                                        @row.DisplayValues.GetValueOrDefault("nombreServicio")
                                    </td>
                                    <td data-label="Tipo">
                                        @(row.DisplayValues.GetValueOrDefault("tipoServicio") ?? "—")
                                    </td>
                                    <td data-label="Tecnología">
                                        @(row.DisplayValues.GetValueOrDefault("tecnologia") ?? "—")
                                    </td>
                                    <td data-label="Empresa">
                                        @(row.DisplayValues.GetValueOrDefault("empresa") ?? "—")
                                    </td>
                                    <td data-label="Proveedor">
                                        @(row.DisplayValues.GetValueOrDefault("proveedor") ?? "—")
                                    </td>
                                    <td data-label="Estado">
                                        <span class="badge bg-secondary">@(row.DisplayValues.GetValueOrDefault("estadoServicio") ?? "EVALUACION")</span>
                                    </td>
                                    <td data-label="Costo Estimado">
                                        @(row.DisplayValues.GetValueOrDefault("costoTotalEstimado") ?? "—")
                                    </td>
                                    <td data-label="Moneda">
                                        @(row.DisplayValues.GetValueOrDefault("moneda") ?? "USD")
                                    </td>
                                    <td class="table-actions">
                                        <a class="md-button md-button-text" asp-action="CatalogDetails" asp-route-catalogRoute="servicio-tecnologia" asp-route-id="@row.Id">Ver</a>
                                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                        {
                                            <a class="md-button md-button-text" asp-action="CatalogEditForm" asp-route-catalogRoute="servicio-tecnologia" asp-route-id="@row.Id" asp-route-returnUrl="@Context.Request.Path">Editar</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}
@if (Model.Related is not null)
