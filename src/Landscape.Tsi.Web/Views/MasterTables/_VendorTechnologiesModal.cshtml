<div class="modal fade" id="vendor-technologies-modal" tabindex="-1" aria-labelledby="vendor-technologies-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content md-modal">
            <div class="modal-header">
                <div>
                    <p class="eyebrow">TECNOLOGÍAS DEL FABRICANTE</p>
                    <h2 class="modal-title" id="vendor-technologies-title">Tecnologías TSI del Fabricante</h2>
                    <p class="supporting-text small mb-0">Fabricante: <span id="vendor-modal-vendor-name" class="fw-semibold">—</span></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <div id="vendor-modal-notification" class="px-3 pt-3" hidden></div>

                <!-- Nav tabs -->
                <ul class="nav nav-tabs px-3 pt-2 bg-light border-bottom" id="vendorTechTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-vtech-list-btn" data-bs-toggle="tab" data-bs-target="#tab-vtech-list" type="button" role="tab" aria-selected="true">
                            📋 Tecnologías Asociadas <span class="badge bg-secondary ms-1" id="vendor-modal-badge-count">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-vtech-associate-btn" data-bs-toggle="tab" data-bs-target="#tab-vtech-associate" type="button" role="tab" aria-selected="false">
                            🔍 Asociar Tecnología Existente
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-vtech-create-btn" data-bs-toggle="tab" data-bs-target="#tab-vtech-create" type="button" role="tab" aria-selected="false">
                            ➕ Registrar Nueva Tecnología
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3" id="vendorTechTabsContent">
                    <!-- TAB 1: LISTADO DE ASOCIADAS -->
                    <div class="tab-pane fade show active" id="tab-vtech-list" role="tabpanel" aria-labelledby="tab-vtech-list-btn">
                        <div id="vendor-modal-loading" class="text-center py-4" hidden>
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando tecnologías...</span>
                            </div>
                            <p class="text-muted mt-2 mb-0">Consultando tecnologías TSI del fabricante...</p>
                        </div>

                        <div id="vendor-modal-error" class="app-alert app-alert-error mb-3" hidden>
                            <span>No fue posible cargar las tecnologías del fabricante. Intente nuevamente.</span>
                        </div>

                        <div id="vendor-modal-content">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <span class="small text-muted" id="vendor-modal-summary-text">Listado de tecnologías actualmente vinculadas a este fabricante.</span>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-primary" id="btn-switch-to-associate">
                                        🔍 Asociar Existente
                                    </button>
                                    <button type="button" class="btn btn-outline-success" id="btn-switch-to-create">
                                        ➕ Nueva Tecnología
                                    </button>
                                </div>
                            </div>
                            <div class="responsive-table" tabindex="0">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">ID</th>
                                            <th scope="col">Tecnología TSI (Corporativo)</th>
                                            <th scope="col">Nombre alternativo / Local</th>
                                            <th scope="col">Familia</th>
                                            <th scope="col">Estado de Adopción</th>
                                            <th scope="col">Licenciamiento</th>
                                            <th scope="col">Entorno</th>
                                            <th scope="col" class="text-end pe-3" style="width: 170px;">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody id="vendor-modal-tbody">
                                    </tbody>
                                </table>
                            </div>
                            <p class="empty-state text-center py-4 my-2" id="vendor-modal-empty" hidden>
                                No existen tecnologías TSI asociadas a este fabricante en el sistema.
                            </p>
                        </div>
                    </div>

                    <!-- TAB 2: ASOCIAR EXISTENTE -->
                    <div class="tab-pane fade" id="tab-vtech-associate" role="tabpanel" aria-labelledby="tab-vtech-associate-btn">
                        <div class="mb-3">
                            <label for="inputVendorTechSearch" class="form-label small fw-semibold text-secondary mb-1">
                                Buscar en el catálogo general de Tecnologías TSI no vinculadas a este fabricante:
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">🔍</span>
                                <input type="text" id="inputVendorTechSearch" class="form-control" placeholder="Filtrar por nombre corporativo, local o familia..." autocomplete="off" />
                                <button type="button" class="btn btn-outline-secondary" id="btnResetVendorTechSearch">Limpiar</button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-muted" id="vendorTechAvailableCount">Cargando catálogo disponible...</span>
                            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold" id="linkToCreateTech">
                                + ¿No existe la tecnología? Registrar nueva
                            </button>
                        </div>

                        <div id="vendor-available-loading" class="text-center py-4" hidden>
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="text-muted ms-2">Buscando tecnologías...</span>
                        </div>

                        <div class="table-responsive border rounded" style="max-height: 380px; overflow-y: auto;">
                            <table class="table table-hover table-sm align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>ID</th>
                                        <th>Tecnología TSI</th>
                                        <th>Nombre Local</th>
                                        <th>Familia</th>
                                        <th>Estado Adopción</th>
                                        <th class="text-end pe-3" style="width: 140px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyVendorAvailableResults">
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- TAB 3: REGISTRAR NUEVA TECNOLOGÍA -->
                    <div class="tab-pane fade" id="tab-vtech-create" role="tabpanel" aria-labelledby="tab-vtech-create-btn">
                        <form id="formQuickCreateVendorTech" autocomplete="off" class="p-1">
                            <div class="alert alert-info small mb-3">
                                💡 Complete los datos para registrar una nueva tecnología en el catálogo maestro (<code>TTecnologiaTSI</code>). Se asociará automáticamente a este fabricante.
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="qvTechNombreCorp" class="form-label small fw-bold">Nombre Corporativo <span class="text-danger">*</span></label>
                                    <input type="text" id="qvTechNombreCorp" name="NombreCorporativo" class="form-control" required placeholder="Ej. Palo Alto Strata Network Security" />
                                </div>
                                <div class="col-md-6">
                                    <label for="qvTechNombreLocal" class="form-label small fw-semibold">Nombre Local / Alternativo</label>
                                    <input type="text" id="qvTechNombreLocal" name="NombreLocal" class="form-control" placeholder="Ej. Next-Generation Firewall (NGFW)" />
                                </div>
                                <div class="col-md-6">
                                    <label for="qvTechFamilia" class="form-label small fw-semibold">Familia Tecnológica</label>
                                    <select id="qvTechFamilia" name="IdFamilia" class="form-select">
                                        <option value="">Sin seleccionar</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="qvTechVersionDesplegada" class="form-label small fw-semibold">Versión Desplegada</label>
                                    <select id="qvTechVersionDesplegada" name="IdVersionDesplegada" class="form-select">
                                        <option value="">Sin seleccionar</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="qvTechGrupo" class="form-label small fw-semibold">Grupo al que pertenece</label>
                                    <input type="text" id="qvTechGrupo" name="Grupo" class="form-control" placeholder="Ej. Network Security" />
                                </div>
                                <div class="col-md-4">
                                    <label for="qvTechEstadoAdopcion" class="form-label small fw-semibold">Estado de Adopción TSI</label>
                                    <select id="qvTechEstadoAdopcion" name="IdEstadoAdopcion" class="form-select">
                                        <option value="">Sin seleccionar</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="qvTechPosturaRoadmap" class="form-label small fw-semibold">Postura Roadmap</label>
                                    <select id="qvTechPosturaRoadmap" name="IdPosturaRoadmap" class="form-select">
                                        <option value="">Sin seleccionar</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="qvTechLicenciamiento" class="form-label small fw-semibold">Modelo de Licenciamiento</label>
                                    <input type="text" id="qvTechLicenciamiento" name="Licenciamiento" class="form-control" placeholder="Ej. Suscripción Anual / PAYG" />
                                </div>
                                <div class="col-md-6">
                                    <label for="qvTechEntorno" class="form-label small fw-semibold">Entorno de Implementación</label>
                                    <input type="text" id="qvTechEntorno" name="Entorno" class="form-control" placeholder="Ej. Cloud / On-Premises" />
                                </div>
                            </div>
                            <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                                <button type="button" class="btn btn-outline-secondary" id="btnCancelQuickCreateTech">Cancelar</button>
                                <button type="submit" class="btn btn-primary" id="btnSubmitQuickCreateTech">
                                    💾 Guardar y Asociar a Fabricante
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="md-button md-button-text" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
