@using Landscape.Tsi.Application.Identity
@model Landscape.Tsi.Web.Models.DomainColorsConfigViewModel
@{
    ViewData["Title"] = "Configuración de Colores de Dominios";
}

<nav aria-label="Ruta de navegación">
    <ol class="breadcrumb-list">
        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li><a asp-controller="MasterTables" asp-action="Index">Administración</a></li>
        <li><a asp-controller="MasterTables" asp-action="Index">Tablas Maestras</a></li>
        <li aria-current="page">Configuración de Colores de Dominios</li>
    </ol>
</nav>

<div class="container-fluid px-0 py-2">
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <span class="fs-5">✓</span>
            <div>@Model.SuccessMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <span class="fs-5">⚠</span>
            <div>@Model.ErrorMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary px-2 py-1 fw-semibold" style="letter-spacing:0.5px;">ADMINISTRACIÓN & IDENTIDAD VISUAL</span>
                <span class="badge bg-secondary-subtle text-secondary border">Paleta Cromática WCAG AA</span>
            </div>
            <h1 class="h2 mb-1 fw-bold text-dark">Configuración de Colores de Dominios</h1>
            <p class="text-muted mb-0" style="font-size:0.95rem;">
                Administre y personalice los colores pastel armonizados asignados a cada <strong>Dominio de Seguridad TSI</strong>.
                Esta configuración se refleja automáticamente en el <strong>Mapa Landscape TSI</strong>, la <strong>Distribución de Dominios</strong> y la reportería analítica.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="MasterTables" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                ← Volver a Tablas Maestras
            </a>
            @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
            {
                <form asp-action="ResetAllDomainColors" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de restablecer todos los dominios a su paleta cromática por defecto?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        ↺ Restablecer Todos por Defecto
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Guía de Accesibilidad y Paleta Recomendada -->
    <div class="card shadow-sm border-0 mb-4 bg-light" style="border-radius:12px;">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">ℹ️ Guía Institucional</span>
                <h2 class="h6 mb-0 fw-bold text-dark">Criterios de Accesibilidad y Armonía Visual</h2>
            </div>
            <p class="small text-muted mb-2">
                Para mantener la consistencia visual y cumplir con los estándares de accesibilidad WCAG AA, se recomienda utilizar tonos de fondo pastel suaves, bordes ligeramente más oscuros (20% de contraste) y texto con contraste legible (mínimo 4.5:1).
            </p>
            <div class="d-flex flex-wrap align-items-center gap-2 pt-1">
                <span class="small fw-semibold text-secondary">Tonos pastel sugeridos:</span>
                <span class="badge rounded-pill px-2 py-1 border" style="background:#D1E7DD; color:#0F5132; cursor:pointer;" onclick="applySampleColor('#D1E7DD','#A3CFBB','#0F5132')" title="Verde Suave">Data (#D1E7DD)</span>
                <span class="badge rounded-pill px-2 py-1 border" style="background:#FFF3CD; color:#664D03; cursor:pointer;" onclick="applySampleColor('#FFF3CD','#FFE69C','#664D03')" title="Amarillo Cálido">AppSec (#FFF3CD)</span>
                <span class="badge rounded-pill px-2 py-1 border" style="background:#E2D9F3; color:#432874; cursor:pointer;" onclick="applySampleColor('#E2D9F3','#C5B3E6','#432874')" title="Lila Pastel">IAM (#E2D9F3)</span>
                <span class="badge rounded-pill px-2 py-1 border" style="background:#CFF4FC; color:#055160; cursor:pointer;" onclick="applySampleColor('#CFF4FC','#9EEAF9','#055160')" title="Cian Claro">Cloud (#CFF4FC)</span>
                <span class="badge rounded-pill px-2 py-1 border" style="background:#F8D7DA; color:#842029; cursor:pointer;" onclick="applySampleColor('#F8D7DA','#F1AEB5','#842029')" title="Rojo Pastel">Network (#F8D7DA)</span>
                <span class="badge rounded-pill px-2 py-1 border" style="background:#E0E7FF; color:#1E1B4B; cursor:pointer;" onclick="applySampleColor('#E0E7FF','#C7D2FE','#1E1B4B')" title="Índigo Suave">SecOps (#E0E7FF)</span>
                <span class="badge rounded-pill px-2 py-1 border" style="background:#FEF3C7; color:#78350F; cursor:pointer;" onclick="applySampleColor('#FEF3C7','#FDE68A','#78350F')" title="Ámbar Claro">Endpoint (#FEF3C7)</span>
                <span class="badge rounded-pill px-2 py-1 border" style="background:#E0F2FE; color:#0369A1; cursor:pointer;" onclick="applySampleColor('#E0F2FE','#BAE6FD','#0369A1')" title="Azul Cielo">Mail (#E0F2FE)</span>
                <span class="badge rounded-pill px-2 py-1 border" style="background:#FCE7F3; color:#831843; cursor:pointer;" onclick="applySampleColor('#FCE7F3','#FBCFE8','#831843')" title="Rosa Suave">Risk (#FCE7F3)</span>
            </div>
        </div>
    </div>

    <!-- Tabla de Configuración de Dominios -->
    <div class="card shadow-sm border-0 mb-5" style="border-radius:12px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="table-domain-colors" style="font-size:0.9rem;">
                    <thead class="table-light text-muted text-uppercase" style="font-size:0.75rem;">
                        <tr>
                            <th scope="col" style="width:50px;">#</th>
                            <th scope="col" style="min-width:180px;">Dominio de Seguridad</th>
                            <th scope="col" style="width:110px;" class="text-center">Building Blocks</th>
                            <th scope="col" style="min-width:170px;">Color Fondo (Pastel)</th>
                            <th scope="col" style="min-width:160px;">Color Borde</th>
                            <th scope="col" style="min-width:160px;">Color Texto</th>
                            <th scope="col" style="min-width:210px;">Vista Previa</th>
                            <th scope="col" style="width:170px;" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rowIdx = 1; }
                        @foreach (var item in Model.Domains)
                        {
                            var domId = item.DomainId;
                            <tr id="row-domain-@domId">
                                <td class="text-muted fw-bold">@(rowIdx++)</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.DomainName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width:240px;" title="@item.Description">@item.Description</div>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 rounded-pill">
                                        @item.BuildingBlocksCount BBs
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="color" class="form-control form-control-color border" id="picker-bg-@domId" value="@item.PastelHex" style="width:40px; height:34px; cursor:pointer;" onchange="syncColor(@domId, 'bg', this.value)" />
                                        <input type="text" class="form-control form-control-sm font-monospace" id="text-bg-@domId" value="@item.PastelHex" maxlength="7" style="width:90px;" onchange="syncColor(@domId, 'bg-text', this.value)" />
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="color" class="form-control form-control-color border" id="picker-border-@domId" value="@item.BorderHex" style="width:40px; height:34px; cursor:pointer;" onchange="syncColor(@domId, 'border', this.value)" />
                                        <input type="text" class="form-control form-control-sm font-monospace" id="text-border-@domId" value="@item.BorderHex" maxlength="7" style="width:90px;" onchange="syncColor(@domId, 'border-text', this.value)" />
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="color" class="form-control form-control-color border" id="picker-text-@domId" value="@item.TextHex" style="width:40px; height:34px; cursor:pointer;" onchange="syncColor(@domId, 'text', this.value)" />
                                        <input type="text" class="form-control form-control-sm font-monospace" id="text-text-@domId" value="@item.TextHex" maxlength="7" style="width:90px;" onchange="syncColor(@domId, 'text-text', this.value)" />
                                    </div>
                                </td>
                                <td>
                                    <div class="p-2 rounded border shadow-xs d-flex align-items-center justify-content-between" id="preview-box-@domId" style="background-color:@item.PastelHex; border-color:@item.BorderHex !important;">
                                        <span class="fw-bold small" id="preview-text-@domId" style="color:@item.TextHex;">@item.DomainName</span>
                                        <span class="badge rounded-pill" id="preview-badge-@domId" style="background-color:@item.TextHex; color:#ffffff; font-size:0.7rem;">@item.BuildingBlocksCount BBs</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                    {
                                        <div class="d-flex justify-content-end gap-1">
                                            <form asp-action="SaveDomainColor" method="post" id="form-save-@domId" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="domainId" value="@domId" />
                                                <input type="hidden" name="pastelHex" id="form-bg-@domId" value="@item.PastelHex" />
                                                <input type="hidden" name="borderHex" id="form-border-@domId" value="@item.BorderHex" />
                                                <input type="hidden" name="textHex" id="form-text-@domId" value="@item.TextHex" />
                                                <button type="submit" class="btn btn-primary btn-sm fw-semibold" title="Guardar cambios para este dominio">
                                                    💾 Guardar
                                                </button>
                                            </form>
                                            @if (item.IsCustomized)
                                            {
                                                <form asp-action="ResetDomainColor" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="domainId" value="@domId" />
                                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Restablecer color institucional por defecto">
                                                        ↺
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let lastSelectedDomainId = null;

        function syncColor(domId, type, val) {
            lastSelectedDomainId = domId;
            if (!val.startsWith('#')) val = '#' + val;
            val = val.toUpperCase();

            const pBg = document.getElementById('picker-bg-' + domId);
            const tBg = document.getElementById('text-bg-' + domId);
            const fBg = document.getElementById('form-bg-' + domId);

            const pBorder = document.getElementById('picker-border-' + domId);
            const tBorder = document.getElementById('text-border-' + domId);
            const fBorder = document.getElementById('form-border-' + domId);

            const pText = document.getElementById('picker-text-' + domId);
            const tText = document.getElementById('text-text-' + domId);
            const fText = document.getElementById('form-text-' + domId);

            const box = document.getElementById('preview-box-' + domId);
            const text = document.getElementById('preview-text-' + domId);
            const badge = document.getElementById('preview-badge-' + domId);

            if (type === 'bg' || type === 'bg-text') {
                if (pBg) pBg.value = val;
                if (tBg) tBg.value = val;
                if (fBg) fBg.value = val;
                if (box) box.style.backgroundColor = val;

                // Auto generar sugerencia de borde y texto armonizados si se cambió el fondo
                if (type === 'bg') {
                    const darkerBorder = darkenColor(val, 0.20);
                    const darkerText = darkenColor(val, 0.60);

                    if (pBorder) pBorder.value = darkerBorder;
                    if (tBorder) tBorder.value = darkerBorder;
                    if (fBorder) fBorder.value = darkerBorder;
                    if (box) box.style.borderColor = darkerBorder;

                    if (pText) pText.value = darkerText;
                    if (tText) tText.value = darkerText;
                    if (fText) fText.value = darkerText;
                    if (text) text.style.color = darkerText;
                    if (badge) badge.style.backgroundColor = darkerText;
                }
            } else if (type === 'border' || type === 'border-text') {
                if (pBorder) pBorder.value = val;
                if (tBorder) tBorder.value = val;
                if (fBorder) fBorder.value = val;
                if (box) box.style.borderColor = val;
            } else if (type === 'text' || type === 'text-text') {
                if (pText) pText.value = val;
                if (tText) tText.value = val;
                if (fText) fText.value = val;
                if (text) text.style.color = val;
                if (badge) badge.style.backgroundColor = val;
            }
        }

        function applySampleColor(bg, border, text) {
            if (!lastSelectedDomainId) {
                // Seleccionar primer dominio
                const firstRow = document.querySelector('[id^="row-domain-"]');
                if (firstRow) {
                    lastSelectedDomainId = firstRow.id.replace('row-domain-', '');
                }
            }
            if (lastSelectedDomainId) {
                syncColor(lastSelectedDomainId, 'bg-text', bg);
                syncColor(lastSelectedDomainId, 'border-text', border);
                syncColor(lastSelectedDomainId, 'text-text', text);
            }
        }

        function darkenColor(hex, factor) {
            hex = hex.replace('#', '');
            if (hex.length !== 6) return '#1E293B';
            let r = parseInt(hex.substring(0, 2), 16);
            let g = parseInt(hex.substring(2, 4), 16);
            let b = parseInt(hex.substring(4, 6), 16);

            r = Math.max(0, Math.floor(r * (1 - factor)));
            g = Math.max(0, Math.floor(g * (1 - factor)));
            b = Math.max(0, Math.floor(b * (1 - factor)));

            return '#' + r.toString(16).padStart(2, '0').toUpperCase() +
                         g.toString(16).padStart(2, '0').toUpperCase() +
                         b.toString(16).padStart(2, '0').toUpperCase();
        }
    </script>
}
