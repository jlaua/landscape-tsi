@model Landscape.Tsi.Web.Models.CatalogDetailViewModel

<div class="modal fade" id="create-capability-modal" tabindex="-1" aria-labelledby="create-capability-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content md-modal">
            <form method="post" asp-action="CreateCapabilityForBuildingBlock" asp-route-buildingBlockId="@Model.Record.Id" data-loading-form>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div>
                        <p class="eyebrow">NUEVA CAPACIDAD DE SEGURIDAD</p>
                        <h2 class="modal-title" id="create-capability-title">Crear Capacidad</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">La nueva Capacidad de Seguridad quedará automáticamente vinculada al Building Block <strong>@Model.Record.DisplayValues.GetValueOrDefault(Model.Definition.DisplayColumnCode)</strong>.</p>
                    
                    <div class="mb-3">
                        <label for="create-cap-nombre" class="form-label">Nombre de la Capacidad <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="create-cap-nombre" name="nombre" required maxlength="200" placeholder="Ej. Detección de Anomalías HTTP" />
                    </div>

                    <div class="mb-3">
                        <label for="create-cap-estado" class="form-label">Estado de Capacidad</label>
                        <select class="form-select" id="create-cap-estado" name="estado">
                            <option value="">-- Seleccione estado (opcional) --</option>
                            @if (Model.Options.TryGetValue("estado", out var estados))
                            {
                                foreach (var opt in estados)
                                {
                                    <option value="@opt.Id">@opt.Label</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="create-cap-descripcion" class="form-label">Descripción</label>
                        <textarea class="form-control" id="create-cap-descripcion" name="descripcion" rows="3" placeholder="Detalle funcional o técnico de la capacidad"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="md-button md-button-text" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="md-button md-button-filled" data-loading-text="Guardando…">Crear Capacidad</button>
                </div>
            </form>
        </div>
    </div>
</div>
