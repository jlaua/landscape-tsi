@model Landscape.Tsi.Web.Models.CatalogDetailViewModel

<div class="modal fade" id="reassign-capability-modal" tabindex="-1" aria-labelledby="reassign-capability-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content md-modal">
            <div class="modal-header">
                <div>
                    <p class="eyebrow">ADMINISTRACIÓN DE RELACIONES</p>
                    <h2 class="modal-title" id="reassign-capability-title">Reasignar Capacidad de Seguridad</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>Está por reasignar la capacidad <strong id="reassign-cap-display-name"></strong> a un nuevo Building Block.</p>

                <div class="mb-3">
                    <label for="reassign-cap-target-bb" class="form-label fw-semibold">Building Block Destino</label>
                    <select class="form-select" id="reassign-cap-target-bb" required>
                        <option value="">-- Seleccione el Building Block de destino --</option>
                    </select>
                </div>

                <div id="reassign-cap-impact-panel" hidden class="card p-3 mb-3 border-warning bg-light">
                    <h3 class="h6 text-warning-emphasis fw-bold mb-2">Resumen de Impacto</h3>
                    <div id="reassign-cap-impact-content"></div>
                </div>

                <form id="reassign-capability-form" method="post" asp-action="ReassignCapability" asp-route-id="@Model.Record.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="capabilityId" id="reassign-modal-cap-id" />
                    <input type="hidden" name="sourceBuildingBlockId" value="@Model.Record.Id" />
                    <input type="hidden" name="targetBuildingBlockId" id="reassign-modal-target-bb-id" />
                    <input type="hidden" name="concurrencyToken" id="reassign-modal-token" />
                    <div class="mb-3">
                        <label for="reassign-cap-justification-input" class="form-label">Justificación del cambio</label>
                        <input type="text" class="form-control" name="justification" id="reassign-cap-justification-input" placeholder="Motivo de la reasignación" maxlength="250" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="md-button md-button-text" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="md-button md-button-filled" id="btn-confirm-reassign-cap" disabled>Confirmar Reasignación</button>
            </div>
        </div>
    </div>
</div>
