                </div>
                <div class="mb-3" id="wrap-justificacion" style="display: none;">
                    <label for="convJustificacion" class="form-label">Justificación No Aplica</label>
                    <textarea id="convJustificacion" name="justificacionNoAplica" class="form-control" rows="2" placeholder="Explique por qué no aplica..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Convocatoria</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: REGISTRAR TECNOLOGÍA IMPLEMENTADA -->
<div class="modal fade" id="modal-register-tech" tabindex="-1" aria-labelledby="modalRegTechTitle" aria-hidden="true">
