                                                                                                                data-bs-toggle="modal"
                                                                                                                data-bs-target="#modal-add-operation-rate" title="Editar tarifa de operación">✎</button>
                                                                                                        <form method="post" asp-action="DeleteOperationRateCard" asp-route-procesoId="@p.Id" asp-route-rateCardId="@op.Id" class="d-inline" onsubmit="return confirm('¿Eliminar esta tarifa de operación?');">
                                                                                                            @Html.AntiForgeryToken()
                                                                                                            <button type="submit" class="btn btn-xs btn-outline-danger py-0 px-1">✕</button>
                                                                                                        </form>
                                                                                                    }
                                                                                                </td>
                                                                                            </tr>
                                                                                        }
                                                                                    </tbody>
                                                                                </table>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted small fst-italic">Sin tarifas operativas configuradas. Haz clic en "+ Tarifa Operación".</span>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }

                                    <!-- CAPACIDADES DEL BUILDING BLOCK POR EMPRESA -->
                                    <div class="mt-4 pt-3 border-top">
                                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                            <div>
                                                <h5 class="h6 mb-0 text-dark fw-bold d-flex align-items-center gap-2">
                                                    <span>🛡️ Cobertura de Capacidades para @emp.EmpresaNombre</span>
                                                    <span class="badge bg-secondary-subtle text-dark border">@p.BuildingBlockNombre</span>
                                                </h5>
                                                <small class="text-muted">Defina el estado de adopción técnica por capacidad: <strong>[A] Activo</strong>, <strong>[F] Futuro</strong> o <strong>[NA] No aplica</strong>.</small>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">A: Activo</span>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">F: Futuro</span>
                                                <span class="badge bg-secondary-subtle text-secondary border">NA: No Aplica</span>
                                            </div>
                                        </div>

                                        @if (emp.Capacidades is null || emp.Capacidades.Count == 0)
                                        {
                                            <p class="text-muted small fst-italic mb-2">No se han registrado capacidades para el Building Block @p.BuildingBlockNombre.</p>
                                        }
                                        else
                                        {
                                            <div class="table-responsive bg-white rounded border">
                                                <table class="table table-sm table-hover align-middle mb-0" style="font-size:0.85rem;">
                                                    <thead class="table-light text-muted" style="font-size:0.75rem;">
                                                        <tr>
                                                            <th style="width: 40px;" class="text-center">#</th>
                                                            <th style="min-width: 200px;">Capacidad del Building Block</th>
                                                            <th style="width: 220px;" class="text-center">Estado de Cobertura</th>
                                                            <th>Observación / Plan de Adopción</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    @for (int ci = 0; ci < emp.Capacidades.Count; ci++)
                                                    {
                                                        var cap = emp.Capacidades[ci];
                                                        <tr data-empresa-id="@emp.EmpresaId" data-capacidad-id="@cap.CapacidadId" data-proceso-id="@p.Id">
                                                            <td class="text-center text-muted small">@(ci + 1)</td>
                                                            <td class="fw-semibold text-dark">@cap.CapacidadNombre</td>
                                                            <td class="text-center">
                                                                <div class="btn-group btn-group-sm w-100 capability-state-toggle" role="group">
                                                                    <input type="radio" class="btn-check cap-radio-btn" name="cap_state_@(emp.EmpresaId)_@(cap.CapacidadId)" id="cap_a_@(emp.EmpresaId)_@(cap.CapacidadId)" value="A" @(cap.EstadoCodigo == "A" ? "checked" : "") data-proceso-id="@p.Id" data-empresa-id="@emp.EmpresaId" data-capacidad-id="@cap.CapacidadId" />
                                                                    <label class="btn btn-outline-success py-0 px-2 fw-semibold" for="cap_a_@(emp.EmpresaId)_@(cap.CapacidadId)" title="Activo en producción">A</label>

                                                                    <input type="radio" class="btn-check cap-radio-btn" name="cap_state_@(emp.EmpresaId)_@(cap.CapacidadId)" id="cap_f_@(emp.EmpresaId)_@(cap.CapacidadId)" value="F" @(cap.EstadoCodigo == "F" ? "checked" : "") data-proceso-id="@p.Id" data-empresa-id="@emp.EmpresaId" data-capacidad-id="@cap.CapacidadId" />
                                                                    <label class="btn btn-outline-primary py-0 px-2 fw-semibold" for="cap_f_@(emp.EmpresaId)_@(cap.CapacidadId)" title="Funcionalidad futura planificada">F</label>

                                                                    <input type="radio" class="btn-check cap-radio-btn" name="cap_state_@(emp.EmpresaId)_@(cap.CapacidadId)" id="cap_na_@(emp.EmpresaId)_@(cap.CapacidadId)" value="NA" @(cap.EstadoCodigo != "A" && cap.EstadoCodigo != "F" ? "checked" : "") data-proceso-id="@p.Id" data-empresa-id="@emp.EmpresaId" data-capacidad-id="@cap.CapacidadId" />
                                                                    <label class="btn btn-outline-secondary py-0 px-2 fw-semibold" for="cap_na_@(emp.EmpresaId)_@(cap.CapacidadId)" title="No aplica para esta subsidiaria">NA</label>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <input type="text" class="form-control form-control-sm cap-comment-input" 
                                                                       placeholder="Observación técnica opcional..." 
                                                                       value="@(cap.Comentario ?? "")"
                                                                       data-original-val="@(cap.Comentario ?? "")"
                                                                       data-proceso-id="@p.Id" data-empresa-id="@emp.EmpresaId" data-capacidad-id="@cap.CapacidadId" />
                                                            </td>
                                                        </tr>
                                                    }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }

                                        <!-- Comentario general de la subsidiaria y Guardado Consolidado -->
                                        <div class="mt-2 p-2 bg-light rounded border">
                                            <div class="row g-2 align-items-center">
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-bold mb-0 text-dark">Comentario General Subsidiaria:</label>
                                                </div>
                                                <div class="col-md-6">
                                                    <input type="text" class="form-control form-control-sm company-caps-general-comment" 
                                                           placeholder="Comentario general de capacidades para el reporte consolidado..." 
                                                           value="@(emp.ComentarioCapacidades ?? "")"
                                                           data-original-val="@(emp.ComentarioCapacidades ?? "")"
                                                           data-proceso-id="@p.Id" data-empresa-id="@emp.EmpresaId" />
                                                </div>
                                                <div class="col-md-3 text-end">
                                                    <button class="btn btn-primary btn-sm btn-save-all-company-caps w-100 fw-semibold d-inline-flex align-items-center justify-content-center gap-1 shadow-sm"
                                                            type="button" data-proceso-id="@p.Id" data-empresa-id="@emp.EmpresaId" title="Guardar todos los cambios de cobertura y observaciones para @emp.EmpresaNombre">
                                                        <span>💾 Guardar Cobertura</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- SECCIÓN 3: SERVICIOS Y TARIFARIOS DE TI (DRIVER DE MANO DE OBRA) -->
    <div class="card mb-4 shadow-sm" id="seccion-servicios">
        <div class="card-header bg-light d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h2 class="h5 mb-0">3. Servicios y Tarifarios de Mano de Obra (Implementación, Migración, Operación)</h2>
                <span class="small text-muted">Gestión de tarifarios de servicios corporativos y por subsidiaria basados en rangos de horas y matrices operativas N1-N3</span>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#modal-view-activities">
                    📋 Catálogo Actividades N1-N3
                </button>
                @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                {
                    <button type="button" class="btn btn-sm btn-primary" id="btn-open-general-service" data-bs-toggle="modal" data-bs-target="#modal-create-service">
                        + Registrar Servicio
                    </button>
                }
            </div>
        </div>
        <div class="card-body">
            <!-- Resumen de Costos y Servicios -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded border text-center">
                        <span class="text-muted small d-block">Total Servicios</span>
                        <strong class="fs-4 text-primary">@Model.Services.Count</strong>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded border text-center">
                        <span class="text-muted small d-block">Implementación</span>
                        <strong class="fs-4 text-primary">@Model.Services.Count(s => s.TipoServicioCodigo == "IMPLEMENTACION")</strong>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded border text-center">
                        <span class="text-muted small d-block">Migración</span>
                        <strong class="fs-4 text-warning">@Model.Services.Count(s => s.TipoServicioCodigo == "MIGRACION")</strong>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded border text-center">
                        <span class="text-muted small d-block">Operación</span>
                        <strong class="fs-4 text-success">@Model.Services.Count(s => s.TipoServicioCodigo == "OPERACION")</strong>
                    </div>
                </div>
            </div>
            <div class="alert alert-secondary py-2 px-3 mb-4 d-flex justify-content-between align-items-center">
                <span>Costo Total Estimado de Servicios de Mano de Obra (TSI):</span>
                <strong class="fs-5 text-dark">USD @Model.Services.Sum(s => s.CostoTotalEstimado).ToString("N2")</strong>
            </div>

            @if (Model.Services.Count == 0)
            {
                <div class="alert alert-info py-3 mb-0">
                    <p class="mb-0">No se han registrado servicios de mano de obra para este proceso de adopción ni para sus subsidiarias participantes. Haga clic en <strong>+ Registrar Servicio</strong> para añadir servicios de Implementación, Migración u Operación.</p>
                </div>
            }
            else
            {
                <div class="accordion" id="accordionServicios">
                    @foreach (var srv in Model.Services)
                    {
                        var tipoBadge = srv.TipoServicioCodigo switch
                        {
                            "IMPLEMENTACION" => "bg-primary",
                            "MIGRACION" => "bg-warning text-dark",
                            "OPERACION" => "bg-success",
                            _ => "bg-secondary"
                        };

                        var estadoBadge = srv.Estado switch
                        {
                            "ADJUDICADO" => "bg-success",
                            "ACTIVO" => "bg-primary",
                            "COTIZADO" => "bg-info text-dark",
                            "EVALUACION" => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };

                        <div class="accordion-item mb-3 border rounded shadow-sm">
                            <h3 class="accordion-header" id="heading-srv-@srv.Id">
                                <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-srv-@srv.Id" aria-expanded="false" aria-controls="collapse-srv-@srv.Id">
                                    <div class="d-flex w-100 flex-wrap justify-content-between align-items-center pe-3 gap-2">
                                        <div>
                                            <span class="badge @tipoBadge me-2">@srv.TipoServicioNombre</span>
                                            <strong>@srv.Nombre</strong>
                                            <span class="text-muted ms-2 small">(@srv.Codigo)</span>
                                            @if (srv.TecnologiaTsiNombre is not null)
                                            {
                                                <span class="badge bg-light text-dark border ms-2">Corp: @srv.TecnologiaTsiNombre</span>
                                            }
                                            @if (srv.EmpresaNombre is not null)
                                            {
                                                <span class="badge bg-light text-dark border ms-2">Subsidiaria: @srv.EmpresaNombre</span>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @estadoBadge">@srv.Estado</span>
                                            <strong class="text-dark">@srv.Moneda @srv.CostoTotalEstimado.ToString("N2")</strong>
                                        </div>
                                    </div>
                                </button>
                            </h3>
                            <div id="collapse-srv-@srv.Id" class="accordion-collapse collapse" aria-labelledby="heading-srv-@srv.Id" data-bs-parent="#accordionServicios">
                                <div class="accordion-body">
                                    <div class="row g-2 mb-3 bg-light p-2 rounded">
                                        <div class="col-md-4">
                                            <span class="small text-muted d-block">Proveedor / Vendor:</span>
                                            <strong>@(srv.NombreProveedorServicio ?? srv.VendorNombre ?? "No asignado / Por licitar")</strong>
                                        </div>
                                        <div class="col-md-8">
                                            <span class="small text-muted d-block">Descripción / Alcance:</span>
                                            <span>@(srv.Descripcion ?? "Sin descripción adicional.")</span>
                                        </div>
                                    </div>

                                    @if (srv.TipoServicioCodigo is "IMPLEMENTACION" or "MIGRACION")
                                    {
                                        <!-- Tarifario de Proyecto por Horas (Imágenes 1 y 2) -->
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h4 class="h6 mb-0 fw-bold">Tarifario en función a la cantidad de horas estimadas (@srv.TipoServicioNombre):</h4>
                                            @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                            {
                                                <button type="button" class="btn btn-xs btn-outline-primary btn-add-project-rate" data-service-id="@srv.Id" data-service-name="@srv.Nombre" data-tipo="@srv.TipoServicioCodigo" data-bs-toggle="modal" data-bs-target="#modal-add-project-rate">
                                                    + Agregar Rango / Complejidad
                                                </button>
                                            }
                                        </div>

                                        @if (srv.TarifariosProyecto.Count == 0)
                                        {
                                            <p class="text-muted small mb-0">No se han registrado rangos de horas para este servicio.</p>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-sm table-bordered align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Complejidad</th>
                                                            <th>Rango de Horas</th>
                                                            <th>Tarifa por Hora</th>
                                                            <th>Horas Estimadas</th>
                                                            <th>Subtotal</th>
                                                            <th>Observaciones</th>
                                                            <th style="width: 80px;">Acción</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    @foreach (var rate in srv.TarifariosProyecto)
                                                    {
                                                        var detalleRango = rate.Complejidad switch
                                                        {
                                                            "Baja (Por Hora)" => "Tarifario por Hora bajo demanda",
                                                            "Proyecto menor" => "Entre 1 a 100 horas",
                                                            "Proyecto intermedio" => "Entre 101 a 200 horas",
                                                            "Proyecto mayor" => "Mayor a 201 horas",
                                                            _ => $"De {rate.RangoHorasDesde} a {(rate.RangoHorasHasta.HasValue ? rate.RangoHorasHasta.Value.ToString() : "más")} hrs"
                                                        };

                                                        <tr>
                                                            <td><strong>@rate.Complejidad</strong></td>
                                                            <td><span class="badge bg-light text-dark border">@detalleRango</span></td>
                                                            <td>@rate.Moneda @rate.TarifaHora.ToString("N2")/h</td>
                                                            <td>@rate.HorasEstimadas.ToString("N2") hrs</td>
                                                            <td><strong class="text-success">@rate.Moneda @rate.Subtotal.ToString("N2")</strong></td>
                                                            <td class="small text-muted">@(rate.Observaciones ?? "—")</td>
                                                            <td>
                                                                @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                                                {
                                                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2 btn-edit-project-rate me-1"
                                                                            data-rate-id="@rate.Id"
                                                                            data-service-id="@srv.Id"
                                                                            data-service-name="@srv.Nombre"
                                                                            data-complejidad="@rate.Complejidad"
                                                                            data-desde="@rate.RangoHorasDesde"
                                                                            data-hasta="@(rate.RangoHorasHasta?.ToString() ?? "")"
                                                                            data-tarifa="@rate.TarifaHora.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                            data-horas="@rate.HorasEstimadas.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                            data-obs="@(rate.Observaciones ?? "")"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#modal-add-project-rate" title="Editar rango">✎</button>
                                                                    <form method="post" asp-action="DeleteProjectRateCard" class="d-inline" onsubmit="return confirm('¿Eliminar este rango de horas?');">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="procesoId" value="@p.Id" />
                                                                        <input type="hidden" name="rateCardId" value="@rate.Id" />
                                                                        <button type="submit" class="btn btn-xs btn-outline-danger py-0 px-2" title="Eliminar rango">✕</button>
                                                                    </form>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    }
                                    else if (srv.TipoServicioCodigo == "OPERACION")
                                    {
                                        <!-- Tarifario de Operación (Imágenes 3 y 4) -->
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h4 class="h6 mb-0 fw-bold">Matriz de Tarifario de Operación (N1, N2, N3 - Modalidad, Seniority, Locación):</h4>
                                            @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                            {
                                                <button type="button" class="btn btn-xs btn-outline-success btn-add-operation-rate" data-service-id="@srv.Id" data-service-name="@srv.Nombre" data-bs-toggle="modal" data-bs-target="#modal-add-operation-rate">
                                                    + Agregar Nivel Operativo
                                                </button>
                                            }
                                        </div>

                                        @if (srv.TarifariosOperacion.Count == 0)
                                        {
                                            <p class="text-muted small mb-0">No se han registrado ítems de soporte operativo para este servicio.</p>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-sm table-bordered align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Nivel de Soporte</th>
                                                            <th>Modalidad / Complejidad</th>
                                                            <th>Detalle de Horas</th>
                                                            <th>Expertise</th>
                                                            <th>Locación</th>
                                                            <th>Tarifa Base</th>
                                                            <th>Duración / Cantidad</th>
                                                            <th>Subtotal</th>
                                                            <th style="width: 80px;">Acción</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    @foreach (var op in srv.TarifariosOperacion)
                                                    {
                                                        var nivelBadge = op.NivelSoporte switch
                                                        {
                                                            "N1" => "bg-primary",
                                                            "N2" => "bg-info text-dark",
                                                            "N3" => "bg-dark text-white",
                                                            _ => "bg-secondary"
                                                        };

                                                        <tr>
                                                            <td><span class="badge @nivelBadge">@op.NivelSoporte</span></td>
                                                            <td><strong>@op.Modalidad</strong></td>
                                                            <td class="small text-muted">@(op.DetalleModalidad ?? (op.HorasBaseMensual > 0 ? $"Promedio {op.HorasBaseMensual}h/mes" : "Bajo demanda"))</td>
                                                            <td><span class="badge bg-light text-dark border">@op.Expertise</span></td>
                                                            <td><span class="badge bg-light text-dark border">@op.Locacion</span></td>
                                                            <td>
                                                                @if (op.TarifaHora.HasValue && op.TarifaHora.Value > 0)
                                                                {
                                                                    <span>@op.Moneda @op.TarifaHora.Value.ToString("N2")/h</span>
                                                                }
                                                                else if (op.TarifaMensual.HasValue)
                                                                {
                                                                    <span>@op.Moneda @op.TarifaMensual.Value.ToString("N2")/mes</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (op.Modalidad.StartsWith("Pay-Per-Use", StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    <span>@(op.HorasEstimadas?.ToString("N2") ?? "0") hrs</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>@op.CantidadMeses mes(es)</span>
                                                                }
                                                            </td>
                                                            <td><strong class="text-success">@op.Moneda @op.Subtotal.ToString("N2")</strong></td>
                                                            <td>
                                                                @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                                                {
                                                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2 btn-edit-operation-rate me-1"
                                                                            data-rate-id="@op.Id"
                                                                            data-service-id="@srv.Id"
                                                                            data-service-name="@srv.Nombre"
                                                                            data-nivel="@op.NivelSoporte"
                                                                            data-modalidad="@op.Modalidad"
                                                                            data-horas-base="@op.HorasBaseMensual"
                                                                            data-detalle="@(op.DetalleModalidad ?? "")"
                                                                            data-expertise="@op.Expertise"
                                                                            data-locacion="@op.Locacion"
                                                                            data-tarifa-mes="@(op.TarifaMensual?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                                            data-tarifa-hora="@(op.TarifaHora?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                                            data-meses="@op.CantidadMeses"
                                                                            data-horas="@(op.HorasEstimadas?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#modal-add-operation-rate" title="Editar tarifa de operación">✎</button>
                                                                    <form method="post" asp-action="DeleteOperationRateCard" class="d-inline" onsubmit="return confirm('¿Eliminar este ítem de soporte?');">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="procesoId" value="@p.Id" />
                                                                        <input type="hidden" name="rateCardId" value="@op.Id" />
                                                                        <button type="submit" class="btn btn-xs btn-outline-danger py-0 px-2" title="Eliminar ítem">✕</button>
                                                                    </form>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    }

                                    <div class="mt-3 pt-2 border-top d-flex justify-content-end gap-2">
                                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit-tech-service"
                                                    data-service-id="@srv.Id"
                                                    data-codigo="@srv.Codigo"
                                                    data-nombre="@srv.Nombre"
                                                    data-descripcion="@(srv.Descripcion ?? "")"
                                                    data-tipo-id="@srv.TipoServicioId"
                                                    data-estado="@srv.Estado"
                                                    data-moneda="@srv.Moneda"
                                                    data-proveedor="@(srv.NombreProveedorServicio ?? "")"
                                                    data-tech-id="@(srv.TecnologiaTsiId?.ToString() ?? "")"
                                                    data-impl-id="@(srv.TecnologiaImplementadaId?.ToString() ?? "")"
                                                    data-empresa-id="@(srv.EmpresaId?.ToString() ?? "")"
                                                    data-empresa-nombre="@(srv.EmpresaNombre ?? "")"
                                                    data-tech-nombre="@(srv.TecnologiaTsiNombre ?? "")"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modal-create-service">✏️ Editar Servicio</button>
                                            <form method="post" asp-action="DeleteService" onsubmit="return confirm('¿Está seguro de eliminar este servicio y todas sus líneas de tarifario?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="procesoId" value="@p.Id" />
                                                <input type="hidden" name="servicioId" value="@srv.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Eliminar Servicio</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- MODAL: DEFINIR ESTÁNDAR CORPORATIVO -->
<div class="modal fade" id="modal-set-standard" tabindex="-1" aria-labelledby="modalStandardTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-action="SetStandard" asp-route-id="@p.Id" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="buildingBlockId" value="@p.BuildingBlockId" />
            <div class="modal-header">
                <h5 class="modal-title" id="modalStandardTitle">Definir Estándar Tecnológico Corporativo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info small">
                    Al seleccionar el rol <strong>PRINCIPAL</strong>, el estándar principal activo anterior pasará automáticamente e inmutablemente al histórico con estado <em>HISTORICO_REEMPLAZADO</em>.
                </div>
                <div class="mb-3">
                    <label for="stdTechId" class="form-label">Tecnología TSI *</label>
                    <select id="stdTechId" name="tecnologiaId" class="form-select" required>
                        <option value="">-- Seleccionar Tecnología --</option>
                        @foreach (var t in Model.Technologies)
                        {
                            <option value="@t.Id">@t.Label</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label for="stdRol" class="form-label">Rol del Estándar *</label>
                        <select id="stdRol" name="rolEstandar" class="form-select" required>
                            <option value="PRINCIPAL">PRINCIPAL (Estándar Corporativo)</option>
                            <option value="ALTERNATIVA">ALTERNATIVA (Homologada)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="stdFechaInicio" class="form-label">Fecha Inicio Vigencia *</label>
                        <input id="stdFechaInicio" name="fechaInicio" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label for="stdMotivo" class="form-label">Motivo del Cambio (para histórico)</label>
                    <input id="stdMotivo" name="motivoCambio" class="form-control" placeholder="Ej: Renovación de arquitectura, obsolescencia del estándar previo" />
                </div>
                <div class="mb-3">
                    <label for="stdSustento" class="form-label">Sustento de Arquitectura</label>
                    <textarea id="stdSustento" name="sustentoArquitectura" class="form-control" rows="3" placeholder="Detalle técnico y arquitectónico que respalda la decisión corporativa..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Estándar</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: ADJUDICAR ESTÁNDAR CORPORATIVO Y FINALIZAR EVALUACIÓN -->
<div class="modal fade" id="modal-finalize-evaluation" tabindex="-1" aria-labelledby="modalFinalizeTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <form method="post" asp-action="FinalizeEvaluation" asp-route-id="@p.Id" class="modal-content border-0 shadow">
            @Html.AntiForgeryToken()
            <input type="hidden" name="buildingBlockId" value="@p.BuildingBlockId" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title h6 mb-0" id="modalFinalizeTitle">
                    🏆 Adjudicar Estándar Tecnológico Corporativo y Finalizar Evaluación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            
            <div class="modal-body">
                <div class="alert alert-success d-flex align-items-center gap-2 py-2 small mb-3">
                    <span class="fs-5">📋</span>
                    <div>
                        <strong>Cierre Oficial del Proceso de Evaluación:</strong>
                        Al adjudicar el estándar, este se registrará como <strong>PRINCIPAL VIGENTE</strong> en el histórico corporativo (<code>TEstandarTecnologiaHistorico</code>) y el estado del proceso pasará a finalizado. Toda la evidencia y volumetría <em>As-Is</em> levantada en este proceso permanecerá intacta para auditoría histórica.
                    </div>
                </div>

                <!-- 1. DATOS DEL ESTÁNDAR GANADOR -->
                <div class="card mb-3 border-success-subtle">
                    <div class="card-header bg-success-subtle text-success-emphasis fw-bold py-2">
                        1. Tecnología Adjudicada como Estándar Corporativo
                    </div>
                    <div class="card-body py-2">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label for="finTechId" class="form-label small fw-semibold">Tecnología TSI Ganadora *</label>
                                <select id="finTechId" name="tecnologiaId" class="form-select form-select-sm" required>
                                    <option value="">-- Seleccionar Tecnología Evaluada --</option>
                                    @foreach (var t in Model.Technologies)
                                    {
                                        <option value="@t.Id">@t.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="finRol" class="form-label small fw-semibold">Rol del Estándar *</label>
                                <select id="finRol" name="rolEstandar" class="form-select form-select-sm" required>
                                    <option value="PRINCIPAL" selected>PRINCIPAL (Corporativo)</option>
                                    <option value="ALTERNATIVA">ALTERNATIVA (Homologada)</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="finFechaInicio" class="form-label small fw-semibold">Fecha Inicio Vigencia *</label>
                                <input id="finFechaInicio" name="fechaInicioVigencia" type="date" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-12">
                                <label for="finMotivo" class="form-label small fw-semibold">Motivo / Título de la Adjudicación</label>
                                <input id="finMotivo" name="motivoAdjudicacion" class="form-control form-control-sm" value="Adjudicación de estándar resultante del proceso @p.Codigo - @p.Nombre" />
                            </div>
                            <div class="col-12">
                                <label for="finSustento" class="form-label small fw-semibold">Sustento Arquitectónico y de Negocio</label>
                                <textarea id="finSustento" name="sustentoArquitectura" class="form-control form-control-sm" rows="2" placeholder="Resuma las razones técnicas, operativas y de costo que sustentaron la adjudicación de esta tecnología como estándar corporativo..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. CONTRATO CORPORATIVO MAESTRO (OPCIONAL) -->
                <div class="card mb-3 border">
                    <div class="card-header bg-light fw-bold py-2 d-flex justify-content-between align-items-center">
                        <span>2. Contrato Corporativo Maestro Adjudicado (Opcional)</span>
                        <span class="badge bg-secondary-subtle text-secondary small">Pool / Contrato Central</span>
                    </div>
                    <div class="card-body py-2">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label for="finContractNum" class="form-label small fw-semibold">N° Contrato Corporativo</label>
                                <input id="finContractNum" name="numeroContratoCorporativo" class="form-control form-control-sm" placeholder="Ej: CORP-WAAP-2026-001" />
                            </div>
                            <div class="col-md-3">
                                <label for="finContractMonto" class="form-label small fw-semibold">Monto Total Adjudicado</label>
                                <input id="finContractMonto" name="montoContratoCorporativo" type="number" step="0.01" class="form-control form-control-sm" placeholder="0.00" />
                            </div>
                            <div class="col-md-2">
                                <label for="finContractMoneda" class="form-label small fw-semibold">Moneda</label>
                                <select id="finContractMoneda" name="monedaContratoCorporativo" class="form-select form-select-sm">
                                    <option value="USD">USD</option>
                                    <option value="PEN">PEN</option>
                                    <option value="EUR">EUR</option>
                                </select>
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <div class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" id="finEsPayg" name="esPaygContratoCorporativo" value="true">
                                    <label class="form-check-label small fw-semibold text-primary" for="finEsPayg">⚡ Es modalidad PAYG</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label for="finContractInicio" class="form-label small fw-semibold">Fecha Inicio Contrato</label>
                                <input id="finContractInicio" name="fechaInicioContratoCorporativo" type="date" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-4">
                                <label for="finContractFin" class="form-label small fw-semibold">Fecha Fin Contrato</label>
                                <input id="finContractFin" name="fechaFinContratoCorporativo" type="date" class="form-control form-control-sm" value="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-4">
                                <label for="finContractAdj" class="form-label small fw-semibold">Fecha Adjudicación</label>
                                <input id="finContractAdj" name="fechaAdjudicacionContratoCorporativo" type="date" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. DRIVERS Y TARIFAS CORPORATIVAS NEGOCIADAS -->
                <div class="card mb-3 border">
                    <div class="card-header bg-light fw-bold py-2 d-flex justify-content-between align-items-center">
                        <span>3. Tarifario / Drivers Negociados para el Estándar</span>
                        <button type="button" class="btn btn-sm btn-outline-primary py-0" id="btnAddCorporateDriverRow">+ Agregar Driver</button>
                    </div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">
                            Defina las tarifas unitarias y volumetrías pactadas a nivel corporativo (ej. Tarifa por millón de requests, Apps/FQDN protegidos):
                        </p>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-1" id="tblCorporateDrivers">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Descripción del Driver *</th>
                                        <th style="width: 130px;">Unidad de Medida</th>
                                        <th style="width: 100px;">Cantidad</th>
                                        <th style="width: 110px;">Precio Unit.</th>
                                        <th style="width: 80px;">Moneda</th>
                                        <th style="width: 40px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <input type="text" name="driverDescripcion" class="form-control form-control-sm" placeholder="Ej: Millones Request WAF/Bot" value="Volumetría Global Consolidada" />
                                        </td>
                                        <td>
                                            <input type="text" name="driverUnidadMedida" class="form-control form-control-sm" placeholder="Ej: Millones/Mes" value="Millones/Mes" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" name="driverCantidad" class="form-control form-control-sm" placeholder="0" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" name="driverPrecioUnitario" class="form-control form-control-sm" placeholder="0.00" />
                                        </td>
                                        <td>
                                            <select name="driverMoneda" class="form-select form-select-sm">
                                                <option value="USD">USD</option>
                                                <option value="PEN">PEN</option>
                                            </select>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger p-0 px-1 btn-remove-driver-row">✕</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 4. SUBSIDIARIAS QUE SE ALINEAN DE INMEDIATO -->
                <div class="card mb-2 border">
                    <div class="card-header bg-light fw-bold py-2 d-flex justify-content-between align-items-center">
                        <span>4. Empresas Subsidiarias Alineadas de Inmediato</span>
                        <span class="badge bg-primary small">Instancia Corporativa</span>
                    </div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">
                            Marque las empresas que entrarán de inmediato al nuevo contrato/estándar corporativo (quedarán como <code>Instancia Corporativa</code> y <code>ALINEADO</code>). Las no marcadas conservarán su estado actual hasta que expire su contrato local:
                        </p>
                        <div class="row g-2" style="max-height: 180px; overflow-y: auto;">
                            @foreach (var emp in p.EmpresasParticipantes.Where(ep => ep.Aplica))
                            {
                                <div class="col-md-6">
                                    <div class="form-check p-2 border rounded bg-white">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" name="subsidiariasAlineadasIds" value="@emp.EmpresaId" id="align-emp-@emp.EmpresaId" checked />
                                        <label class="form-check-label small fw-semibold" for="align-emp-@emp.EmpresaId">
                                            @emp.EmpresaNombre
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
            
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-success fw-bold text-white">
                    🏆 Adjudicar Estándar y Finalizar Evaluación
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: CONVOCAR SUBSIDIARIAS (SELECCIÓN MÚLTIPLE CON CHECKBOXES) -->
<div class="modal fade" id="modal-convene-company" tabindex="-1" aria-labelledby="modalConveneTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <form method="post" asp-action="ConveneCompany" asp-route-id="@p.Id" class="modal-content border-0 shadow">
            @Html.AntiForgeryToken()
            <input type="hidden" name="isBatchSync" value="true" />
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title h6 mb-0" id="modalConveneTitle">🏢 Convocar Empresas Subsidiarias</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">
                    Selecciona una o varias subsidiarias con los checkboxes para convocarlas en lote a esta evaluación:
                </p>

                <!-- Barra de búsqueda y selector masivo -->
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                    <input type="text" id="conveneSearchBox" class="form-control form-control-sm" placeholder="🔍 Buscar empresa..." />
                    <button type="button" id="btnToggleAllConvene" class="btn btn-sm btn-outline-secondary text-nowrap">
                        Seleccionar Todas
                    </button>
                </div>

                <!-- Lista con Checkboxes scrolleable -->
                <div class="border rounded p-2 mb-3 bg-light" style="max-height: 240px; overflow-y: auto;" id="conveneCompanyListContainer">
                    @{
                        var yaConvocadasIds = p.EmpresasParticipantes.Select(ep => ep.EmpresaId).ToHashSet();
                    }
                    @foreach (var c in Model.Companies)
                    {
                        var isAlreadyConvocada = yaConvocadasIds.Contains(c.Id);
                        <div class="form-check py-1 border-bottom border-light-subtle convene-company-item" data-company-name="@c.Label.ToLowerInvariant()">
                            <input class="form-check-input convene-company-chk" type="checkbox" name="empresaIds" value="@c.Id" id="chk-emp-@c.Id" @(isAlreadyConvocada ? "checked" : "") />
                            <label class="form-check-label small d-flex justify-content-between align-items-center cursor-pointer w-100" for="chk-emp-@c.Id">
                                <span class="fw-semibold @(isAlreadyConvocada ? "text-primary" : "text-dark")">@c.Label</span>
                                @if (isAlreadyConvocada)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary" style="font-size:0.65rem;">Convocada</span>
                                }
                            </label>
                        </div>
                    }
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="convAplica" name="aplica" value="true" checked />
                    <label class="form-check-label small fw-semibold" for="convAplica">¿Aplica adopción de este Building Block para las seleccionadas?</label>
                </div>

                <div class="mb-2" id="wrap-justificacion" style="display: none;">
                    <label for="convJustificacion" class="form-label small fw-semibold">Justificación No Aplica</label>
                    <textarea id="convJustificacion" name="justificacionNoAplica" class="form-control form-control-sm" rows="2" placeholder="Explique por qué no aplica..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-sm btn-primary fw-bold" id="btnSubmitConvene">
                    💾 Guardar Convocatoria
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: REGISTRAR TECNOLOGÍA IMPLEMENTADA -->
<div class="modal fade" id="modal-register-tech" tabindex="-1" aria-labelledby="modalRegTechTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="RegisterTechnology" asp-route-id="@p.Id" class="modal-content" id="formRegisterTech">
            @Html.AntiForgeryToken()
            <input type="hidden" id="regEmpresaId" name="empresaId" value="" />
            <input type="hidden" id="regProcesoEmpId" name="procesoEmpresaId" value="" />
            <input type="hidden" name="buildingBlockId" value="@p.BuildingBlockId" />
            <div class="modal-header">
                <h5 class="modal-title" id="modalRegTechTitle">Registrar Tecnología Implementada</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <!-- Alerta de éxito o confirmación temporal -->
                <div id="techSelectionSuccessAlert" class="alert alert-success py-2 px-3 small d-none mb-3" role="alert"></div>

                <!-- Selector y Búsqueda de Tecnología TSI -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="regTechId" class="form-label mb-0 fw-semibold">Tecnología TSI *</label>
                        <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none p-0 fw-semibold" id="btnToggleQuickTech">
                            <i class="bi bi-plus-circle"></i> + Nueva Tecnología TSI
                        </button>
                    </div>

                    <!-- Buscador en tiempo real de tecnologías -->
                    <div class="input-group input-group-sm mb-2">
                        <span class="input-group-text bg-white border-end-0">🔍</span>
                        <input type="text" id="techSearchFilter" class="form-control border-start-0" 
                               placeholder="Buscar tecnología en la lista..." autocomplete="off" />
                        <button type="button" id="btnClearTechSearch" class="btn btn-outline-secondary btn-sm" title="Limpiar búsqueda" style="display: none;">✕</button>
                    </div>

                    <!-- Select de Tecnologías -->
                    <select id="regTechId" name="tecnologiaId" class="form-select" required>
                        <option value="">-- Seleccionar Tecnología --</option>
                        @foreach (var t in Model.Technologies)
                        {
                            <option value="@t.Id" data-name="@t.Label.ToLowerInvariant()">@t.Label</option>
                        }
                    </select>
                    <div id="techSearchCountNotice" class="form-text small text-muted mt-1" style="display: none;"></div>

                    <!-- Aviso contextual si no hay resultados en la búsqueda -->
                    <div id="techNoMatchBox" class="alert alert-warning py-2 px-3 small mt-2 mb-0" style="display: none;">
                        <span>No se encontró la tecnología en la lista.</span>
                        <button type="button" class="btn btn-sm btn-primary ms-2 py-0 px-2" id="btnCreateFromSearch">
                            + Registrarla ahora
                        </button>
                    </div>
                </div>

                <!-- PANEL COLAPSABLE: REGISTRO RÁPIDO DE NUEVA TECNOLOGÍA TSI -->
                <div id="panelQuickCreateTech" class="border rounded-3 p-3 mb-3 bg-light shadow-sm" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-primary small">
                            <i class="bi bi-cpu"></i> Nueva Tecnología TSI en el Catálogo
                        </span>
                        <button type="button" class="btn-close btn-sm" id="btnCloseQuickTech" aria-label="Cerrar panel"></button>
                    </div>
                    <p class="small text-muted mb-2">
                        Si la tecnología no existe en el catálogo corporativo, regístrela aquí para seleccionarla inmediatamente:
                    </p>
                    
                    <div id="quickTechAlert" class="alert alert-danger py-1 px-2 small mb-2 d-none"></div>

                    <div class="mb-2">
                        <label for="quickTechNombreCorp" class="form-label small fw-semibold mb-1">Nombre Corporativo *</label>
                        <input type="text" id="quickTechNombreCorp" class="form-control form-control-sm" placeholder="Ej: AWS WAF, Akamai Kona, F5 BIG-IP" />
                    </div>
                    <div class="mb-2">
                        <label for="quickTechNombreLocal" class="form-label small fw-semibold mb-1">Nombre Local / Alternativo (Opcional)</label>
                        <input type="text" id="quickTechNombreLocal" class="form-control form-control-sm" placeholder="Ej: WAF AWS Corporativo" />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCancelQuickTech">Cancelar</button>
                        <button type="button" class="btn btn-sm btn-success fw-semibold" id="btnSubmitQuickTech">
                            <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerQuickTech" role="status"></span>
                            💾 Guardar y Seleccionar
                        </button>
                    </div>
                </div>

                <div class="mb-3">
