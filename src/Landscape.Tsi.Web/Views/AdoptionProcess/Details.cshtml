<!-- MODAL: REGISTRAR SERVICIO TECNOLÓGICO -->
<div class="modal fade" id="modal-create-service" tabindex="-1" aria-labelledby="modalCreateServiceTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-action="SaveService" class="modal-content" onsubmit="document.getElementById('srvEmpresa').disabled = false;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="procesoId" value="@p.Id" />
            <input type="hidden" id="srvId" name="servicioId" value="" />
            <input type="hidden" id="srvTechImplId" name="tecnologiaImplementadaId" value="" />
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalCreateServiceTitle">Registrar Servicio de TI (Mano de Obra)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="srvSubsidiaryNotice" class="alert alert-primary py-2 small mb-3 d-none">
                    <i class="bi bi-building me-1"></i> Registrando servicio para la empresa subsidiaria <strong id="srvSubsidiaryNoticeEmpresa"></strong> vinculado a la tecnología implementada <strong id="srvSubsidiaryNoticeTech"></strong>.
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label for="srvCodigo" class="form-label fw-semibold">Código de Servicio <span class="text-danger">*</span></label>
                        <input id="srvCodigo" name="codigoServicio" class="form-control" value="SRV-@DateTime.UtcNow.ToString("yyyyMMdd")-@Random.Shared.Next(100, 999)" required />
                    </div>
                    <div class="col-md-8">
                        <label for="srvNombre" class="form-label fw-semibold">Nombre del Servicio <span class="text-danger">*</span></label>
                        <input id="srvNombre" name="nombreServicio" class="form-control" placeholder="Ej: Servicio de Migración de Reglas WAF / Operación SOC 24x7" required />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="srvTipo" class="form-label fw-semibold">Tipo de Servicio <span class="text-danger">*</span></label>
                        <select id="srvTipo" name="tipoServicioId" class="form-select" required>
                            <option value="">-- Seleccionar Tipo --</option>
                            @foreach (var t in Model.ServiceTypes)
                            {
                                <option value="@t.Id">@t.Nombre (@t.Codigo)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="srvEstado" class="form-label fw-semibold">Estado del Servicio</label>
                        <select id="srvEstado" name="estadoServicio" class="form-select">
                            <option value="EVALUACION">EVALUACION (En dimensionamiento)</option>
                            <option value="COTIZADO">COTIZADO (Propuesta recibida)</option>
                            <option value="ADJUDICADO">ADJUDICADO (Seleccionado)</option>
                            <option value="ACTIVO">ACTIVO (En ejecución)</option>
                        </select>
                    </div>
                </div>

                <div class="card p-3 mb-3 bg-light border">
                    <h6 class="fw-bold mb-2">Ámbito y Vinculación del Servicio:</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="srvTechCorp" class="form-label small fw-semibold">Tecnología Corporativa (Opcional - Estándar/Evaluada)</label>
                            <select id="srvTechCorp" name="tecnologiaTsiId" class="form-select form-select-sm">
                                <option value="">-- No vincular a estándar corporativo --</option>
                                @foreach (var tech in Model.Technologies)
                                {
                                    <option value="@tech.Id" selected="@(p.EstandarPrincipalVigente?.TecnologiaId == tech.Id ? "selected" : null)">@tech.Label</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="srvEmpresa" class="form-label small fw-semibold">Empresa Subsidiaria Titular (Opcional)</label>
                            <select id="srvEmpresa" name="empresaId" class="form-select form-select-sm">
                                <option value="">-- Alcance Corporativo General --</option>
                                @foreach (var emp in p.EmpresasParticipantes)
                                {
                                    <option value="@emp.EmpresaId">@emp.EmpresaNombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-text small text-muted mt-1">
                        El servicio puede ser corporativo (evaluado/adjudicado para todas las subsidiarias) o específico para una subsidiaria participante.
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label for="srvProveedor" class="form-label fw-semibold">Proveedor / Partner Adjudicado</label>
                        <input id="srvProveedor" name="nombreProveedorServicio" class="form-control" placeholder="Ej: Cloudflare Partner S.A., Logicalis, CyberTech" />
                    </div>
                    <div class="col-md-4">
                        <label for="srvMoneda" class="form-label fw-semibold">Moneda</label>
                        <select id="srvMoneda" name="moneda" class="form-select">
                            <option value="USD">USD (Dólares)</option>
                            <option value="PEN">PEN (Soles)</option>
                            <option value="BOB">BOB (Bolivianos)</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="srvDesc" class="form-label fw-semibold">Descripción / Alcance del Servicio</label>
                    <textarea id="srvDesc" name="descripcion" class="form-control" rows="2" placeholder="Detalle de los entregables, SLAs y alcance de mano de obra..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary fw-bold">💾 Guardar Servicio</button>
            </div>
        </form>
    </div>
</div>

