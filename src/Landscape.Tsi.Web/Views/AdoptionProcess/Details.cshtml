            <input type="hidden" id="regEmpresaId" name="empresaId" value="" />
            <input type="hidden" id="regProcesoEmpId" name="procesoEmpresaId" value="" />
            <input type="hidden" name="buildingBlockId" value="@p.BuildingBlockId" />
            <div class="modal-header">
                <h5 class="modal-title" id="modalRegTechTitle">Registrar Tecnología Implementada</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="regTechId" class="form-label">Tecnología TSI *</label>
                    <select id="regTechId" name="tecnologiaId" class="form-select" required>
                        <option value="">-- Seleccionar Tecnología --</option>
                        @foreach (var t in Model.Technologies)
                        {
                            <option value="@t.Id">@t.Label</option>
                        }
                    </select>
                </div>
