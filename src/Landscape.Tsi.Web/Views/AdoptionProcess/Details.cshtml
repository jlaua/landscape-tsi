                                                                                        data-bs-target="#modal-create-service">Editar</button>
                                                                                if (srv.TipoServicioCodigo is "IMPLEMENTACION" or "MIGRACION")
                                                                                {
                                                                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-1 btn-add-project-rate"
                                                                                            data-service-id="@srv.Id"
