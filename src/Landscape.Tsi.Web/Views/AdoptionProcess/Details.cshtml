                                                                                        <tr>
                                                                                            <th>Complejidad / Rango</th>
                                                                                            <th>Horas</th>
                                                                                            <th>Tarifa/Hora</th>
                                                                                            <th>Horas Est.</th>
                                                                                            <th>Subtotal</th>
