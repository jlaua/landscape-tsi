                                                                            {
                                                                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-1 btn-edit-tech-service me-1"
                                                                                        data-service-id="@srv.Id"
                                                                                        data-codigo="@srv.Codigo"
                                                                                        data-nombre="@srv.Nombre"
                                                                                        data-descripcion="@(srv.Descripcion ?? "")"
                                                                                        data-tipo-id="@srv.TipoServicioId"
                                                                                        data-estado="@srv.Estado"
                                                                                        data-moneda="@srv.Moneda"
                                                                                        data-proveedor="@(srv.NombreProveedorServicio ?? "")"
                                                                                        data-tech-id="@(srv.TecnologiaTsiId?.ToString() ?? "")"
                                                                                        data-impl-id="@tech.Id"
                                                                                        data-empresa-id="@emp.EmpresaId"
                                                                                        data-empresa-nombre="@emp.EmpresaNombre"
                                                                                        data-tech-nombre="@tech.TecnologiaNombre"
                                                                                        data-vendor-nombre="@tech.VendorNombre"
