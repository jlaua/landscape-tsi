                                                                                                            <button type="submit" class="btn btn-xs btn-outline-danger py-0 px-1">✕</button>
                                                                                                        </form>
                                                                                                    }
                                                                                                </td>
                                                                                            </tr>
                                                                                        }
                                                                                    </tbody>
                                                                                </table>
                                                                            </div>
