        if (accordionEmpresas) {
            const procesoId = accordionEmpresas.dataset.procesoId || '';
            const storageKey = `landscape_tsi_eval_${procesoId}_company_order`;

            // 1. Restaurar orden guardado en localStorage si existe
            function restoreSavedOrder() {
                try {
                    const savedOrderJson = localStorage.getItem(storageKey);
                    if (!savedOrderJson) return;
                    const savedIds = JSON.parse(savedOrderJson);
                    if (!Array.isArray(savedIds) || savedIds.length === 0) return;

                    const currentItems = Array.from(accordionEmpresas.querySelectorAll('.company-draggable-item'));
                    const itemsMap = new Map();
                    currentItems.forEach(item => {
                        const id = item.dataset.procesoEmpId;
                        if (id) itemsMap.set(id, item);
                    });

                    let reordered = false;
                    savedIds.forEach(id => {
                        const item = itemsMap.get(id.toString());
                        if (item) {
                            accordionEmpresas.appendChild(item);
                            itemsMap.delete(id.toString());
                            reordered = true;
                        }
                    });

                    // Cualquier elemento nuevo no presente en la lista guardada se añade al final
                    itemsMap.forEach(item => accordionEmpresas.appendChild(item));

                    if (reordered && btnResetOrder) {
                        btnResetOrder.classList.remove('d-none');
                    }
                } catch (e) {
                    console.warn('Error al restaurar orden de empresas:', e);
                }
            }

            restoreSavedOrder();

            // 2. Eventos de Drag and Drop
            let draggedItem = null;

            function initDragAndDrop() {
                const items = accordionEmpresas.querySelectorAll('.company-draggable-item');

                items.forEach(item => {
                    const handle = item.querySelector('.company-drag-handle');
                    if (handle) {
                        handle.addEventListener('mouseenter', () => {
                            item.setAttribute('draggable', 'true');
                        });
                        handle.addEventListener('mouseleave', () => {
                            if (!item.classList.contains('dragging')) {
                                item.setAttribute('draggable', 'false');
                            }
                        });
                    }

                    item.addEventListener('dragstart', (e) => {
                        draggedItem = item;
                        item.classList.add('dragging');
                        e.dataTransfer.effectAllowed = 'move';
                        e.dataTransfer.setData('text/plain', item.dataset.procesoEmpId || '');
                    });

                    item.addEventListener('dragend', () => {
                        item.classList.remove('dragging');
                        item.setAttribute('draggable', 'false');
                        draggedItem = null;

                        items.forEach(it => it.classList.remove('drag-over-top', 'drag-over-bottom'));

                        saveCurrentOrder();
                    });

                    item.addEventListener('dragover', (e) => {
                        e.preventDefault();
                        e.dataTransfer.dropEffect = 'move';
                        if (!draggedItem || draggedItem === item) return;

                        const bounding = item.getBoundingClientRect();
                        const offset = bounding.y + (bounding.height / 2);
                        if (e.clientY - offset > 0) {
                            item.classList.remove('drag-over-top');
                            item.classList.add('drag-over-bottom');
                        } else {
                            item.classList.remove('drag-over-bottom');
                            item.classList.add('drag-over-top');
                        }
                    });

                    item.addEventListener('dragleave', () => {
                        item.classList.remove('drag-over-top', 'drag-over-bottom');
                    });

                    item.addEventListener('drop', (e) => {
                        e.preventDefault();
                        item.classList.remove('drag-over-top', 'drag-over-bottom');
                        if (!draggedItem || draggedItem === item) return;

                        const bounding = item.getBoundingClientRect();
                        const offset = bounding.y + (bounding.height / 2);
                        if (e.clientY - offset > 0) {
                            item.after(draggedItem);
                        } else {
                            item.before(draggedItem);
                        }
                    });
                });
            }

            initDragAndDrop();

