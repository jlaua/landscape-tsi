@model Landscape.Tsi.Web.Models.AdoptionProcessDetailViewModel
@using Landscape.Tsi.Application.Identity
@{
    ViewData["Title"] = $"Proceso de Adopción - {Model.Process.Nombre}";
    var p = Model.Process;
}

<nav aria-label="Ruta de navegación">
    <ol class="breadcrumb-list">
        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li><a asp-action="Index">Procesos de Adopción TSI</a></li>
        <li aria-current="page">@p.Codigo</li>
    </ol>
</nav>

<section class="admin-shell mb-4" aria-labelledby="process-detail-title">
    <div class="page-heading">
        <div>
            <p class="eyebrow">PROCESO DE ADOPCIÓN TSI</p>
            <h1 id="process-detail-title">@p.Nombre</h1>
            <p class="supporting-text">Código: <strong>@p.Codigo</strong> · Building Block: <a asp-controller="MasterTables" asp-action="CatalogDetails" asp-route-catalogRoute="building-block" asp-route-id="@p.BuildingBlockId">@p.BuildingBlockNombre</a></p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <a asp-action="Reports" asp-route-id="@p.Id" class="btn btn-outline-info text-dark btn-sm fw-semibold shadow-sm d-inline-flex align-items-center gap-1" title="Ver los 4 reportes de seguimiento de esta evaluación">
                <span>📊 Reportería & Seguimiento</span>
            </a>
            @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.AdoptionExport))
            {
                <a asp-action="ExportEvaluationExcel" asp-route-id="@p.Id" asp-route-section="all"
                   class="btn btn-outline-success btn-sm fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                   title="Exportar evaluación completa con todas sus secciones a formato Microsoft Excel (.xlsx)">
                    <span>📥 Exportar Evaluación a Excel</span>
                </a>
            }
            @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
            {
                <button type="button" class="badge bg-primary fs-6 border-0 text-white d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#modal-change-status" title="Haga clic para cambiar el estado del proceso">
                    <span>@p.EstadoAdopcionNombre</span>
                    <span class="small opacity-75">✏️</span>
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modal-change-status" title="Cambiar estado del proceso de adopción">
                    🔄 Cambiar Estado
                </button>
                <button type="button" class="btn btn-success btn-sm fw-bold text-white shadow-sm" data-bs-toggle="modal" data-bs-target="#modal-finalize-evaluation" title="Adjudicar estándar corporativo y finalizar evaluación">
                    🏆 Adjudicar Estándar y Finalizar
                </button>
                <a asp-action="EditEvaluation" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm fw-semibold" title="Editar datos y estado de la evaluación">
                    ✏️ Editar Evaluación
                </a>
                <button type="button" class="md-button md-button-filled" data-bs-toggle="modal" data-bs-target="#modal-set-standard">+ Definir Estándar</button>
                <button type="button" class="md-button md-button-tonal" data-bs-toggle="modal" data-bs-target="#modal-convene-company">+ Convocar Subsidiaria</button>
            }
            else
            {
                <span class="badge bg-primary fs-6 px-3 py-2">@p.EstadoAdopcionNombre</span>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="app-alert app-alert-success" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="app-alert app-alert-error" role="alert">@error</div>
    }

    <!-- Ficha de información general del Proceso -->
    <div class="card p-3 mb-4 shadow-sm">
        <dl class="row mb-0">
            <dt class="col-sm-3">Dominio:</dt>
            <dd class="col-sm-3">@(p.DominioNombre ?? "No definido")</dd>
            <dt class="col-sm-3">Familia:</dt>
            <dd class="col-sm-3">@(p.FamiliaNombre ?? "No definida")</dd>

            <dt class="col-sm-3">Líder Corporativo TSI:</dt>
            <dd class="col-sm-3">@(p.LiderCorporativo ?? "No asignado")</dd>
            <dt class="col-sm-3">Vigencia del Proceso:</dt>
            <dd class="col-sm-3">@p.FechaInicio.ToString("dd/MM/yyyy") @(p.FechaEstimadaCierre.HasValue ? $"hasta {p.FechaEstimadaCierre.Value:dd/MM/yyyy}" : "")</dd>

            @if (!string.IsNullOrWhiteSpace(p.Objetivo))
            {
                <dt class="col-sm-3">Objetivo:</dt>
                <dd class="col-sm-9">@p.Objetivo</dd>
            }
            @if (!string.IsNullOrWhiteSpace(p.Alcance))
            {
                <dt class="col-sm-3">Alcance:</dt>
                <dd class="col-sm-9">@p.Alcance</dd>
            }
        </dl>
    </div>

    <!-- SECCIÓN 1: ESTÁNDARES CORPORATIVOS -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">1. Estándar Tecnológico Corporativo</h2>
            @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
            {
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modal-set-standard">+ Definir / Cambiar Estándar</button>
            }
        </div>
        <div class="card-body">
            @if (p.EstandarPrincipalVigente is null)
            {
                <div class="alert alert-warning d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between p-3 mb-3 border-warning">
                    <div>
                        <strong class="d-block text-dark">🎯 Estándar Corporativo en Evaluación (Pendiente de Oficialización)</strong>
                        <span class="small text-muted">
                            Esta solicitud aún no cuenta con un Estándar Tecnológico PRINCIPAL oficializado. Al finalizar la evaluación técnica o validar la PoC, puede adjudicar y oficializar el estándar corporativo resultante.
                        </span>
                    </div>
                    @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                    {
                        <button type="button" class="btn btn-sm btn-success fw-bold text-white mt-2 mt-md-0 ms-md-3 text-nowrap" data-bs-toggle="modal" data-bs-target="#modal-finalize-evaluation">
                            🏆 Adjudicar Estándar y Finalizar
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="border rounded p-3 mb-3 bg-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-success mb-2">ESTÁNDAR PRINCIPAL VIGENTE</span>
                            <h3 class="h4 mb-1 text-primary">@p.EstandarPrincipalVigente.TecnologiaNombre</h3>
                            <p class="text-muted mb-1">
                                Vendor: <strong>@(p.EstandarPrincipalVigente.VendorNombre ?? "Sin vendor")</strong> · 
                                Vigencia desde: <strong>@p.EstandarPrincipalVigente.FechaInicioVigencia.ToString("dd/MM/yyyy")</strong>
                            </p>
                            @if (!string.IsNullOrWhiteSpace(p.EstandarPrincipalVigente.SustentoArquitectura))
                            {
                                <p class="small mb-1"><strong>Sustento de Arquitectura:</strong> @p.EstandarPrincipalVigente.SustentoArquitectura</p>
                            }
                            @if (p.EstandarPrincipalVigente.CasosDeUso.Count > 0)
                            {
                                <div class="mt-2">
                                    <strong class="small text-muted">Casos de Uso Vinculados:</strong>
                                    <ul class="mb-0 small">
                                        @foreach (var cu in p.EstandarPrincipalVigente.CasosDeUso)
                                        {
                                            <li>@cu</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (p.EstandaresAlternativos.Count > 0)
            {
                <h4 class="h6 mt-3 text-secondary">Estándares Alternativos Vigentes</h4>
                <div class="row g-2">
                    @foreach (var alt in p.EstandaresAlternativos)
                    {
                        <div class="col-md-6">
                            <div class="border rounded p-2 bg-light">
                                <span class="badge bg-info text-dark">ALTERNATIVA</span>
                                <strong>@alt.TecnologiaNombre</strong> (desde @alt.FechaInicioVigencia.ToString("dd/MM/yyyy"))
                                @if (!string.IsNullOrWhiteSpace(alt.SustentoArquitectura))
                                {
                                    <p class="small text-muted mb-0">@alt.SustentoArquitectura</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Histórico de Estándares Reemplazados (Inmutable) -->
            @if (p.EstandaresHistoricos.Count > 0)
            {
                <h4 class="h6 mt-4 text-muted">Histórico de Estándares Tecnológicos Reemplazados</h4>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Tecnología</th>
                                <th>Rol Histórico</th>
                                <th>Fecha Inicio</th>
                                <th>Fecha Fin</th>
                                <th>Motivo del Cambio</th>
                                <th>Sustento</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var hist in p.EstandaresHistoricos)
                        {
                            <tr>
                                <td>@hist.TecnologiaNombre</td>
                                <td><span class="badge bg-secondary">@hist.RolEstandar</span></td>
                                <td>@hist.FechaInicioVigencia.ToString("dd/MM/yyyy")</td>
                                <td>@(hist.FechaFinVigencia?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>@(hist.MotivoCambio ?? "Reemplazo de estándar")</td>
                                <td class="small">@(hist.SustentoArquitectura ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- SECCIÓN 2: SUBSIDIARIAS Y REALIDAD DE ADOPCIÓN -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="h5 mb-0">2. Convocatoria a Empresas Subsidiarias y Adopción Real</h2>
                <small class="text-muted">Puede ordenar las empresas arrastrándolas con el ratón mediante el icono <span class="fw-bold">⠿</span>.</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnResetCompanyOrder" title="Restablecer orden predeterminado">
                    <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    <span class="small">Restablecer Orden</span>
                </button>
                <span id="orderSavedFeedback" class="badge bg-success-subtle text-success border border-success-subtle small d-none">✓ Orden guardado</span>
                @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modal-convene-company">+ Convocar Subsidiaria</button>
                }
            </div>
        </div>
        <div class="card-body">
            @if (p.EmpresasParticipantes.Count == 0)
            {
                <p class="text-muted">Aún no se han convocado empresas subsidiarias para este proceso.</p>
            }
            else
            {
                <div class="accordion" id="accordionEmpresas" data-proceso-id="@p.Id">
                    @foreach (var emp in p.EmpresasParticipantes)
                    {
                        var badgeClass = emp.EstadoAlineamiento switch
                        {
                            "ALINEADO" => "bg-success",
                            "HOMOLOGADO" => "bg-info text-dark",
                            "NO_ALINEADO" => "bg-danger",
                            "PENDIENTE" => "bg-warning text-dark",
                            "NO_APLICA" => "bg-secondary",
                            _ => "bg-light text-dark"
                        };

                        <div class="accordion-item mb-2 border rounded company-draggable-item" data-proceso-emp-id="@emp.ProcesoEmpresaId">
                            <div class="d-flex align-items-center justify-content-between p-1 pe-2 bg-light border-bottom rounded-top flex-wrap gap-2">
                                <div class="d-flex align-items-center flex-grow-1 min-w-0">
                                    <span class="company-drag-handle px-2 py-2 text-secondary cursor-grab" title="Arrastrar para reordenar" style="cursor: grab; user-select: none;">
                                        <svg style="width:16px;height:16px;" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>
                                    </span>
                                    <button class="accordion-button company-accordion-btn collapsed py-2 px-2 shadow-none bg-transparent flex-grow-1 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@emp.ProcesoEmpresaId" aria-expanded="false" aria-controls="collapse-@emp.ProcesoEmpresaId">
                                        <span class="fw-bold text-dark text-truncate me-2">@emp.EmpresaNombre</span>
                                        <span class="d-inline-flex align-items-center gap-1 ms-auto flex-shrink-0">
                                            @if (!emp.Aplica)
                                            {
                                                <span class="badge bg-secondary">NO APLICA</span>
                                            }
                                            <span class="badge @badgeClass">@emp.EstadoAlineamiento</span>
                                        </span>
                                    </button>
                                </div>
                                <div class="d-flex align-items-center gap-2 ms-auto">
                                    <span class="badge bg-white text-dark border d-inline-flex align-items-center gap-1 py-1 px-2 small">
                                        <span class="text-muted">Focal:</span>
                                        <span id="focal-display-@emp.EmpresaId" class="fw-medium">@(emp.ContactoFocalNombre ?? "Sin asignar")</span>
                                        <span id="focal-email-@emp.EmpresaId" class="text-muted small">@(emp.ContactoFocalEmail is not null ? $"<{emp.ContactoFocalEmail}>" : "")</span>
                                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                        {
                                            <button type="button" class="btn btn-sm btn-link p-0 ms-1 text-decoration-none btn-assign-focal-modal"
                                                    data-empresa-id="@emp.EmpresaId"
                                                    data-empresa-name="@emp.EmpresaNombre"
                                                    data-current-focal-id="@(emp.ContactoFocalId?.ToString() ?? "")"
                                                    title="Asignar o cambiar especialista focal">
                                                ✏️
                                            </button>
                                        }
                                    </span>
                                    @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                    {
                                        <form method="post" asp-action="RemoveCompany" asp-route-id="@p.Id" class="d-inline mb-0" onsubmit="return confirm('¿Está seguro de que desea eliminar a @emp.EmpresaNombre de este proceso de evaluación?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="procesoEmpresaId" value="@emp.ProcesoEmpresaId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2 d-inline-flex align-items-center gap-1" title="Eliminar empresa del proceso">
                                                <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                <span class="d-none d-sm-inline small">Eliminar</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                            <div id="collapse-@emp.ProcesoEmpresaId" class="accordion-collapse collapse" aria-labelledby="heading-@emp.ProcesoEmpresaId" data-bs-parent="#accordionEmpresas">
                                <div class="accordion-body">
                                    @if (!emp.Aplica)
                                    {
                                        <div class="alert alert-secondary py-2">
                                            <strong>Justificación No Aplica:</strong> @(emp.JustificacionNoAplica ?? "No especificada.")
                                        </div>
                                    }

                                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                        <h4 class="h6 mb-0">Tecnologías Implementadas por @emp.EmpresaNombre</h4>
                                        <div class="d-flex gap-2">
                                            @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit) && emp.Aplica)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success btn-add-tech" data-empresa-id="@emp.EmpresaId" data-proceso-emp-id="@emp.ProcesoEmpresaId" data-bs-toggle="modal" data-bs-target="#modal-register-tech">+ Registrar Tecnología Implementada</button>
                                            }
                                            @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                            {
                                                <form method="post" asp-action="RemoveCompany" asp-route-id="@p.Id" class="d-inline" onsubmit="return confirm('¿Está seguro de que desea eliminar a @emp.EmpresaNombre de este proceso de evaluación?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="procesoEmpresaId" value="@emp.ProcesoEmpresaId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" title="Eliminar empresa del proceso">
                                                        <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                        <span>Eliminar Empresa</span>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>

                                    @if (emp.TecnologiasImplementadas.Count == 0)
                                    {
                                        <p class="text-muted small">No se han registrado tecnologías implementadas para esta empresa aún.</p>
                                    }
                                    else
                                    {
                                        @foreach (var tech in emp.TecnologiasImplementadas)
                                        {
                                            <div class="border rounded p-3 mb-3 bg-white">
                                                <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-2">
                                                    <div>
                                                        <h5 class="h6 mb-0 text-primary">
                                                            @tech.TecnologiaNombre
                                                            @if (tech.EsPrimaria)
                                                            {
                                                                <span class="badge bg-primary ms-1">Primaria</span>
                                                            }
                                                            @if (tech.EsInstanciaCorporativa)
                                                            {
                                                                <span class="badge bg-purple text-white ms-1" style="background-color: #6f42c1;" title="Instancia Centralizada / Tenant Corporativo Credicorp">🏛️ Instancia Corporativa</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary-subtle text-dark border ms-1" title="Instancia Propia / Infraestructura de la Subsidiaria">🏢 Instancia Local</span>
                                                            }
                                                            <span class="badge @(tech.EstadoAlineamiento == "ALINEADO" ? "bg-success" : (tech.EstadoAlineamiento == "HOMOLOGADO" ? "bg-info text-dark" : "bg-danger")) ms-1">@tech.EstadoAlineamiento</span>
                                                        </h5>
                                                        <span class="small text-muted">Versión Desplegada: <strong>@(tech.VersionDesplegada ?? "No especificada")</strong> · Vendor: @(tech.VendorNombre ?? "Sin vendor")</span>
                                                    </div>
                                                    <div>
                                                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                                                        {
                                                            <form method="post" asp-action="DeleteImplementedTechnology" asp-route-id="@p.Id" class="d-inline me-1" onsubmit="return confirm('¿Está seguro de que desea eliminar la tecnología implementada \'@tech.TecnologiaNombre\' de @emp.EmpresaNombre? Esta acción eliminará también sus contratos, drivers y servicios vinculados.');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="tecnologiaImplementadaId" value="@tech.Id" />
                                                                <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" title="Eliminar tecnología implementada">
                                                                    <svg style="width:13px;height:13px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                                    <span>Eliminar tecnología</span>
                                                                </button>
                                                            </form>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-op-model me-1" data-impl-id="@tech.Id" data-tipo-id="@tech.ModeloOperacion?.TipoOperacionId" data-mod-id="@tech.ModeloOperacion?.ModalidadLaboralId" data-bs-toggle="modal" data-bs-target="#modal-operation-model">Modelo Operación</button>
                                                            <button type="button" class="btn btn-sm btn-outline-primary btn-add-contract me-1" data-impl-id="@tech.Id" data-bs-toggle="modal" data-bs-target="#modal-save-contract">+ Contrato</button>
                                                            <button type="button" class="btn btn-sm btn-outline-primary btn-add-driver me-1" data-impl-id="@tech.Id" data-bs-toggle="modal" data-bs-target="#modal-save-driver">+ Driver</button>
                                                            <button type="button" class="btn btn-sm btn-outline-primary btn-add-tech-service" 
                                                                    data-impl-id="@tech.Id" 
                                                                    data-empresa-id="@emp.EmpresaId" 
                                                                    data-empresa-nombre="@emp.EmpresaNombre" 
                                                                    data-tech-id="@tech.TecnologiaId" 
                                                                    data-tech-nombre="@tech.TecnologiaNombre" 
                                                                    data-vendor-nombre="@tech.VendorNombre"
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#modal-create-service">+ Servicios</button>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Modelo de Operación -->
                                                <div class="mb-2 small">
                                                    <strong>Modelo de Operación:</strong>
                                                    @(tech.ModeloOperacion?.TipoOperacionNombre ?? "No configurado") · 
                                                    Modalidad Laboral: @(tech.ModeloOperacion?.ModalidadLaboralNombre ?? "No configurada")
                                                </div>

                                                <!-- Contratos y Adendas (1:N) -->
                                                <div class="mb-3">
                                                    <strong class="small text-muted">Contratos y Adendas Vinculados:</strong>
                                                    @if (tech.Contratos.Count == 0)
                                                    {
                                                        <p class="small text-muted mb-0">Sin contratos registrados.</p>
                                                    }
                                                    else
                                                    {
                                                        <div class="table-responsive mt-1">
                                                            <table class="table table-sm table-bordered mb-1 small">
                                                                <thead class="table-light">
                                                                    <tr>
                                                                        <th>N° Contrato</th>
                                                                        <th>Tipo</th>
                                                                        <th>Vigencia</th>
                                                                        <th>Monto</th>
                                                                        <th>Documento</th>
