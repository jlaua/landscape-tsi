            <input type="hidden" name="procesoId" value="@p.Id" />
            <input type="hidden" id="opRateId" name="rateCardId" value="" />
            <input type="hidden" id="opRateSrvId" name="servicioId" value="" />
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalOpRateTitle">Tarifario de Operación (Soporte N1, N2, N3)</h5>
