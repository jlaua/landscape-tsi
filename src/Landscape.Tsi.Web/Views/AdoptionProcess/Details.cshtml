<!-- MODAL: GUARDAR CONTRATO O ADENDA -->
<div class="modal fade" id="modal-save-contract" tabindex="-1" aria-labelledby="modalContractTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-action="SaveContract" asp-route-id="@p.Id" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" id="contractId" name="contratoId" value="" />
            <input type="hidden" id="contractImplId" name="tecnologiaImplementadaId" value="" />
            <input type="hidden" id="contractIsAdenda" name="esAdenda" value="false" />
            <input type="hidden" id="contractParentId" name="contratoPadreId" value="" />
            <div class="modal-header">
                <h5 class="modal-title" id="modalContractTitle">Registrar Contrato</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="contractParentNotice" class="alert alert-info small" style="display: none;">
                    Adenda al contrato principal: <strong id="contractParentNumText"></strong>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label for="contractNum" class="form-label">Número de Contrato / Adenda *</label>
                        <input id="contractNum" name="numeroContrato" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label for="contractMonto" class="form-label">Monto</label>
                        <input id="contractMonto" name="monto" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label for="contractMoneda" class="form-label">Moneda</label>
                        <select id="contractMoneda" name="moneda" class="form-select">
                            <option value="USD">USD</option>
                            <option value="PEN">PEN</option>
                            <option value="EUR">EUR</option>
                        </select>
                    </div>
                </div>
                <!-- MODALIDAD PAYG / PAGO POR USO -->
                <div class="card bg-light border p-2 mb-3">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="contractEsPayg" name="esPayg" value="true">
                        <label class="form-check-label fw-bold text-primary" for="contractEsPayg">
                            ⚡ Modalidad Pago por Uso / Pay as you Go (PAYG)
                        </label>
                        <div class="text-muted small">
                            Al activar PAYG, el contrato se factura por consumo continuo y las fechas de vigencia y adjudicación no aplican (se bloquean automáticamente).
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-3" id="wrapContractDates">
                    <div class="col-md-4">
                        <label for="contractInicio" class="form-label">Fecha Inicio * <span class="badge bg-secondary-subtle text-secondary small d-none" id="badgePaygInicio">No aplica</span></label>
                        <input id="contractInicio" name="fechaInicio" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-4">
                        <label for="contractFin" class="form-label">Fecha Fin * <span class="badge bg-secondary-subtle text-secondary small d-none" id="badgePaygFin">No aplica</span></label>
                        <input id="contractFin" name="fechaFin" type="date" class="form-control" value="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-4">
                        <label for="contractAdj" class="form-label">Fecha Adjudicación <span class="badge bg-secondary-subtle text-secondary small d-none" id="badgePaygAdj">No aplica</span></label>
                        <input id="contractAdj" name="fechaAdjudicacion" type="date" class="form-control" />
                    </div>
                </div>
                <div id="noticePaygBlocked" class="alert alert-info py-1 px-2 small mb-3" style="display: none;">
                    ℹ️ Modalidad PAYG seleccionada: las fechas de inicio, fin y adjudicación están bloqueadas porque no aplican. En los reportes se reflejará como "PAYG".
                </div>
                <div class="mb-3">
                    <label for="contractDoc" class="form-label">Ruta o Enlace del Documento</label>
                    <input id="contractDoc" name="rutaDocumento" class="form-control" placeholder="https://repositorio.corp/contratos/CT-001.pdf" />
                </div>
                <div class="mb-3">
                    <label for="contractObs" class="form-label">Observaciones</label>
                    <textarea id="contractObs" name="observaciones" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Contrato</button>
            </div>
        </form>
    </div>
</div>

