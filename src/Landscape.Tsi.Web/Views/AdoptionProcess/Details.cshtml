<!-- MODAL: ASIGNAR / CAMBIAR ESPECIALISTA FOCAL & GESTIÓN DE CONTACTOS -->
<div class="modal fade" id="modal-assign-focal" tabindex="-1" aria-labelledby="modalAssignFocalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <p class="text-uppercase text-muted small fw-semibold mb-1">CONTACTOS DE LA EMPRESA / SUBSIDIARIA</p>
                    <h4 class="modal-title fw-bold" id="modalAssignFocalTitle">Especialistas Registrados</h4>
                    <p class="text-muted small mb-0">Empresa Subsidiaria: <span id="focalModalCompanyName" class="fw-semibold text-dark">—</span></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <!-- Alerta dentro del modal -->
                <div id="focalModalAlert" class="alert d-none py-2 px-3 small mb-3" role="alert"></div>

                <!-- Callout informativo -->
                <div class="alert alert-info py-2 px-3 small d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <div>
                        <i class="bi bi-info-circle me-1"></i>
                        Seleccione al especialista que actuará como <strong>punto focal</strong> para este proceso de evaluación, o gestione (registre/edite) los contactos de la subsidiaria.
                    </div>
                    <div id="focalCurrentAssignedBadge"></div>
                </div>

                <!-- Barra de herramientas: Búsqueda en tiempo real, contador y botón de nuevo contacto -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 450px;">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" id="focal-search-addon">🔍</span>
                            <input type="search" id="focalModalSearch" class="form-control border-start-0" placeholder="Buscar por nombre, cargo, email, teléfono..." aria-label="Buscar especialistas" aria-describedby="focal-search-addon" />
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border px-3 py-2 fs-6" id="focalModalBadgeCount">0 contactos</span>
                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                        {
                            <button type="button" class="btn btn-primary btn-sm fw-semibold" id="focalModalToggleFormBtn">
                                + Nuevo Contacto
                            </button>
                        }
                    </div>
                </div>

                <!-- Formulario desplegable para Registro / Edición de Contacto -->
                <div id="focalFormCard" class="card border mb-3 shadow-sm" style="display: none; border-radius: 8px;">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                        <strong id="focalFormTitle">Registrar Nuevo Contacto</strong>
                        <button type="button" class="btn-close" id="focalFormCloseBtn" aria-label="Cerrar formulario"></button>
                    </div>
                    <div class="card-body">
                        <form id="focalContactForm" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="focal-field-id" value="" />
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="focal-field-nombre" class="form-label fw-semibold small">Nombre Completo <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm" id="focal-field-nombre" required placeholder="Ej. Juan Pérez" />
                                </div>
                                <div class="col-md-6">
                                    <label for="focal-field-rol" class="form-label fw-semibold small">Rol / Cargo</label>
                                    <input type="text" class="form-control form-control-sm" id="focal-field-rol" placeholder="Ej. Analista / Especialista" />
                                </div>
                                <div class="col-md-6">
                                    <label for="focal-field-email" class="form-label fw-semibold small">Correo Electrónico</label>
                                    <input type="email" class="form-control form-control-sm" id="focal-field-email" placeholder="ejemplo@empresa.com" />
                                </div>
                                <div class="col-md-6">
                                    <label for="focal-field-telefono" class="form-label fw-semibold small">Teléfono</label>
                                    <input type="tel" class="form-control form-control-sm" id="focal-field-telefono" placeholder="+51 999 888 777" />
                                </div>
                                <div class="col-md-6">
                                    <label for="focal-field-otro" class="form-label fw-semibold small">Otro / Contacto Adicional</label>
                                    <input type="text" class="form-control form-control-sm" id="focal-field-otro" placeholder="Detalle adicional" />
                                </div>
                                <div class="col-md-6">
                                    <label for="focal-field-notas" class="form-label fw-semibold small">Notas / Observaciones</label>
                                    <input type="text" class="form-control form-control-sm" id="focal-field-notas" placeholder="Anotaciones relevantes" />
                                </div>
                            </div>
                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="focalFormCancelBtn">Cancelar</button>
                                <button type="submit" class="btn btn-primary btn-sm fw-semibold" id="focalFormSubmitBtn">Guardar Contacto</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Indicador de carga -->
                <div id="focalModalLoading" class="text-center py-4" hidden>
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando contactos...</span>
                    </div>
                    <p class="text-muted mt-2 mb-0">Consultando especialistas de la empresa...</p>
                </div>

                <!-- Grilla de contactos -->
                <div id="focalModalContent">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 24%;">Nombre Contacto</th>
                                    <th scope="col" style="width: 18%;">Rol / Cargo</th>
                                    <th scope="col" style="width: 20%;">Correo Electrónico</th>
                                    <th scope="col" style="width: 13%;">Teléfono</th>
                                    <th scope="col" style="width: 10%;">Notas</th>
                                    <th scope="col" style="width: 15%; text-align: right;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="focalModalTbody"></tbody>
                        </table>
                    </div>
                    <p class="text-center text-muted py-4 my-2 border rounded bg-light" id="focalModalEmpty" hidden>
                        No existen contactos registrados para esta empresa subsidiaria. Haga clic en <strong>+ Nuevo Contacto</strong> para registrar uno.
                    </p>
                    <p class="text-center text-muted py-4 my-2 border rounded bg-light" id="focalModalNoSearch" hidden>
                        No se encontraron contactos que coincidan con el criterio de búsqueda.
                    </p>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between bg-light py-2">
                <div>
                    @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.CatalogEdit))
                    {
                        <button type="button" id="btnRemoveFocalAssignment" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1" title="Quitar la designación de punto focal para esta empresa en esta evaluación">
                            <span>✕ Quitar Focal (Dejar sin asignar)</span>
                        </button>
                    }
                </div>
                <div>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle justificación No Aplica
        const convAplica = document.getElementById('convAplica');
        const wrapJust = document.getElementById('wrap-justificacion');
        if (convAplica && wrapJust) {
            convAplica.addEventListener('change', function() {
                wrapJust.style.display = this.checked ? 'none' : 'block';
            });
        }

        // Modal Registrar Tecnología: Live Search & Creación Rápida
        const regTechSelect = document.getElementById('regTechId');
        const techSearchFilter = document.getElementById('techSearchFilter');
        const btnClearTechSearch = document.getElementById('btnClearTechSearch');
        const techSearchCountNotice = document.getElementById('techSearchCountNotice');
        const techNoMatchBox = document.getElementById('techNoMatchBox');
        const btnCreateFromSearch = document.getElementById('btnCreateFromSearch');
        const btnToggleQuickTech = document.getElementById('btnToggleQuickTech');
        const panelQuickCreateTech = document.getElementById('panelQuickCreateTech');
        const btnCloseQuickTech = document.getElementById('btnCloseQuickTech');
        const btnCancelQuickTech = document.getElementById('btnCancelQuickTech');
        const btnSubmitQuickTech = document.getElementById('btnSubmitQuickTech');
        const quickTechNombreCorp = document.getElementById('quickTechNombreCorp');
        const quickTechNombreLocal = document.getElementById('quickTechNombreLocal');
        const quickTechAlert = document.getElementById('quickTechAlert');
        const spinnerQuickTech = document.getElementById('spinnerQuickTech');
        const techSelectionSuccessAlert = document.getElementById('techSelectionSuccessAlert');

        let allTechOptions = [];
        if (regTechSelect) {
            for (let i = 0; i < regTechSelect.options.length; i++) {
                const opt = regTechSelect.options[i];
                allTechOptions.push({
                    value: opt.value,
                    text: opt.text,
                    searchKey: (opt.getAttribute('data-name') || opt.text || '').toLowerCase().trim()
                });
            }
        }

        function filterTechOptions() {
            if (!regTechSelect || !techSearchFilter) return;
            const query = techSearchFilter.value.trim().toLowerCase();
            const currentSelected = regTechSelect.value;
            
            if (btnClearTechSearch) {
                btnClearTechSearch.style.display = query.length > 0 ? 'inline-block' : 'none';
            }

            regTechSelect.innerHTML = '';
            let matchCount = 0;

            allTechOptions.forEach(function(opt) {
                if (opt.value === '') {
                    const el = document.createElement('option');
                    el.value = '';
                    el.textContent = opt.text;
                    regTechSelect.appendChild(el);
                } else if (!query || opt.searchKey.includes(query)) {
                    matchCount++;
                    const el = document.createElement('option');
                    el.value = opt.value;
                    el.textContent = opt.text;
                    el.setAttribute('data-name', opt.searchKey);
                    if (opt.value === currentSelected) {
                        el.selected = true;
                    }
                    regTechSelect.appendChild(el);
                }
            });

            if (query.length > 0) {
                if (techSearchCountNotice) {
                    techSearchCountNotice.style.display = 'block';
                    techSearchCountNotice.textContent = `${matchCount} tecnología(s) encontrada(s)`;
                }
                if (techNoMatchBox) {
                    techNoMatchBox.style.display = matchCount === 0 ? 'block' : 'none';
                }
            } else {
                if (techSearchCountNotice) techSearchCountNotice.style.display = 'none';
                if (techNoMatchBox) techNoMatchBox.style.display = 'none';
            }
        }

        if (techSearchFilter) {
            techSearchFilter.addEventListener('input', filterTechOptions);
        }

        if (btnClearTechSearch) {
            btnClearTechSearch.addEventListener('click', function() {
                techSearchFilter.value = '';
                filterTechOptions();
                techSearchFilter.focus();
            });
        }

        if (btnToggleQuickTech && panelQuickCreateTech) {
            btnToggleQuickTech.addEventListener('click', function() {
                const isHidden = panelQuickCreateTech.style.display === 'none';
                panelQuickCreateTech.style.display = isHidden ? 'block' : 'none';
                if (isHidden && quickTechNombreCorp) {
                    if (techSearchFilter && techSearchFilter.value.trim().length > 0) {
                        quickTechNombreCorp.value = techSearchFilter.value.trim();
                    }
                    quickTechNombreCorp.focus();
                }
            });
        }

        if (btnCreateFromSearch && panelQuickCreateTech) {
            btnCreateFromSearch.addEventListener('click', function() {
                panelQuickCreateTech.style.display = 'block';
                if (quickTechNombreCorp && techSearchFilter) {
                    quickTechNombreCorp.value = techSearchFilter.value.trim();
                }
                if (quickTechNombreCorp) quickTechNombreCorp.focus();
            });
        }

        function closeQuickTechPanel() {
            if (panelQuickCreateTech) panelQuickCreateTech.style.display = 'none';
            if (quickTechAlert) {
                quickTechAlert.classList.add('d-none');
                quickTechAlert.textContent = '';
            }
            if (quickTechNombreCorp) quickTechNombreCorp.value = '';
            if (quickTechNombreLocal) quickTechNombreLocal.value = '';
        }

        if (btnCloseQuickTech) btnCloseQuickTech.addEventListener('click', closeQuickTechPanel);
        if (btnCancelQuickTech) btnCancelQuickTech.addEventListener('click', closeQuickTechPanel);

        if (btnSubmitQuickTech) {
            btnSubmitQuickTech.addEventListener('click', async function() {
                const nombreCorp = (quickTechNombreCorp?.value || '').trim();
                const nombreLoc = (quickTechNombreLocal?.value || '').trim();

                if (!nombreCorp) {
                    if (quickTechAlert) {
                        quickTechAlert.textContent = 'El Nombre Corporativo es obligatorio.';
                        quickTechAlert.classList.remove('d-none');
                    }
                    quickTechNombreCorp?.focus();
                    return;
                }

                if (quickTechAlert) quickTechAlert.classList.add('d-none');
                if (spinnerQuickTech) spinnerQuickTech.classList.remove('d-none');
                btnSubmitQuickTech.disabled = true;

                try {
                    const token = document.querySelector('#formRegisterTech input[name="__RequestVerificationToken"]')?.value || '';
                    const formData = new URLSearchParams();
                    formData.append('__RequestVerificationToken', token);
                    formData.append('nombreCorporativo', nombreCorp);
                    if (nombreLoc) formData.append('nombreLocal', nombreLoc);

                    const response = await fetch('@Url.Action("QuickCreateTechnology", "AdoptionProcess")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                        },
                        body: formData.toString()
                    });

                    const data = await response.json();
                    if (data.succeeded) {
                        const newId = String(data.id);
                        const newName = data.nombre || nombreCorp;
                        
                        const alreadyExists = allTechOptions.some(o => o.value === newId);
                        if (!alreadyExists) {
                            allTechOptions.push({
                                value: newId,
                                text: newName,
                                searchKey: newName.toLowerCase().trim()
                            });
                        }

                        if (techSearchFilter) techSearchFilter.value = '';
                        filterTechOptions();

                        if (regTechSelect) {
                            regTechSelect.value = newId;
                        }

                        if (techSelectionSuccessAlert) {
                            techSelectionSuccessAlert.textContent = `✓ Tecnología "${newName}" registrada y seleccionada exitosamente.`;
                            techSelectionSuccessAlert.classList.remove('d-none');
                            setTimeout(() => {
                                techSelectionSuccessAlert.classList.add('d-none');
                            }, 5000);
                        }

                        closeQuickTechPanel();
                    } else {
                        if (quickTechAlert) {
                            quickTechAlert.textContent = data.message || 'No se pudo registrar la tecnología.';
                            quickTechAlert.classList.remove('d-none');
                        }
                    }
                } catch (err) {
                    if (quickTechAlert) {
                        quickTechAlert.textContent = 'Error de comunicación con el servidor al registrar la tecnología.';
                        quickTechAlert.classList.remove('d-none');
                    }
                } finally {
                    if (spinnerQuickTech) spinnerQuickTech.classList.add('d-none');
                    btnSubmitQuickTech.disabled = false;
                }
            });
        }

        document.querySelectorAll('.btn-add-tech').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('regEmpresaId').value = this.dataset.empresaId || '';
                document.getElementById('regProcesoEmpId').value = this.dataset.procesoEmpId || '';
                if (techSearchFilter) techSearchFilter.value = '';
                filterTechOptions();
                closeQuickTechPanel();
                if (techSelectionSuccessAlert) techSelectionSuccessAlert.classList.add('d-none');
            });
        });

        // Modal Guardar Contrato (Principal o Adenda) & Modalidad PAYG
        const contractEsPayg = document.getElementById('contractEsPayg');
        const contractInicio = document.getElementById('contractInicio');
        const contractFin = document.getElementById('contractFin');
        const contractAdj = document.getElementById('contractAdj');
        const badgePaygInicio = document.getElementById('badgePaygInicio');
        const badgePaygFin = document.getElementById('badgePaygFin');
        const badgePaygAdj = document.getElementById('badgePaygAdj');
        const noticePaygBlocked = document.getElementById('noticePaygBlocked');

        function toggleContractPayg() {
            if (!contractEsPayg) return;
            const isPayg = contractEsPayg.checked;
            if (contractInicio) {
                contractInicio.disabled = isPayg;
                contractInicio.required = !isPayg;
                if (isPayg) contractInicio.value = '';
            }
            if (contractFin) {
                contractFin.disabled = isPayg;
                contractFin.required = !isPayg;
                if (isPayg) contractFin.value = '';
            }
            if (contractAdj) {
                contractAdj.disabled = isPayg;
