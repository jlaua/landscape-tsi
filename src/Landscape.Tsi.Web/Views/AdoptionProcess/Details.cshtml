                                                                            <span class="badge @srvTypeBadge me-1">@srv.TipoServicioNombre</span>
                                                                            <strong class="small">@srv.Codigo: @srv.Nombre</strong>
                                                                            <span class="badge bg-secondary-subtle text-dark border ms-1 small">@srv.Estado</span>
                                                                            @if (!string.IsNullOrWhiteSpace(srv.NombreProveedorServicio))
                                                                            {
                                                                                <span class="small text-muted ms-2">· Proveedor: @srv.NombreProveedorServicio</span>
                                                                            }
                                                                        </div>
                                                                        <div class="d-flex align-items-center gap-1">
                                                                            <span class="fw-bold text-success small me-2">@($"{srv.Moneda} {srv.CostoTotalEstimado:N2}")</span>
