    <div class="modal-dialog">
        <form method="post" asp-action="SaveOperationModel" asp-route-id="@p.Id" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" id="opImplId" name="tecnologiaImplementadaId" value="" />
            <div class="modal-header">
                <h5 class="modal-title" id="modalOpModelTitle">Configurar Modelo de Operación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="opTipo" class="form-label">Tipo de Modelo de Operación *</label>
                    <select id="opTipo" name="tipoOperacionId" class="form-select" required>
                        <option value="">-- Seleccionar Tipo --</option>
                        @foreach (var o in Model.OperationTypes)
                        {
                            <option value="@o.Id">@o.Label</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="opModalidad" class="form-label">Modalidad Laboral *</label>
                    <select id="opModalidad" name="modalidadLaboralId" class="form-select" required>
