                    Servicio: <strong id="opRateServiceName"></strong>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label for="opNivel" class="form-label fw-semibold">Tipo / Nivel de Soporte <span class="text-danger">*</span></label>
                        <select id="opNivel" name="nivelSoporte" class="form-select" required>
                            <option value="N1">N1 — Soporte Nivel 1</option>
                            <option value="N2">N2 — Soporte Nivel 2</option>
                            <option value="N3">N3 — Soporte Nivel 3</option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label for="opModalidad" class="form-label fw-semibold">Modalidad / Complejidad <span class="text-danger">*</span></label>
                        <select id="opModalidad" name="modalidad" class="form-select" required>
                            <option value="Pay-Per-Use" data-base="0" data-desc="Tarifario por Hora bajo demanda">Pay-Per-Use (Horas bajo demanda — Tarifario por Hora)</option>
                            <option value="Mensual 8x5" data-base="176" data-desc="Promedio de 176 horas mensuales, no incluye fines de semana">Mensual 8x5 (Promedio 176 hrs mensuales s/fines de semana)</option>
                            <option value="Mensual 24x7" data-base="720" data-desc="Promedio de 720 horas mensuales, incluye fines de semana">Mensual 24x7 (Promedio 720 hrs mensuales continuo)</option>
                        </select>
                        <input type="hidden" id="opHorasBase" name="horasBaseMensual" value="0" />
                        <input type="hidden" id="opDetalleModalidad" name="detalleModalidad" value="Tarifario por Hora" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="opExpertise" class="form-label fw-semibold">Expertise <span class="text-danger">*</span></label>
                        <select id="opExpertise" name="expertise" class="form-select" required>
                            <option value="Junior">Junior</option>
                            <option value="Senior">Senior</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="opLocacion" class="form-label fw-semibold">Locación <span class="text-danger">*</span></label>
                        <select id="opLocacion" name="locacion" class="form-select" required>
                            <option value="Remoto">Remoto</option>
                            <option value="Presencial">Presencial</option>
                        </select>
                    </div>
                </div>

                <!-- Tarifas y Duración -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6" id="wrap-tarifa-mensual">
                        <label for="opTarifaMensual" class="form-label fw-semibold">Tarifa Mensual (USD)</label>
                        <input id="opTarifaMensual" name="tarifaMensual" type="number" step="0.01" class="form-control op-calc" placeholder="Ej: 4500.00" />
                    </div>
                    <div class="col-md-6" id="wrap-cantidad-meses">
                        <label for="opCantidadMeses" class="form-label fw-semibold">Duración (Meses)</label>
                        <input id="opCantidadMeses" name="cantidadMeses" type="number" class="form-control op-calc" value="12" min="1" />
                    </div>
                    <div class="col-md-6" id="wrap-tarifa-hora" style="display: none;">
                        <label for="opTarifaHora" class="form-label fw-semibold">Tarifa por Hora (USD)</label>
                        <input id="opTarifaHora" name="tarifaHora" type="number" step="0.01" class="form-control op-calc" placeholder="Ej: 120.00" />
                    </div>
                    <div class="col-md-6" id="wrap-horas-estimadas" style="display: none;">
                        <label for="opHorasEstimadas" class="form-label fw-semibold">Horas Estimadas Bajo Demanda</label>
                        <input id="opHorasEstimadas" name="horasEstimadas" type="number" step="0.5" class="form-control op-calc" placeholder="Ej: 40" />
                    </div>
                </div>

                <div class="p-3 bg-light rounded border mb-0 text-center">
                    <span class="small text-muted d-block">Subtotal Estimado de Operación:</span>
                    <strong class="fs-4 text-success" id="opSubtotalPreview">$0.00</strong>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-success fw-bold">💾 Guardar Ítem de Operación</button>
            </div>
        </form>
    </div>
</div>

