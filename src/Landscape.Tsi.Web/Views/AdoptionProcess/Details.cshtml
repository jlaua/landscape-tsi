                const currentFocalContact = focalContactsList.find(c => String(c.id) === String(activeCurrentFocalId));
                if (focalCurrentBadgeEl) {
                    if (currentFocalContact) {
                        focalCurrentBadgeEl.innerHTML = `<span class="badge bg-success py-1 px-2">Focal Actual: ${escapeHtml(currentFocalContact.nombre)}</span>`;
                    } else {
                        focalCurrentBadgeEl.innerHTML = `<span class="badge bg-secondary py-1 px-2">Focal Actual: Sin asignar</span>`;
                    }
                }

                items.forEach((c) => {
                    const tr = document.createElement('tr');
                    const isCurrentFocal = (activeCurrentFocalId && String(c.id) === String(activeCurrentFocalId));
                    if (isCurrentFocal) {
                        tr.classList.add('table-success');
                    }

                    // Nombre
                    const tdNombre = document.createElement('td');
                    tdNombre.innerHTML = `<strong>${escapeHtml(c.nombre || '—')}</strong>`;
                    tr.appendChild(tdNombre);

                    // Rol
                    const tdRol = document.createElement('td');
                    tdRol.textContent = c.rol || '—';
                    tr.appendChild(tdRol);

                    // Email
                    const tdEmail = document.createElement('td');
                    if (c.email && c.email !== '—') {
                        const a = document.createElement('a');
                        a.href = `mailto:${encodeURIComponent(c.email)}`;
                        a.textContent = c.email;
                        tdEmail.appendChild(a);
                    } else {
                        tdEmail.textContent = '—';
                    }
                    tr.appendChild(tdEmail);

                    // Telefono
                    const tdTel = document.createElement('td');
                    if (c.telefono && c.telefono !== '—') {
                        const a = document.createElement('a');
                        a.href = `tel:${encodeURIComponent(c.telefono.replace(/\s+/g, ''))}`;
                        a.textContent = c.telefono;
                        tdTel.appendChild(a);
                    } else {
                        tdTel.textContent = '—';
                    }
                    tr.appendChild(tdTel);

                    // Notas
                    const tdNotas = document.createElement('td');
                    const notesArr = [c.notas, c.otro].filter(x => x && x !== '—');
                    tdNotas.className = 'small text-muted';
                    tdNotas.textContent = notesArr.join(' | ') || '—';
                    tr.appendChild(tdNotas);

                    // Acciones
                    const tdActions = document.createElement('td');
                    tdActions.className = 'text-end text-nowrap';

                    if (isCurrentFocal) {
                        const badgeFocal = document.createElement('span');
                        badgeFocal.className = 'badge bg-success-subtle text-success border border-success me-1 py-1 px-2 fw-semibold';
                        badgeFocal.title = 'Especialista focal asignado para este proceso de adopción';
                        badgeFocal.textContent = '★ Focal Asignado';
                        tdActions.appendChild(badgeFocal);
                    } else {
                        const assignBtn = document.createElement('button');
                        assignBtn.type = 'button';
                        assignBtn.className = 'btn btn-sm btn-primary py-0 px-2 me-1';
                        assignBtn.style.fontSize = '0.78rem';
                        assignBtn.style.lineHeight = '1.8';
                        assignBtn.title = 'Asignar como punto focal de la evaluación';
                        assignBtn.textContent = '✓ Asignar como Focal';
                        assignBtn.addEventListener('click', () => handleAssignFocal(c.id, c.nombre, c.email));
                        tdActions.appendChild(assignBtn);
                    }

                    const editBtn = document.createElement('button');
                    editBtn.type = 'button';
                    editBtn.className = 'btn btn-sm btn-outline-secondary py-0 px-2 me-1';
                    editBtn.style.fontSize = '0.78rem';
                    editBtn.style.lineHeight = '1.8';
                    editBtn.textContent = 'Editar';
                    editBtn.addEventListener('click', () => openEditContactForm(c));
                    tdActions.appendChild(editBtn);

                    const deleteBtn = document.createElement('button');
                    deleteBtn.type = 'button';
                    deleteBtn.className = 'btn btn-sm btn-outline-danger py-0 px-2';
                    deleteBtn.style.fontSize = '0.78rem';
                    deleteBtn.style.lineHeight = '1.8';
                    deleteBtn.textContent = 'Eliminar';
                    deleteBtn.addEventListener('click', () => handleDeleteContact(c));
                    tdActions.appendChild(deleteBtn);

                    tr.appendChild(tdActions);
                    focalTbodyEl.appendChild(tr);
                });
            }

            function applyContactsSearch() {
                const query = (focalSearchInputEl?.value || '').trim().toLowerCase();
                if (!query) {
                    renderContactsGrid(focalContactsList);
                    return;
                }

                const filtered = focalContactsList.filter(c => {
                    return (c.nombre && c.nombre.toLowerCase().includes(query)) ||
                           (c.rol && c.rol.toLowerCase().includes(query)) ||
                           (c.email && c.email.toLowerCase().includes(query)) ||
                           (c.telefono && c.telefono.toLowerCase().includes(query)) ||
                           (c.otro && c.otro.toLowerCase().includes(query)) ||
                           (c.notas && c.notas.toLowerCase().includes(query));
                });

                renderContactsGrid(filtered);
            }

            async function loadFocalContacts() {
                if (!activeFocalEmpresaId) return;

                if (focalLoadingEl) focalLoadingEl.hidden = false;
                if (focalContentEl) focalContentEl.style.opacity = '0.5';
                hideFocalAlert();

                try {
                    let response = await fetch('@Url.Content("~/Administration/MasterTables/empresa-subsidiaria/")' + activeFocalEmpresaId + '/contacts', {
                        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!response.ok) {
                        response = await fetch('@Url.Content("~/Administration/AdoptionProcess/empresa/")' + activeFocalEmpresaId + '/contacts', {
                            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                        });
                    }

                    if (!response.ok) throw new Error(`HTTP ${response.status}`);

                    const data = await response.json();
                    focalContactsList = data.items || [];
                    const total = data.totalCount ?? focalContactsList.length;

                    if (focalBadgeCountEl) {
                        focalBadgeCountEl.textContent = `${total} ${total === 1 ? 'contacto' : 'contactos'}`;
                    }

                    applyContactsSearch();
                } catch (err) {
                    console.error('Error cargando contactos de la empresa:', err);
                    showFocalAlert('No fue posible cargar los contactos de la subsidiaria. Verifique la conexión.', 'danger');
                } finally {
                    if (focalLoadingEl) focalLoadingEl.hidden = true;
                    if (focalContentEl) focalContentEl.style.opacity = '1';
                }
            }

            async function handleAssignFocal(contactId, contactName, contactEmail) {
                if (!activeFocalEmpresaId) return;

                try {
                    const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                    const assignUrl = '@Url.Content("~/Administration/AdoptionProcess/")' + '@p.Id/empresa/' + activeFocalEmpresaId + '/assign-focal';
                    const response = await fetch(assignUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': tokenEl ? tokenEl.value : ''
                        },
                        body: JSON.stringify({ contactoFocalId: contactId })
                    });

                    const data = await response.json();
                    if (response.ok && data.success) {
                        activeCurrentFocalId = contactId;

                        // Actualizar UI inline en el acordeón de empresas
                        const displaySpan = document.getElementById(`focal-display-${activeFocalEmpresaId}`);
                        const emailSpan = document.getElementById(`focal-email-${activeFocalEmpresaId}`);
                        const triggerBtn = document.querySelector(`.btn-assign-focal-modal[data-empresa-id="${activeFocalEmpresaId}"]`);

                        if (displaySpan) displaySpan.textContent = data.focalName || contactName || 'Sin asignar';
                        if (emailSpan) emailSpan.textContent = (data.focalEmail || contactEmail) ? `<${data.focalEmail || contactEmail}>` : '';
                        if (triggerBtn) triggerBtn.dataset.currentFocalId = String(contactId);

                        applyContactsSearch();
                        showFocalAlert(`"${contactName}" ha sido asignado como Especialista Focal.`, 'success');
                    } else {
                        showFocalAlert(data.message || 'Error al asignar focal.', 'danger');
                    }
                } catch (err) {
                    console.error('Error al asignar contacto focal:', err);
                    showFocalAlert('Ocurrió un error al guardar la asignación.', 'danger');
                }
            }

            async function handleRemoveFocal() {
                if (!activeFocalEmpresaId) return;

                try {
                    const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                    const assignUrl = '@Url.Content("~/Administration/AdoptionProcess/")' + '@p.Id/empresa/' + activeFocalEmpresaId + '/assign-focal';
                    const response = await fetch(assignUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': tokenEl ? tokenEl.value : ''
                        },
                        body: JSON.stringify({ contactoFocalId: null })
                    });

                    const data = await response.json();
                    if (response.ok && data.success) {
                        activeCurrentFocalId = null;

                        // Actualizar UI inline en el acordeón de empresas
                        const displaySpan = document.getElementById(`focal-display-${activeFocalEmpresaId}`);
                        const emailSpan = document.getElementById(`focal-email-${activeFocalEmpresaId}`);
                        const triggerBtn = document.querySelector(`.btn-assign-focal-modal[data-empresa-id="${activeFocalEmpresaId}"]`);

                        if (displaySpan) displaySpan.textContent = 'Sin asignar';
                        if (emailSpan) emailSpan.textContent = '';
                        if (triggerBtn) triggerBtn.dataset.currentFocalId = '';

                        applyContactsSearch();
                        showFocalAlert('Se ha quitado la asignación de especialista focal.', 'warning');
                    } else {
                        showFocalAlert(data.message || 'Error al quitar focal.', 'danger');
                    }
                } catch (err) {
                    console.error('Error al quitar contacto focal:', err);
                    showFocalAlert('Ocurrió un error al quitar la asignación.', 'danger');
                }
            }

            async function handleDeleteContact(contact) {
                if (!confirm(`¿Está seguro de que desea eliminar a "${contact.nombre}"?`)) return;

                try {
                    const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                    let url = '@Url.Content("~/Administration/MasterTables/empresa-subsidiaria/")' + activeFocalEmpresaId + '/contacts/' + contact.id + '/delete';
                    let response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': tokenEl ? tokenEl.value : ''
                        }
                    });

                    if (!response.ok) {
                        url = '@Url.Content("~/Administration/AdoptionProcess/empresa/")' + activeFocalEmpresaId + '/contacts/' + contact.id + '/delete';
                        response = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': tokenEl ? tokenEl.value : ''
                            }
                        });
                    }

                    const data = await response.json();
                    if (response.ok && data.success) {
                        if (activeCurrentFocalId && String(contact.id) === String(activeCurrentFocalId)) {
                            await handleRemoveFocal();
                        }
                        showFocalAlert('Contacto eliminado exitosamente.', 'success');
                        await loadFocalContacts();
                    } else {
                        showFocalAlert(data.message || 'Error al eliminar contacto.', 'danger');
                    }
                } catch (err) {
                    console.error('Error al eliminar contacto:', err);
                    showFocalAlert('Error de comunicación al eliminar el contacto.', 'danger');
                }
            }

            if (toggleFormBtn) {
                toggleFormBtn.addEventListener('click', () => {
                    if (formCardEl.style.display === 'none' || !formCardEl.style.display) {
                        openCreateContactForm();
                    } else {
                        closeContactForm();
                    }
                });
            }

            if (formCloseBtn) formCloseBtn.addEventListener('click', closeContactForm);
            if (formCancelBtn) formCancelBtn.addEventListener('click', closeContactForm);

            if (contactForm) {
                contactForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    if (!activeFocalEmpresaId) return;

                    const nombre = fieldNombre?.value?.trim();
                    if (!nombre) {
                        showFocalAlert('El nombre del contacto es obligatorio.', 'warning');
                        if (fieldNombre) fieldNombre.focus();
                        return;
                    }

                    const isEditing = Boolean(fieldId?.value);
                    const contactId = fieldId?.value;
                    const payload = {
                        nombre: nombre,
                        rol: fieldRol?.value?.trim() || null,
                        email: fieldEmail?.value?.trim() || null,
                        telefono: fieldTelefono?.value?.trim() || null,
                        otro: fieldOtro?.value?.trim() || null,
                        notas: fieldNotas?.value?.trim() || null
                    };

                    if (formSubmitBtn) {
                        formSubmitBtn.disabled = true;
                        formSubmitBtn.textContent = 'Guardando...';
                    }

                    try {
                        const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                        let url = isEditing
                            ? '@Url.Content("~/Administration/MasterTables/empresa-subsidiaria/")' + activeFocalEmpresaId + '/contacts/' + contactId + '/edit'
                            : '@Url.Content("~/Administration/MasterTables/empresa-subsidiaria/")' + activeFocalEmpresaId + '/contacts';

                        let response = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': tokenEl ? tokenEl.value : ''
                            },
                            body: JSON.stringify(payload)
                        });

                        if (!response.ok) {
                            url = isEditing
                                ? '@Url.Content("~/Administration/AdoptionProcess/empresa/")' + activeFocalEmpresaId + '/contacts/' + contactId + '/edit'
                                : '@Url.Content("~/Administration/AdoptionProcess/empresa/")' + activeFocalEmpresaId + '/contacts';

                            response = await fetch(url, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': tokenEl ? tokenEl.value : ''
                                },
                                body: JSON.stringify(payload)
                            });
                        }

                        const data = await response.json();
                        if (response.ok && data.success) {
                            closeContactForm();
                            showFocalAlert(data.message || (isEditing ? 'Contacto actualizado.' : 'Contacto registrado.'), 'success');
                            await loadFocalContacts();

                            if (isEditing && activeCurrentFocalId && String(contactId) === String(activeCurrentFocalId)) {
                                const displaySpan = document.getElementById(`focal-display-${activeFocalEmpresaId}`);
                                const emailSpan = document.getElementById(`focal-email-${activeFocalEmpresaId}`);
                                if (displaySpan) displaySpan.textContent = payload.nombre;
                                if (emailSpan) emailSpan.textContent = payload.email ? `<${payload.email}>` : '';
                            }
                        } else {
                            showFocalAlert(data.message || 'Error al guardar el contacto.', 'danger');
                        }
                    } catch (err) {
                        console.error('Error al guardar contacto:', err);
                        showFocalAlert('Error de comunicación al guardar el contacto.', 'danger');
                    } finally {
                        if (formSubmitBtn) {
                            formSubmitBtn.disabled = false;
                            formSubmitBtn.textContent = isEditing ? 'Actualizar Contacto' : 'Guardar Contacto';
                        }
                    }
                });
            }

            if (focalSearchInputEl) {
                focalSearchInputEl.addEventListener('input', applyContactsSearch);
            }

            if (btnRemoveFocal) {
                btnRemoveFocal.addEventListener('click', handleRemoveFocal);
            }

            // Click en el lápiz / botón para abrir modal de focal
            document.querySelectorAll('.btn-assign-focal-modal').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const empresaId = parseInt(this.dataset.empresaId, 10);
                    const empresaName = this.dataset.empresaName || 'Empresa';
                    const currentFocalId = this.dataset.currentFocalId || '';

                    activeFocalEmpresaId = empresaId;
                    activeCompanyName = empresaName;
                    activeCurrentFocalId = currentFocalId ? parseInt(currentFocalId, 10) : null;

                    if (focalCompanyNameEl) focalCompanyNameEl.textContent = empresaName;
                    if (focalSearchInputEl) focalSearchInputEl.value = '';
                    closeContactForm();
                    hideFocalAlert();

                    if (focalModalBs) focalModalBs.show();
                    loadFocalContacts();
                });
            });

            // ==========================================
            // GESTIÓN DE CAPACIDADES POR EMPRESA (AJAX)
            // ==========================================
            const getVerificationToken = () => {
                const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                return tokenEl ? tokenEl.value : '';
            };

            // Cambio de radio pill [A, F, NA]
            document.querySelectorAll('.cap-radio-btn').forEach(radio => {
                radio.addEventListener('change', async function () {
                    const procesoId = this.dataset.procesoId;
                    const empresaId = this.dataset.empresaId;
                    const capacidadId = parseInt(this.dataset.capacidadId, 10);
                    const estadoCodigo = this.value;

                    const row = this.closest('tr');
                    const commentInput = row ? row.querySelector('.cap-comment-input') : null;
                    const comentario = commentInput ? commentInput.value : null;

                    try {
                        const res = await fetch(`@Url.Content("~/Administration/AdoptionProcess/")${procesoId}/empresa/${empresaId}/capability-state`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': getVerificationToken()
                            },
                            body: JSON.stringify({
                                capacidadId: capacidadId,
                                estadoCodigo: estadoCodigo,
                                comentario: comentario
                            })
                        });
                        if (res.ok) {
                            row?.classList.add('table-success');
                            setTimeout(() => row?.classList.remove('table-success'), 800);
                        }
                    } catch (e) {
                        console.error('Error al actualizar estado de capacidad:', e);
                    }
                });
            });

            // Guardar comentario individual de capacidad con feedback visual
            const saveCapComment = async (inp) => {
                const procesoId = inp.dataset.procesoId;
                const empresaId = inp.dataset.empresaId;
                const capacidadId = parseInt(inp.dataset.capacidadId, 10);

                const row = inp.closest('tr');
                const activeRadio = row ? row.querySelector('.cap-radio-btn:checked') : null;
                const estadoCodigo = activeRadio ? activeRadio.value : 'NA';
                const comentario = inp.value.trim();

                const originalVal = (inp.dataset.originalVal || '').trim();
                if (comentario === originalVal && !inp.classList.contains('cell-dirty')) {
                    return;
                }

                inp.classList.remove('cell-dirty');
                inp.classList.add('cell-saving');

                try {
                    const res = await fetch(`@Url.Content("~/Administration/AdoptionProcess/")${procesoId}/empresa/${empresaId}/capability-state`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getVerificationToken()
                        },
                        body: JSON.stringify({
                            capacidadId: capacidadId,
                            estadoCodigo: estadoCodigo,
                            comentario: comentario
                        })
                    });

                    inp.classList.remove('cell-saving');
                    if (res.ok) {
                        inp.dataset.originalVal = comentario;
                        inp.classList.add('cell-flash-success');
                        setTimeout(() => inp.classList.remove('cell-flash-success'), 1200);
                    } else {
                        inp.classList.add('cell-flash-error');
                        setTimeout(() => inp.classList.remove('cell-flash-error'), 1800);
                    }
                } catch (e) {
                    console.error('Error al guardar comentario de capacidad:', e);
                    inp.classList.remove('cell-saving');
                    inp.classList.add('cell-flash-error');
                    setTimeout(() => inp.classList.remove('cell-flash-error'), 1800);
                }
            };

            // Detección de edición en inputs de observación
            document.querySelectorAll('.cap-comment-input').forEach(inp => {
                inp.addEventListener('input', function () {
                    const orig = (this.dataset.originalVal || '').trim();
                    if (this.value.trim() !== orig) {
                        this.classList.add('cell-dirty');
                    } else {
                        this.classList.remove('cell-dirty');
                    }
                });
                inp.addEventListener('blur', function () {
                    saveCapComment(this);
                });
                inp.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        this.blur();
                    }
                });
            });

            // Guardar comentario general de subsidiaria
            const saveCompanyGeneralComment = async (inp) => {
                const procesoId = inp.dataset.procesoId;
                const empresaId = inp.dataset.empresaId;
                const comentario = inp.value.trim();
                const orig = (inp.dataset.originalVal || '').trim();

                if (comentario === orig && !inp.classList.contains('cell-dirty')) {
                    return;
                }

                inp.classList.remove('cell-dirty');
                inp.classList.add('cell-saving');

                try {
                    const res = await fetch(`@Url.Content("~/Administration/AdoptionProcess/")${procesoId}/empresa/${empresaId}/capability-comment`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getVerificationToken()
                        },
                        body: JSON.stringify({
                            comentario: comentario
                        })
                    });

                    inp.classList.remove('cell-saving');
                    if (res.ok) {
                        inp.dataset.originalVal = comentario;
                        inp.classList.add('cell-flash-success');
                        setTimeout(() => inp.classList.remove('cell-flash-success'), 1200);
                    } else {
                        inp.classList.add('cell-flash-error');
                        setTimeout(() => inp.classList.remove('cell-flash-error'), 1800);
                    }
                } catch (e) {
                    console.error('Error al guardar comentario general de subsidiaria:', e);
                    inp.classList.remove('cell-saving');
                    inp.classList.add('cell-flash-error');
                    setTimeout(() => inp.classList.remove('cell-flash-error'), 1800);
                }
            };

            document.querySelectorAll('.company-caps-general-comment').forEach(inp => {
                inp.addEventListener('input', function () {
                    const orig = (this.dataset.originalVal || '').trim();
                    if (this.value.trim() !== orig) {
                        this.classList.add('cell-dirty');
                    } else {
                        this.classList.remove('cell-dirty');
                    }
                });
                inp.addEventListener('blur', function () {
                    saveCompanyGeneralComment(this);
                });
                inp.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        this.blur();
                    }
                });
            });

            // Botón consolidado "Guardar Cobertura" por subsidiaria
            document.querySelectorAll('.btn-save-all-company-caps').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const procesoId = this.dataset.procesoId;
                    const empresaId = this.dataset.empresaId;
                    const card = this.closest('.accordion-item') || this.closest('.card') || document;
                    const commentInputs = card.querySelectorAll(`.cap-comment-input[data-empresa-id="${empresaId}"]`);
                    const generalInput = card.querySelector(`.company-caps-general-comment[data-empresa-id="${empresaId}"]`);

                    const origText = this.innerHTML;
                    this.disabled = true;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Guardando...';

                    const promises = [];
                    commentInputs.forEach(inp => {
                        promises.push(saveCapComment(inp));
                    });
                    if (generalInput) {
                        promises.push(saveCompanyGeneralComment(generalInput));
                    }

                    await Promise.all(promises);

                    this.classList.remove('btn-primary');
                    this.classList.add('btn-success');
                    this.innerHTML = '<span>✓ Guardado con Éxito</span>';

                    setTimeout(() => {
                        this.disabled = false;
                        this.classList.remove('btn-success');
                        this.classList.add('btn-primary');
                        this.innerHTML = origText;
                    }, 2000);
                });
            });
        }
    });
</script>
<style>
    .company-accordion-btn {
        display: flex !important;
        align-items: center !important;
    }
    .company-accordion-btn::after {
        margin-left: 0.75rem !important;
        flex-shrink: 0 !important;
    }
    .company-drag-handle {
        cursor: grab;
        transition: color 0.15s ease, transform 0.15s ease;
    }
    .company-drag-handle:hover {
        color: var(--bs-primary) !important;
        transform: scale(1.2);
    }
    .company-drag-handle:active {
        cursor: grabbing !important;
    }
    .company-draggable-item.dragging {
        opacity: 0.45;
        border: 2px dashed #0d6efd !important;
        background-color: #f0f7ff !important;
    }
    .company-draggable-item.drag-over-top {
        border-top: 3px solid #0d6efd !important;
    }
    .company-draggable-item.drag-over-bottom {
        border-bottom: 3px solid #0d6efd !important;
    }
    .cell-dirty {
        background-color: #fff9db !important;
        border-color: #ffc107 !important;
        box-shadow: 0 0 0 0.15rem rgba(255, 193, 7, 0.25) !important;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }
    .cell-saving {
        background-color: #e7f1ff !important;
        border-color: #0d6efd !important;
    }
    .cell-flash-success {
        background-color: #d1e7dd !important;
