            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle justificación No Aplica
        const convAplica = document.getElementById('convAplica');
        const wrapJust = document.getElementById('wrap-justificacion');
        if (convAplica && wrapJust) {
            convAplica.addEventListener('change', function() {
                wrapJust.style.display = this.checked ? 'none' : 'block';
            });
        }

        // Modal Registrar Tecnología
        document.querySelectorAll('.btn-add-tech').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('regEmpresaId').value = this.dataset.empresaId || '';
                document.getElementById('regProcesoEmpId').value = this.dataset.procesoEmpId || '';
            });
        });

        // Modal Guardar Contrato (Principal o Adenda)
        document.querySelectorAll('.btn-add-contract').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('contractImplId').value = this.dataset.implId || '';
                document.getElementById('contractIsAdenda').value = 'false';
                document.getElementById('contractParentId').value = '';
                document.getElementById('modalContractTitle').innerText = 'Registrar Contrato Principal';
                document.getElementById('contractParentNotice').style.display = 'none';
            });
        });

        document.querySelectorAll('.btn-add-adenda').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('contractImplId').value = this.dataset.implId || '';
                document.getElementById('contractIsAdenda').value = 'true';
                document.getElementById('contractParentId').value = this.dataset.parentId || '';
                document.getElementById('modalContractTitle').innerText = 'Registrar Adenda de Contrato';
                document.getElementById('contractParentNumText').innerText = this.dataset.parentNum || '';
                document.getElementById('contractParentNotice').style.display = 'block';
            });
        });

        // Modal Guardar Driver
        document.querySelectorAll('.btn-add-driver').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('driverImplId').value = this.dataset.implId || '';
            });
        });

        // Cálculo dinámico de costo en driver
        function updateDriverTotal() {
            const cant = parseFloat(document.getElementById('drvCant').value) || 0;
            const precio = parseFloat(document.getElementById('drvPrecio').value) || 0;
            const total = cant * precio;
            document.getElementById('drvTotalCalc').innerText = '$' + total.toFixed(2);
        }
        document.querySelectorAll('.drv-calc').forEach(function(input) {
            input.addEventListener('input', updateDriverTotal);
        });

        // Modal Modelo de Operación
        document.querySelectorAll('.btn-op-model').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('opImplId').value = this.dataset.implId || '';
                document.getElementById('opTipo').value = this.dataset.tipoId || '';
                document.getElementById('opModalidad').value = this.dataset.modId || '';
            });
        });
    });
</script>
}
