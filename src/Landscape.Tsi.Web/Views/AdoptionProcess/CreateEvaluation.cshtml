<!-- =======================================================
     MODAL: BUSCADOR Y REGISTRO RÁPIDO DE TECNOLOGÍAS TSI
     ======================================================= -->
<div class="modal fade" id="modal-technology-lookup" tabindex="-1" aria-labelledby="modalTechLookupTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content shadow">
            <div class="modal-header bg-light">
                <div>
                    <h5 class="modal-title fw-bold text-primary mb-0" id="modalTechLookupTitle">
                        💻 Catálogo de Tecnologías TSI
                    </h5>
                    <small class="text-muted" id="modalTechLookupContext">Seleccionando para: <span class="fw-bold text-dark" id="modalTechContextName">General</span></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar" id="btnCloseModalTech"></button>
            </div>

            <div class="modal-body p-0">
                <!-- Pestañas del Modal -->
                <ul class="nav nav-tabs nav-fill bg-light border-bottom px-3 pt-2" id="techLookupTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-tech-search-btn" data-bs-toggle="tab" data-bs-target="#tab-tech-search" type="button" role="tab" aria-controls="tab-tech-search" aria-selected="true">
                            🔍 Buscar Tecnología Existente
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-tech-create-btn" data-bs-toggle="tab" data-bs-target="#tab-tech-create" type="button" role="tab" aria-controls="tab-tech-create" aria-selected="false">
                            ➕ Registrar Nueva Tecnología
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3" id="techLookupTabsContent">
                    <!-- PESTAÑA 1: BUSCADOR EN VIVO -->
                    <div class="tab-pane fade show active" id="tab-tech-search" role="tabpanel" aria-labelledby="tab-tech-search-btn">
                        <div class="mb-3">
                            <label for="inputTechSearch" class="form-label small fw-semibold text-secondary mb-1">
                                Filtrar por nombre de solución o familia tecnológica:
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">🔍</span>
                                <input type="text" id="inputTechSearch" class="form-control" placeholder="Escriba para filtrar en tiempo real (ej. Palo Alto, CyberArk, Imperva)..." autocomplete="off" />
                                <button type="button" class="btn btn-outline-secondary" id="btnResetTechSearch">Limpiar</button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-muted" id="techSearchCount">Cargando catálogo...</span>
                            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold" id="linkSwitchToCreate">
                                + ¿No está en la lista? Registrar nueva
                            </button>
                        </div>

                        <div class="table-responsive border rounded" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-hover table-sm align-middle mb-0" id="tableTechResults">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Tecnología TSI</th>
                                        <th>Familia</th>
                                        <th class="text-end pe-3" style="width: 130px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyTechResults">
                                    <!-- Generado dinámicamente -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- PESTAÑA 2: REGISTRO RÁPIDO (ALTA EN TTecnologiaTSI) -->
                    <div class="tab-pane fade" id="tab-tech-create" role="tabpanel" aria-labelledby="tab-tech-create-btn">
                        <form id="formQuickCreateTech" action="javascript:void(0);" onsubmit="return false;" class="p-2">
                            @Html.AntiForgeryToken()
                            <div class="alert alert-info small mb-3">
                                💡 Al registrar la tecnología, se guardará de inmediato en el catálogo maestro (<code>TTecnologiaTSI</code>) y quedará seleccionada para esta subsidiaria sin recargar ni perder los datos de la evaluación.
                            </div>

                            <div id="quickCreateAlert" class="alert alert-danger small d-none" role="alert"></div>

                            <div class="mb-3">
                                <label for="quickTechNombre" class="form-label fw-semibold">Nombre Corporativo de la Tecnología <span class="text-danger">*</span></label>
                                <input type="text" id="quickTechNombre" class="form-control" placeholder="Ej. CyberArk Privilege Cloud, FortiGate NGFW..." autocomplete="off" />
                                <div class="form-text small">Nombre oficial o corporativo del producto de software/hardware.</div>
                            </div>

                            <div class="mb-3">
                                <label for="quickTechNombreLocal" class="form-label fw-semibold">Nombre Local / Alternativo (Opcional)</label>
                                <input type="text" id="quickTechNombreLocal" class="form-control" placeholder="Ej. Alias comercial o nombre interno en subsidiaria..." autocomplete="off" />
                            </div>

                            <div class="mb-3">
                                <label for="quickTechFamiliaId" class="form-label fw-semibold">Familia Tecnológica (Opcional)</label>
                                <select id="quickTechFamiliaId" class="form-select">
                                    <option value="">-- Sin Familia Asignada --</option>
                                    @foreach (var f in Model.Familias)
                                    {
                                        <option value="@f.Id">@f.Label</option>
                                    }
                                </select>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-3">
                                <button type="button" class="btn btn-outline-secondary" id="btnCancelQuickTech">← Volver a Búsqueda</button>
                                <button type="button" class="btn btn-success fw-bold px-3" id="btnSubmitQuickTech">
                                    <span class="spinner-border spinner-border-sm d-none me-1" id="spinnerQuickTech" role="status" aria-hidden="true"></span>
                                    💾 Guardar y Seleccionar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // --- 1. Tab Navigation Helper & Buttons ---
        function switchToTab(tabSelector) {
            const tabBtn = document.querySelector(tabSelector);
            if (!tabBtn) return;
            const targetPaneId = tabBtn.getAttribute('data-bs-target');
            if (targetPaneId) {
                document.querySelectorAll('#evalStepsContent .tab-pane').forEach(p => p.classList.remove('show', 'active'));
                document.querySelectorAll('#evalSteps .nav-link').forEach(b => {
                    b.classList.remove('active');
                    b.setAttribute('aria-selected', 'false');
                });
                tabBtn.classList.add('active');
                tabBtn.setAttribute('aria-selected', 'true');
                const targetPane = document.querySelector(targetPaneId);
                if (targetPane) targetPane.classList.add('show', 'active');
            }
            if (window.bootstrap && bootstrap.Tab) {
                try {
                    bootstrap.Tab.getOrCreateInstance(tabBtn).show();
                } catch (_) {}
            }
            if (typeof refreshAllSubsidiaryParticipation === 'function') {
                refreshAllSubsidiaryParticipation();
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.querySelectorAll('.btn-next-tab').forEach(btn => {
            btn.addEventListener('click', function () {
                switchToTab(this.dataset.next);
            });
        });

        document.querySelectorAll('.btn-prev-tab').forEach(btn => {
            btn.addEventListener('click', function () {
                switchToTab(this.dataset.prev);
            });
        });

        document.querySelectorAll('#evalSteps button[data-bs-toggle="pill"]').forEach(btn => {
            btn.addEventListener('click', function () {
                const targetPaneId = this.getAttribute('data-bs-target');
                if (targetPaneId) {
                    document.querySelectorAll('#evalStepsContent .tab-pane').forEach(p => p.classList.remove('show', 'active'));
                    document.querySelectorAll('#evalSteps .nav-link').forEach(b => {
                        b.classList.remove('active');
                        b.setAttribute('aria-selected', 'false');
                    });
                    this.classList.add('active');
                    this.setAttribute('aria-selected', 'true');
                    const targetPane = document.querySelector(targetPaneId);
                    if (targetPane) targetPane.classList.add('show', 'active');
                    if (typeof refreshAllSubsidiaryParticipation === 'function') {
                        refreshAllSubsidiaryParticipation();
                    }
                }
            });
        });

        // --- 2. Dynamic Capabilities & Functionalities Real-Time Preview ---
        const selectBb = document.getElementById('selectBuildingBlock');
        const capContainer = document.getElementById('capabilities-content');
        const capPlaceholder = document.getElementById('capabilities-placeholder');
        const capSpinner = document.getElementById('cap-loading-spinner');
        const capBbName = document.getElementById('cap-bb-name');
        const capDomainName = document.getElementById('cap-domain-name');
        const capItemsList = document.getElementById('cap-items-list');

        function loadCapabilities(bbId) {
            if (!bbId || bbId === '0') {
                capPlaceholder.classList.remove('d-none');
                capContainer.classList.add('d-none');
                return;
            }

            capSpinner.classList.remove('d-none');

            fetch(`/Administration/AdoptionProcess/Evaluations/CapabilitiesPreview/${bbId}`)
                .then(res => {
                    if (!res.ok) throw new Error('No se pudo cargar capacidades');
                    return res.json();
                })
                .then(data => {
                    capSpinner.classList.add('d-none');
                    capPlaceholder.classList.add('d-none');
                    capContainer.classList.remove('d-none');

                    capBbName.innerText = data.buildingBlockNombre || 'Building Block';
                    capDomainName.innerText = data.dominioNombre || 'Dominio TSI';

                    capItemsList.innerHTML = '';
                    if (!data.capacidades || data.capacidades.length === 0) {
                        capItemsList.innerHTML = `
                            <div class="col-12">
                                <div class="alert alert-secondary mb-0 small">
                                    Este Building Block no cuenta aún con capacidades de seguridad mapeadas en las tablas maestras.
                                </div>
                            </div>
                        `;
                    } else {
                        data.capacidades.forEach(cap => {
                            const funcs = (cap.funcionalidades && cap.funcionalidades.length > 0)
                                ? cap.funcionalidades.map(f => `<li>${f}</li>`).join('')
                                : '<li class="text-muted">Sin funcionalidades registradas</li>';

                            const col = document.createElement('div');
                            col.className = 'col-md-6';
                            col.innerHTML = `
                                <div class="border rounded p-2 bg-light h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="small text-dark">${cap.nombre}</strong>
                                        <span class="badge bg-secondary" style="font-size:0.65rem;">${cap.estado || 'Capacidad'}</span>
                                    </div>
                                    <ul class="mb-0 small text-secondary ps-3" style="font-size:0.8rem;">
                                        ${funcs}
                                    </ul>
                                </div>
                            `;
                            capItemsList.appendChild(col);
                        });
                    }
                })
                .catch(err => {
                    capSpinner.classList.add('d-none');
                    console.error(err);
                });
        }

        if (selectBb) {
            selectBb.addEventListener('change', function () {
                loadCapabilities(this.value);
            });
            if (selectBb.value && selectBb.value !== '0') {
                loadCapabilities(selectBb.value);
            }
        }

        // --- 3. Synchronize Subsidiary Participation & Visibility (Steps 2, 3, 4) ---
        const checkAll = document.getElementById('checkAllSubsidiaries');
        const subCheckboxes = document.querySelectorAll('.sub-checkbox');

        function isSubsidiaryParticipating(empId) {
            const cb = document.querySelector(`.sub-checkbox[data-empresa-id="${empId}"]`);
            return cb ? cb.checked : false;
        }

        function syncSubsidiaryState(empId) {
            const cb = document.querySelector(`.sub-checkbox[data-empresa-id="${empId}"]`);
            const isParticipating = cb ? cb.checked : false;
            const targetJust = cb && cb.dataset.targetJust ? document.getElementById(cb.dataset.targetJust) : null;
            const hiddenAplica = cb ? document.getElementById(`hidden-aplica-${cb.dataset.index}`) : null;

            if (hiddenAplica) {
                hiddenAplica.value = isParticipating ? 'true' : 'false';
            }

            if (targetJust) {
                targetJust.disabled = isParticipating;
                if (isParticipating) {
                    targetJust.value = '';
                }
            }

            // Sincronizar Card AS-IS en Paso 3
            const card = document.getElementById(`card-asis-${empId}`);
            if (card) {
                card.style.display = isParticipating ? '' : 'none';

                // Habilitar o deshabilitar inputs del card para no enviar datos de empresas que no participan
                const formInputs = card.querySelectorAll('input:not([type="hidden"]), select, textarea');
                formInputs.forEach(input => {
                    input.disabled = !isParticipating;
                });

                // Si participa, restablecer estado del switch de tecnología
                if (isParticipating) {
                    const hasTechSw = card.querySelector('.switch-has-tech');
                    if (hasTechSw) {
                        hasTechSw.disabled = false;
                        const container = document.getElementById(hasTechSw.dataset.container);
                        if (container) {
                            container.style.display = hasTechSw.checked ? '' : 'none';
                        }
                    }
                }
            }

            // Sincronizar Fila en Tabla de Convergencia en Paso 4
            const convRow = document.getElementById(`conv-row-${empId}`);
            if (convRow) {
                convRow.style.display = isParticipating ? '' : 'none';
            }
        }

        function refreshAllSubsidiaryParticipation() {
            let totalParticipating = 0;
            subCheckboxes.forEach(cb => {
                const empId = cb.dataset.empresaId;
                syncSubsidiaryState(empId);
                if (isSubsidiaryParticipating(empId)) {
                    totalParticipating++;
                }
            });

            // Alertas en Paso 3 y Paso 4
            const alertNoPart3 = document.getElementById('alert-no-participating');
            const alertNoPart4 = document.getElementById('alert-no-participating-conv');
            if (alertNoPart3) {
                alertNoPart3.classList.toggle('d-none', totalParticipating > 0);
            }
            if (alertNoPart4) {
                alertNoPart4.classList.toggle('d-none', totalParticipating > 0);
            }

            // Asegurar que la primera card visible en el Paso 3 quede expandida si ninguna está abierta
            const visibleCards = Array.from(document.querySelectorAll('.as-is-card')).filter(c => c.style.display !== 'none');
            const openVisibleCard = visibleCards.find(c => c.querySelector('.accordion-collapse.show'));
            if (!openVisibleCard && visibleCards.length > 0) {
                const firstCard = visibleCards[0];
                const btn = firstCard.querySelector('.accordion-button');
                const collapse = firstCard.querySelector('.accordion-collapse');
                if (btn && collapse) {
                    btn.classList.remove('collapsed');
                    btn.setAttribute('aria-expanded', 'true');
                    collapse.classList.add('show');
                }
            }

            if (typeof updateConvergenceTable === 'function') {
                updateConvergenceTable();
            }
        }

        if (checkAll) {
            checkAll.addEventListener('change', function () {
                const checked = this.checked;
                subCheckboxes.forEach(cb => {
                    cb.checked = checked;
                });
                refreshAllSubsidiaryParticipation();
            });
        }

        subCheckboxes.forEach(cb => {
            cb.addEventListener('change', function () {
                refreshAllSubsidiaryParticipation();
            });
        });

        // --- 4. Switch Tiene Tecnología AS-IS ---
        document.querySelectorAll('.switch-has-tech').forEach(sw => {
            const container = document.getElementById(sw.dataset.container);
            sw.addEventListener('change', function () {
                if (container) {
                    container.style.display = this.checked ? '' : 'none';
                }
            });
            if (container) {
                container.style.display = sw.checked ? '' : 'none';
            }
        });

        // Navegación de pestañas: refrescar estado al mostrar cualquier pestaña
        document.querySelectorAll('#evalSteps button[data-bs-toggle="pill"]').forEach(tabTrigger => {
            tabTrigger.addEventListener('shown.bs.tab', function () {
                refreshAllSubsidiaryParticipation();
            });
        });

        // --- 6. Modo de Definición de Estándar Corporativo & Convergencia ---
        const modePending = document.getElementById('modePending');
        const modeDefined = document.getElementById('modeDefined');
        const cardPending = document.getElementById('card-mode-pending');
        const cardDefined = document.getElementById('card-mode-defined');
        const panelPending = document.getElementById('panel-standard-pending');
        const panelFields = document.getElementById('panel-standard-fields');
        const selectStandardTech = document.getElementById('selectStandardTech');
        const badgeConvMode = document.getElementById('badge-convergence-mode');
        const textConvMode = document.getElementById('text-convergence-mode');

        const btnOpenTechLookupStd = document.getElementById('btn-open-tech-lookup-std');
        const btnOpenTechLookupStdNew = document.getElementById('btn-open-tech-lookup-std-new');

        const standardInputs = [
            selectStandardTech,
            btnOpenTechLookupStd,
            btnOpenTechLookupStdNew,
            document.getElementById('inputContratoCorp'),
            document.getElementById('inputFechaAdjCorp'),
            document.getElementById('inputVendorCorp'),
            document.getElementById('inputContactoVendorCorp'),
            document.getElementById('inputPartnerCorp'),
            document.getElementById('inputContactoPartnerCorp')
        ];

        function setStandardMode(mode) {
            if (mode === 'pending') {
                if (modePending) modePending.checked = true;
                if (cardPending) {
                    cardPending.classList.add('border-primary');
                    cardPending.style.backgroundColor = '#f8faff';
                }
                if (cardDefined) {
                    cardDefined.classList.remove('border-primary');
                    cardDefined.style.backgroundColor = '#ffffff';
                }
                if (panelPending) panelPending.style.display = 'block';
                if (panelFields) panelFields.style.display = 'none';

                standardInputs.forEach(input => {
                    if (input) {
                        input.disabled = true;
                        if (input === selectStandardTech) input.value = '';
                    }
                });

                if (badgeConvMode) {
                    badgeConvMode.className = 'badge bg-primary';
                    badgeConvMode.innerText = 'Modo: Estándar por Definir';
                }
                if (textConvMode) {
                    textConvMode.innerHTML = 'Al iniciar la evaluación con estándar pendiente de definición, las subsidiarias permanecen en estado <strong>En Evaluación</strong> hasta que se adjudique el estándar tecnológico oficial:';
                }
            } else {
                if (modeDefined) modeDefined.checked = true;
                if (cardDefined) {
                    cardDefined.classList.add('border-primary');
                    cardDefined.style.backgroundColor = '#f8faff';
                }
                if (cardPending) {
                    cardPending.classList.remove('border-primary');
                    cardPending.style.backgroundColor = '#ffffff';
                }
                if (panelPending) panelPending.style.display = 'none';
                if (panelFields) panelFields.style.display = 'block';

                standardInputs.forEach(input => {
                    if (input) input.disabled = false;
                });

                if (badgeConvMode) {
                    badgeConvMode.className = 'badge bg-success';
                    badgeConvMode.innerText = 'Modo: Estándar Propuesto';
                }
                if (textConvMode) {
                    textConvMode.innerHTML = 'Alineación proyectada con base en la tecnología corporativa propuesta y el vencimiento contractual local de cada subsidiaria:';
                }
            }
            updateConvergenceTable();
        }

        if (cardPending) {
            cardPending.addEventListener('click', function () {
                setStandardMode('pending');
            });
        }

        if (cardDefined) {
            cardDefined.addEventListener('click', function () {
                setStandardMode('defined');
            });
        }

        if (modePending) {
            modePending.addEventListener('change', function () {
                if (this.checked) setStandardMode('pending');
            });
        }

        if (modeDefined) {
            modeDefined.addEventListener('change', function () {
                if (this.checked) setStandardMode('defined');
            });
        }

        function updateConvergenceTable() {
            const mPending = document.getElementById('modePending');
            const isPending = mPending ? mPending.checked : true;
            const selStd = document.getElementById('selectStandardTech');
            const standardId = selStd ? selStd.value : '';

            subCheckboxes.forEach(cb => {
                const empId = cb.dataset.empresaId;
                if (!isSubsidiaryParticipating(empId)) return;
                const idx = cb.dataset.index;
                const badge = document.getElementById(`conv-badge-${idx}`);
                if (!badge) return;

                if (isPending) {
                    badge.className = 'badge bg-warning text-dark';
                    badge.innerText = 'En Evaluación (Estándar por definir)';
                    return;
                }

                if (!standardId) {
                    badge.className = 'badge bg-secondary text-white';
                    badge.innerText = 'Seleccione estándar propuesto';
                    return;
                }

                const hasTechSw = document.querySelector(`.switch-has-tech[data-index="${idx}"]`);
                const asIsSelect = document.querySelector(`.select-tech-asis[data-index="${idx}"]`);
                const dateInput = document.querySelector(`.input-contract-end[data-index="${idx}"]`);

                const hasTech = hasTechSw ? hasTechSw.checked : false;
                const asIsId = asIsSelect ? asIsSelect.value : '';
                const dateVal = dateInput ? dateInput.value : '';

                if (!hasTech || !asIsId) {
                    badge.className = 'badge bg-primary text-white';
                    badge.innerText = 'Adopción Nueva';
                } else if (asIsId === standardId) {
                    badge.className = 'badge bg-success text-white';
                    badge.innerText = 'Alineado al Estándar';
                } else if (dateVal) {
                    badge.className = 'badge bg-info text-dark';
                    badge.innerText = 'Convergencia: ' + dateVal;
                } else {
                    badge.className = 'badge bg-secondary text-white';
                    badge.innerText = 'Por converger (Sin fecha)';
                }
            });
        }

        if (selectStandardTech) {
            selectStandardTech.addEventListener('change', updateConvergenceTable);
        }

        // --- 7. Sync AS-IS Selections to Convergence Table ---
        document.querySelectorAll('.select-tech-asis').forEach(sel => {
            sel.addEventListener('change', function () {
                const idx = this.dataset.index;
                const text = this.options[this.selectedIndex]?.text || 'Por definir';
                const td = document.getElementById(`conv-tech-${idx}`);
                const badge = document.getElementById(`badge-tech-${idx}`);
                if (td) td.innerText = (this.value && this.value !== '__open_modal__' ? text : 'Sin tecnología');
                if (badge) badge.innerText = (this.value && this.value !== '__open_modal__' ? text : 'Sin tecnología');
                updateConvergenceTable();
            });
        });

        document.querySelectorAll('.input-contract-end').forEach(input => {
            input.addEventListener('change', function () {
                const idx = this.dataset.index;
                const td = document.getElementById(`conv-date-${idx}`);
                if (td) {
                    td.innerText = this.value || 'Sin fecha registrada';
                }
                updateConvergenceTable();
            });
        });

        document.querySelectorAll('.switch-has-tech').forEach(sw => {
            sw.addEventListener('change', updateConvergenceTable);
        });

        // --- 8. Buscador y Registro Rápido de Tecnologías TSI en Modal ---
        const modalTechEl = document.getElementById('modal-technology-lookup');
        const modalTechInstance = modalTechEl ? bootstrap.Modal.getOrCreateInstance(modalTechEl) : null;
        const modalTechContextName = document.getElementById('modalTechContextName');
        const inputTechSearch = document.getElementById('inputTechSearch');
        const btnResetTechSearch = document.getElementById('btnResetTechSearch');
        const techSearchCount = document.getElementById('techSearchCount');
        const tbodyTechResults = document.getElementById('tbodyTechResults');
        const linkSwitchToCreate = document.getElementById('linkSwitchToCreate');
        const btnCancelQuickTech = document.getElementById('btnCancelQuickTech');
        const tabSearchBtn = document.getElementById('tab-tech-search-btn');
        const tabCreateBtn = document.getElementById('tab-tech-create-btn');
        const formQuickCreateTech = document.getElementById('formQuickCreateTech');
        const quickCreateAlert = document.getElementById('quickCreateAlert');
        const spinnerQuickTech = document.getElementById('spinnerQuickTech');
        const btnSubmitQuickTech = document.getElementById('btnSubmitQuickTech');
        const quickTechNombre = document.getElementById('quickTechNombre');
        const quickTechNombreLocal = document.getElementById('quickTechNombreLocal');
        const quickTechFamiliaId = document.getElementById('quickTechFamiliaId');

        // Preload catalog technologies safely
        let availableTechnologies = [];
        try {
            const catalogJsonEl = document.getElementById('initialTechCatalog');
            if (catalogJsonEl && catalogJsonEl.textContent) {
                availableTechnologies = JSON.parse(catalogJsonEl.textContent);
            }
        } catch (err) {
            console.warn('Error al parsear catálogo de tecnologías inicial:', err);
            availableTechnologies = [];
        }

        let currentTargetSelect = null;

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }

        function escapeAttr(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function renderTechResults(query) {
            if (!tbodyTechResults) return;
            const q = (query || '').trim().toLowerCase();
            const list = Array.isArray(availableTechnologies) ? availableTechnologies : [];
            const filtered = q
                ? list.filter(t => 
                    (t.nombre && t.nombre.toLowerCase().includes(q)) || 
                    (t.familia && t.familia.toLowerCase().includes(q))
                  )
                : list;

            if (techSearchCount) {
                techSearchCount.innerText = `Mostrando ${filtered.length} de ${list.length} tecnologías registradas`;
            }

            if (filtered.length === 0) {
                tbodyTechResults.innerHTML = `
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
