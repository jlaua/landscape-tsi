        // Quick create AJAX handler
        async function handleQuickCreateTech(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const nombre = (quickTechNombre?.value || '').trim();
            const local = (quickTechNombreLocal?.value || '').trim();
            const famId = quickTechFamiliaId?.value || '';

            if (!nombre) {
                if (quickCreateAlert) {
                    quickCreateAlert.className = 'alert alert-danger small';
                    quickCreateAlert.innerText = 'El nombre corporativo de la tecnología es obligatorio.';
                    quickCreateAlert.classList.remove('d-none');
                }
                quickTechNombre?.focus();
                return;
            }

            if (quickCreateAlert) quickCreateAlert.classList.add('d-none');
            if (btnSubmitQuickTech) btnSubmitQuickTech.disabled = true;
            if (spinnerQuickTech) spinnerQuickTech.classList.remove('d-none');

            try {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                const formData = new URLSearchParams();
                formData.append('__RequestVerificationToken', token);
                formData.append('nombreCorporativo', nombre);
                if (local) formData.append('nombreLocal', local);
                if (famId) formData.append('familiaId', famId);

                const endpoint = '@Url.Action("QuickCreateTechnology", "AdoptionProcess")';

                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: formData.toString()
                });

                if (!res.ok) {
                    throw new Error(`Error en el servidor al registrar la tecnología (${res.status} ${res.statusText}).`);
                }

                const result = await res.json();
                if (!result.succeeded) {
                    if (quickCreateAlert) {
                        quickCreateAlert.className = 'alert alert-danger small';
                        quickCreateAlert.innerText = result.message || 'No se pudo registrar la tecnología.';
                        quickCreateAlert.classList.remove('d-none');
                    }
                    return;
                }

                // Agregar al catálogo en memoria si no existe
                const list = Array.isArray(availableTechnologies) ? availableTechnologies : [];
                const exists = list.some(t => String(t.id) === String(result.id));
                if (!exists) {
                    list.push({
                        id: result.id,
                        nombre: result.nombre,
                        familia: result.familia || null
                    });
                    list.sort((a, b) => (a.nombre || '').localeCompare(b.nombre || ''));
                    availableTechnologies = list;
                }

                // Propagar la nueva opción a todos los desplegables de tecnologías
                addOptionToAllSelects(result.id, result.nombre);

                // Seleccionar en el desplegable activo y cerrar modal
                selectTechnology(result.id, result.nombre);

                // Actualizar la grilla de búsqueda del catálogo
                renderTechResults('');
            } catch (err) {
                console.error('Error al registrar tecnología rápida:', err);
                if (quickCreateAlert) {
                    quickCreateAlert.className = 'alert alert-danger small';
                    quickCreateAlert.innerText = err.message || 'Ocurrió un error inesperado al registrar la tecnología.';
                    quickCreateAlert.classList.remove('d-none');
                }
            } finally {
                if (btnSubmitQuickTech) btnSubmitQuickTech.disabled = false;
                if (spinnerQuickTech) spinnerQuickTech.classList.add('d-none');
            }
        }

