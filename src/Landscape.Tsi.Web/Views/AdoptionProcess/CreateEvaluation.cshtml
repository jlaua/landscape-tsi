            if (!nombre) {
                if (quickVendorContactAlert) {
                    quickVendorContactAlert.className = 'alert alert-danger small';
                    quickVendorContactAlert.innerText = 'El nombre del contacto es obligatorio.';
                    quickVendorContactAlert.classList.remove('d-none');
                }
                quickVendorContactNombre?.focus();
                return;
            }

            if (quickVendorContactAlert) quickVendorContactAlert.classList.add('d-none');
            if (btnSubmitQuickVendorContact) btnSubmitQuickVendorContact.disabled = true;
            if (spinnerQuickVendorContact) spinnerQuickVendorContact.classList.remove('d-none');

            try {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                const formData = new URLSearchParams();
                formData.append('__RequestVerificationToken', token);
                formData.append('vendorId', vendorId);
                formData.append('nombreContacto', nombre);
                if (rol) formData.append('rol', rol);
                if (email) formData.append('email', email);
                if (telefono) formData.append('telefono', telefono);
                if (notas) formData.append('notas', notas);

                const res = await fetch('@Url.Action("QuickCreateVendorContact", "AdoptionProcess")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: formData.toString()
                });

                if (!res.ok) throw new Error('Error al registrar el contacto de vendor.');
                const data = await res.json();
                if (!data.succeeded) {
                    if (quickVendorContactAlert) {
                        quickVendorContactAlert.className = 'alert alert-danger small';
                        quickVendorContactAlert.innerText = data.message || 'Error al guardar el contacto.';
                        quickVendorContactAlert.classList.remove('d-none');
                    }
                    return;
                }

                // Add to active row contact select and select it
                if (activeVendorContactIndex !== null) {
                    const selectContact = document.querySelector(`.select-vendor-contact[data-index="${activeVendorContactIndex}"]`);
                    const hiddenContactName = document.querySelector(`.input-vendor-contact-name[data-index="${activeVendorContactIndex}"]`);
                    if (selectContact) {
                        const label = data.nombre + (data.rol ? ` (${data.rol})` : '') + (data.email ? ` - ${data.email}` : '');
                        let opt = selectContact.querySelector(`option[value="${data.id}"]`);
                        if (!opt) {
                            opt = document.createElement('option');
                            opt.value = data.id;
                            selectContact.appendChild(opt);
                        }
                        opt.dataset.name = data.nombre;
                        opt.text = label;
                        selectContact.value = data.id;
                    }
                    if (hiddenContactName) {
                        hiddenContactName.value = data.nombre;
                    }
                }

                modalQuickVendorContact?.hide();
            } catch (err) {
                if (quickVendorContactAlert) {
                    quickVendorContactAlert.className = 'alert alert-danger small';
                    quickVendorContactAlert.innerText = err.message || 'Error de conexión.';
                    quickVendorContactAlert.classList.remove('d-none');
                }
            } finally {
                if (btnSubmitQuickVendorContact) btnSubmitQuickVendorContact.disabled = false;
                if (spinnerQuickVendorContact) spinnerQuickVendorContact.classList.add('d-none');
            }
        }

        if (btnSubmitQuickVendorContact) btnSubmitQuickVendorContact.addEventListener('click', handleQuickCreateVendorContact);
        if (quickVendorContactNombre) {
            quickVendorContactNombre.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleQuickCreateVendorContact();
                }
            });
        }

        // ----------------------------------------------------
        // CARGA DINÁMICA DE CONTACTOS DE PARTNER Y QUICK CREATE
        // ----------------------------------------------------
        let activePartnerContactIndex = null;
        const modalQuickPartnerContactEl = document.getElementById('modalQuickPartnerContact');
        const modalQuickPartnerContact = modalQuickPartnerContactEl ? bootstrap.Modal.getOrCreateInstance(modalQuickPartnerContactEl) : null;
        const quickPartnerContactAlert = document.getElementById('quickPartnerContactAlert');
        const quickPartnerContactPartnerNombre = document.getElementById('quickPartnerContactPartnerNombre');
        const quickPartnerContactPartnerId = document.getElementById('quickPartnerContactPartnerId');
        const quickPartnerContactNombre = document.getElementById('quickPartnerContactNombre');
        const quickPartnerContactRol = document.getElementById('quickPartnerContactRol');
        const quickPartnerContactEmail = document.getElementById('quickPartnerContactEmail');
        const quickPartnerContactTelefono = document.getElementById('quickPartnerContactTelefono');
        const quickPartnerContactNotas = document.getElementById('quickPartnerContactNotas');
        const btnSubmitQuickPartnerContact = document.getElementById('btnSubmitQuickPartnerContact');
        const spinnerQuickPartnerContact = document.getElementById('spinnerQuickPartnerContact');

        async function loadPartnerContacts(partnerId, targetSelect, selectedId = null) {
            if (!targetSelect) return;
            targetSelect.innerHTML = '<option value="">-- Seleccionar Contacto --</option>';
            if (!partnerId) return;

            try {
                const res = await fetch(`@Url.Action("GetPartnerContacts", "AdoptionProcess")?partnerId=${partnerId}`);
                if (!res.ok) return;
                const contacts = await res.json();
                if (Array.isArray(contacts) && contacts.length > 0) {
                    contacts.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.id;
                        opt.dataset.name = c.nombre;
                        opt.text = c.nombre + (c.rol ? ` (${c.rol})` : '') + (c.email ? ` - ${c.email}` : '');
                        if (selectedId && String(selectedId) === String(c.id)) {
                            opt.selected = true;
                        }
                        targetSelect.appendChild(opt);
                    });
                }
            } catch (e) {
                console.error('Error al cargar contactos de partner:', e);
            }
        }

        document.querySelectorAll('.btn-quick-partner-contact').forEach(btn => {
            btn.addEventListener('click', function () {
                activePartnerContactIndex = this.getAttribute('data-index');
                const rowPartnerSelect = document.querySelector(`.select-partner[data-index="${activePartnerContactIndex}"]`);
                const partnerId = rowPartnerSelect?.value;
                const partnerNombre = rowPartnerSelect?.selectedIndex > 0 ? rowPartnerSelect.options[rowPartnerSelect.selectedIndex].text : '';

                if (!partnerId) {
                    alert('Por favor, seleccione primero un Partner / Integrador en esta fila para poder asociar un contacto.');
                    rowPartnerSelect?.focus();
                    return;
                }

                if (quickPartnerContactPartnerNombre) quickPartnerContactPartnerNombre.value = partnerNombre;
                if (quickPartnerContactPartnerId) quickPartnerContactPartnerId.value = partnerId;
                if (quickPartnerContactNombre) quickPartnerContactNombre.value = '';
                if (quickPartnerContactRol) quickPartnerContactRol.value = '';
                if (quickPartnerContactEmail) quickPartnerContactEmail.value = '';
                if (quickPartnerContactTelefono) quickPartnerContactTelefono.value = '';
                if (quickPartnerContactNotas) quickPartnerContactNotas.value = '';
                if (quickPartnerContactAlert) {
                    quickPartnerContactAlert.classList.add('d-none');
                    quickPartnerContactAlert.innerText = '';
                }

                modalQuickPartnerContact?.show();
                setTimeout(() => quickPartnerContactNombre?.focus(), 200);
            });
        });

        async function handleQuickCreatePartnerContact() {
            const partnerId = quickPartnerContactPartnerId?.value || '';
            const nombre = (quickPartnerContactNombre?.value || '').trim();
            const rol = (quickPartnerContactRol?.value || '').trim();
            const email = (quickPartnerContactEmail?.value || '').trim();
            const telefono = (quickPartnerContactTelefono?.value || '').trim();
            const notas = (quickPartnerContactNotas?.value || '').trim();

            if (!partnerId) {
                if (quickPartnerContactAlert) {
                    quickPartnerContactAlert.className = 'alert alert-danger small';
                    quickPartnerContactAlert.innerText = 'Debe seleccionar un Partner / Integrador válido.';
                    quickPartnerContactAlert.classList.remove('d-none');
                }
                return;
            }

            if (!nombre) {
                if (quickPartnerContactAlert) {
                    quickPartnerContactAlert.className = 'alert alert-danger small';
                    quickPartnerContactAlert.innerText = 'El nombre del contacto es obligatorio.';
                    quickPartnerContactAlert.classList.remove('d-none');
                }
                quickPartnerContactNombre?.focus();
                return;
            }

            if (quickPartnerContactAlert) quickPartnerContactAlert.classList.add('d-none');
            if (btnSubmitQuickPartnerContact) btnSubmitQuickPartnerContact.disabled = true;
            if (spinnerQuickPartnerContact) spinnerQuickPartnerContact.classList.remove('d-none');

            try {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';
                const formData = new URLSearchParams();
                formData.append('__RequestVerificationToken', token);
                formData.append('partnerId', partnerId);
                formData.append('nombreContacto', nombre);
                if (rol) formData.append('rol', rol);
                if (email) formData.append('email', email);
                if (telefono) formData.append('telefono', telefono);
                if (notas) formData.append('notas', notas);

                const res = await fetch('@Url.Action("QuickCreatePartnerContact", "AdoptionProcess")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: formData.toString()
                });

                if (!res.ok) throw new Error('Error al registrar el contacto de partner.');
                const data = await res.json();
                if (!data.succeeded) {
                    if (quickPartnerContactAlert) {
                        quickPartnerContactAlert.className = 'alert alert-danger small';
                        quickPartnerContactAlert.innerText = data.message || 'Error al guardar el contacto.';
                        quickPartnerContactAlert.classList.remove('d-none');
                    }
                    return;
                }

                // Add to active row contact select and select it
                if (activePartnerContactIndex !== null) {
                    const selectContact = document.querySelector(`.select-partner-contact[data-index="${activePartnerContactIndex}"]`);
                    const hiddenContactName = document.querySelector(`.input-partner-contact-name[data-index="${activePartnerContactIndex}"]`);
                    if (selectContact) {
                        const label = data.nombre + (data.rol ? ` (${data.rol})` : '') + (data.email ? ` - ${data.email}` : '');
                        let opt = selectContact.querySelector(`option[value="${data.id}"]`);
                        if (!opt) {
                            opt = document.createElement('option');
                            opt.value = data.id;
                            selectContact.appendChild(opt);
                        }
                        opt.dataset.name = data.nombre;
                        opt.text = label;
                        selectContact.value = data.id;
                    }
                    if (hiddenContactName) {
                        hiddenContactName.value = data.nombre;
                    }
                }

                modalQuickPartnerContact?.hide();
            } catch (err) {
                if (quickPartnerContactAlert) {
                    quickPartnerContactAlert.className = 'alert alert-danger small';
                    quickPartnerContactAlert.innerText = err.message || 'Error de conexión.';
                    quickPartnerContactAlert.classList.remove('d-none');
                }
            } finally {
                if (btnSubmitQuickPartnerContact) btnSubmitQuickPartnerContact.disabled = false;
                if (spinnerQuickPartnerContact) spinnerQuickPartnerContact.classList.add('d-none');
            }
        }

        if (btnSubmitQuickPartnerContact) btnSubmitQuickPartnerContact.addEventListener('click', handleQuickCreatePartnerContact);
        if (quickPartnerContactNombre) {
            quickPartnerContactNombre.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleQuickCreatePartnerContact();
                }
            });
        }

        // Sincronizar y cargar cascada para Vendor y Partner
        document.querySelectorAll('.select-vendor').forEach(sel => {
            sel.addEventListener('change', function () {
                const idx = this.getAttribute('data-index');
                const hidden = document.querySelector(`.input-vendor-name[data-index="${idx}"]`);
                if (hidden) {
                    hidden.value = this.selectedIndex > 0 ? this.options[this.selectedIndex].text : '';
                }
                const contactSelect = document.querySelector(`.select-vendor-contact[data-index="${idx}"]`);
                const contactHidden = document.querySelector(`.input-vendor-contact-name[data-index="${idx}"]`);
                if (contactHidden) contactHidden.value = '';
                loadVendorContacts(this.value, contactSelect);
            });
        });

        document.querySelectorAll('.select-vendor-contact').forEach(sel => {
            sel.addEventListener('change', function () {
                const idx = this.getAttribute('data-index');
                const hidden = document.querySelector(`.input-vendor-contact-name[data-index="${idx}"]`);
                if (hidden) {
                    if (this.selectedIndex > 0) {
                        const opt = this.options[this.selectedIndex];
                        hidden.value = opt.dataset.name || opt.text;
                    } else {
                        hidden.value = '';
                    }
                }
            });
        });

        document.querySelectorAll('.select-partner').forEach(sel => {
            sel.addEventListener('change', function () {
                const idx = this.getAttribute('data-index');
                const hidden = document.querySelector(`.input-partner-name[data-index="${idx}"]`);
                if (hidden) {
                    hidden.value = this.selectedIndex > 0 ? this.options[this.selectedIndex].text : '';
                }
                const contactSelect = document.querySelector(`.select-partner-contact[data-index="${idx}"]`);
                const contactHidden = document.querySelector(`.input-partner-contact-name[data-index="${idx}"]`);
                if (contactHidden) contactHidden.value = '';
                loadPartnerContacts(this.value, contactSelect);
            });
        });

        document.querySelectorAll('.select-partner-contact').forEach(sel => {
            sel.addEventListener('change', function () {
                const idx = this.getAttribute('data-index');
                const hidden = document.querySelector(`.input-partner-contact-name[data-index="${idx}"]`);
                if (hidden) {
                    if (this.selectedIndex > 0) {
                        const opt = this.options[this.selectedIndex];
                        hidden.value = opt.dataset.name || opt.text;
                    } else {
                        hidden.value = '';
                    }
                }
            });
        });

        // Sincronizar montos Anual / Tri-anual hacia Total
        document.querySelectorAll('.input-monto-trianual, .input-monto-anual').forEach(inp => {
            inp.addEventListener('input', function () {
                const idx = this.getAttribute('data-index');
                const totalInp = document.querySelector(`.input-monto-total[data-index="${idx}"]`);
                const trianualInp = document.querySelector(`.input-monto-trianual[data-index="${idx}"]`);
                const anualInp = document.querySelector(`.input-monto-anual[data-index="${idx}"]`);
                if (totalInp && (!totalInp.value || parseFloat(totalInp.value) === 0)) {
                    totalInp.value = (trianualInp && trianualInp.value) ? trianualInp.value : ((anualInp && anualInp.value) ? anualInp.value : '');
                }
            });
        });

        // Pre-renderizar catálogo inmediatamente al cargar el DOM
        renderTechResults('');

        // Manejo de modalidad PAYG en contratos de subsidiarias
        document.querySelectorAll('.switch-payg').forEach(sw => {
            sw.addEventListener('change', function() {
                const idx = this.dataset.index;
                const isPayg = this.checked;
                const startInput = document.querySelector(`.input-contract-start[data-index="${idx}"]`);
                const endInput = document.querySelector(`.input-contract-end[data-index="${idx}"]`);
                if (startInput) {
                    startInput.disabled = isPayg;
                    if (isPayg) startInput.value = '';
                }
                if (endInput) {
                    endInput.disabled = isPayg;
                    if (isPayg) endInput.value = '';
                }
            });
        });

        // Initialize state safely after all listeners and variables are fully declared
        try {
            renderTechResults('');
            setStandardMode('pending');
            refreshAllSubsidiaryParticipation();

            // Cargar contactos iniciales si ya tienen un valor seleccionado
            document.querySelectorAll('.select-vendor').forEach(sel => {
                if (sel.value) {
                    const idx = sel.getAttribute('data-index');
                    const contactSelect = document.querySelector(`.select-vendor-contact[data-index="${idx}"]`);
                    loadVendorContacts(sel.value, contactSelect);
                }
            });
            document.querySelectorAll('.select-partner').forEach(sel => {
                if (sel.value) {
                    const idx = sel.getAttribute('data-index');
                    const contactSelect = document.querySelector(`.select-partner-contact[data-index="${idx}"]`);
                    loadPartnerContacts(sel.value, contactSelect);
                }
            });
        } catch (e) {
            console.warn('Initialization error in CreateEvaluation:', e);
        }
    });
</script>
}
