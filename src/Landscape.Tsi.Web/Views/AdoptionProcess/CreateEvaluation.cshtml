@model Landscape.Tsi.Web.Models.CreateEvaluationViewModel
@using Landscape.Tsi.Application.Identity
@{
    ViewData["Title"] = "Nueva Solicitud de Evaluación - Procesos de Adopción TSI";
}

<nav aria-label="Ruta de navegación">
    <ol class="breadcrumb-list">
        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li><a asp-action="Evaluations">Procesos de Adopción TSI</a></li>
        <li><a asp-action="Evaluations">Evaluaciones</a></li>
        <li aria-current="page">Nueva Evaluación</li>
    </ol>
</nav>

<section class="admin-shell" aria-labelledby="create-eval-title">
    <div class="mb-4">
        <p class="eyebrow text-uppercase text-primary fw-semibold mb-1">PROCESOS DE ADOPCIÓN TSI · FASE 2: EVALUACIÓN</p>
        <h1 id="create-eval-title" class="h2 mb-1">Nueva Solicitud de Evaluación Técnica</h1>
        <p class="supporting-text mb-0">
            Configure la solicitud vinculada al Building Block, consulte sus capacidades y funcionalidades maestras, convoque subsidiarias con selección múltiple y registre el diagnóstico AS-IS contractual.
        </p>
    </div>

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="app-alert app-alert-error mb-3" role="alert">
            <strong>Error: </strong> @error
        </div>
    }

    <form method="post" asp-action="SaveEvaluation" id="form-create-eval" class="needs-validation">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <!-- Barra de Acción Rápida: Guardar desde cualquier paso -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 p-3 bg-white border rounded-3 shadow-sm">
            <div>
                <span class="badge bg-primary fs-7 mb-1">Registro de Solicitud</span>
                <div class="text-muted small">Complete los datos básicos (Paso 1 y 2) y guarde la evaluación directamente. Los pasos 3 (AS-IS) y 4 (Estándar) son opcionales.</div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Evaluations" class="btn btn-outline-danger">Cancelar</a>
                <button type="submit" class="btn btn-success fw-bold px-4 shadow-sm" id="btnTopSubmitEval">
                    💾 Guardar Solicitud de Evaluación
                </button>
            </div>
        </div>

        <!-- Wizard Navigation Pills -->
        <ul class="nav nav-pills mb-4 bg-light p-2 rounded-3 gap-2" id="evalSteps" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="step1-tab" data-bs-toggle="pill" data-bs-target="#step1" type="button" role="tab" aria-selected="true">
                    1. Definición & Taxonomía TSI
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="step2-tab" data-bs-toggle="pill" data-bs-target="#step2" type="button" role="tab" aria-selected="false">
                    2. Subsidiarias Participantes (Checkboxes)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="step3-tab" data-bs-toggle="pill" data-bs-target="#step3" type="button" role="tab" aria-selected="false">
                    3. Diagnóstico AS-IS & Contratos
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="step4-tab" data-bs-toggle="pill" data-bs-target="#step4" type="button" role="tab" aria-selected="false">
                    4. Estándar Corporativo & Convergencia
                </button>
            </li>
        </ul>

        <div class="tab-content" id="evalStepsContent">
            <!-- ==========================================
                 PASO 1: DEFINICIÓN & TAXONOMÍA TSI
                 ========================================== -->
            <div class="tab-pane fade show active" id="step1" role="tabpanel" aria-labelledby="step1-tab">
                <div class="card p-4 shadow-sm border-0 mb-4">
                    <h2 class="h5 fw-bold text-primary mb-3">Ficha de la Solicitud de Evaluación</h2>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="Codigo" class="form-label fw-semibold">Código del Proceso <span class="text-danger">*</span></label>
                            <input asp-for="Codigo" class="form-control font-monospace fw-bold" readonly />
                            <span asp-validation-for="Codigo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-9">
                            <label asp-for="Nombre" class="form-label fw-semibold">Nombre de la Evaluación <span class="text-danger">*</span></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Evaluación Corporativa de Gestión de Accesos Privilegiados (PAM)" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DominioId" class="form-label fw-semibold">Dominio TSI <span class="text-danger">*</span></label>
                            <select asp-for="DominioId" class="form-select" id="selectDominio">
                                <option value="">-- Seleccionar Dominio --</option>
                                @foreach (var d in Model.Dominios)
                                {
                                    <option value="@d.Id">@d.Label</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="BuildingBlockId" class="form-label fw-semibold">Building Block <span class="text-danger">*</span></label>
                            <select asp-for="BuildingBlockId" class="form-select" id="selectBuildingBlock" required>
                                <option value="">-- Seleccionar Building Block --</option>
                                @foreach (var bb in Model.BuildingBlocks)
                                {
                                    <option value="@bb.Id">@bb.Label</option>
                                }
                            </select>
                            <span asp-validation-for="BuildingBlockId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EstadoAdopcionId" class="form-label fw-semibold">Estado de Adopción (TMEstadoAdopcionTSI) <span class="text-danger">*</span></label>
                            <select asp-for="EstadoAdopcionId" class="form-select">
                                @foreach (var e in Model.EstadosAdopcion)
                                {
                                    <option value="@e.Id" selected="@(e.Label.Contains("EVALUA", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                        @e.Label
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LiderCorporativo" class="form-label fw-semibold">Líder Corporativo TSI</label>
                            <input asp-for="LiderCorporativo" class="form-control" placeholder="Nombre del líder o arquitecto evaluador" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FechaInicio" class="form-label fw-semibold">Fecha de Inicio <span class="text-danger">*</span></label>
                            <input asp-for="FechaInicio" type="date" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FechaEstimadaCierre" class="form-label fw-semibold">Fecha Estimada de Cierre</label>
                            <input asp-for="FechaEstimadaCierre" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Objetivo" class="form-label fw-semibold">Objetivo de la Evaluación</label>
                            <textarea asp-for="Objetivo" class="form-control" rows="3" placeholder="Definir el propósito estratégico, necesidades identificadas en el roadmap TSI..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Alcance" class="form-label fw-semibold">Alcance y Restricciones</label>
                            <textarea asp-for="Alcance" class="form-control" rows="3" placeholder="Subsidiarias alcanzadas, ambientes (on-premise, cloud), restricciones regulatorias..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Live Capabilities & Functionalities Preview -->
                <div class="card p-4 shadow-sm border-0 mb-4 bg-light">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4">🧩</span>
                            <div>
                                <h3 class="h6 fw-bold mb-0">Capacidades y Funcionalidades Relacionadas (Taxonomía Maestra)</h3>
                                <p class="text-muted small mb-0">Cargadas en tiempo real desde <code>TCapacidadDeSeguridad</code> y <code>TFuncionalidad</code> según el Building Block seleccionado.</p>
                            </div>
                        </div>
                        <span id="cap-loading-spinner" class="spinner-border spinner-border-sm text-primary d-none" role="status"></span>
                    </div>

                    <div id="capabilities-preview-container">
                        <div class="alert alert-info d-flex align-items-center gap-2 mb-0" id="capabilities-placeholder">
                            <span>ℹ️</span>
                            <span>Selecciona un <strong>Building Block</strong> para visualizar automáticamente sus capacidades y funcionalidades mapeadas.</span>
                        </div>
                        <div id="capabilities-content" class="d-none">
                            <div class="p-3 bg-white rounded border mb-2">
                                <span class="badge bg-primary mb-2" id="cap-bb-name">Building Block</span>
                                <span class="badge bg-secondary mb-2 ms-1" id="cap-domain-name">Dominio</span>
                                <div id="cap-items-list" class="row g-3 mt-1"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-end">
                    <button type="button" class="btn btn-primary px-4 btn-next-tab" data-next="#step2-tab">
                        Continuar a Subsidiarias →
                    </button>
                </div>
            </div>

            <!-- ==========================================
                 PASO 2: CONVOCATORIA DE SUBSIDIARIAS
                 ========================================== -->
            <div class="tab-pane fade" id="step2" role="tabpanel" aria-labelledby="step2-tab">
                <div class="card p-4 shadow-sm border-0 mb-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                        <div>
                            <h2 class="h5 fw-bold text-primary mb-1">Convocatoria de Subsidiarias Participantes</h2>
                            <p class="text-muted small mb-0">
                                Utilice los <strong>checkboxes</strong> para incluir o excluir subsidiarias en lote.
                            </p>
                        </div>
                        <div class="form-check form-switch fs-6">
                            <input class="form-check-input" type="checkbox" id="checkAllSubsidiaries" checked>
                            <label class="form-check-label fw-semibold" for="checkAllSubsidiaries">Seleccionar todas</label>
                        </div>
                    </div>

                    <div class="responsive-table">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 90px;" class="text-center">Participa</th>
                                    <th style="width: 320px;">Empresa Subsidiaria</th>
                                    <th>Justificación por No Participar del proceso</th>
                                </tr>
                            </thead>
                            <tbody>
                            @for (var i = 0; i < Model.Subsidiaries.Count; i++)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input type="hidden" asp-for="Subsidiaries[i].EmpresaId" />
                                        <input type="hidden" asp-for="Subsidiaries[i].EmpresaNombre" />
                                        <input type="hidden" asp-for="Subsidiaries[i].Aplica" id="hidden-aplica-@i" class="hidden-aplica" data-empresa-id="@Model.Subsidiaries[i].EmpresaId" />
                                        <input type="checkbox" class="form-check-input sub-checkbox" asp-for="Subsidiaries[i].Selected" data-empresa-id="@Model.Subsidiaries[i].EmpresaId" data-index="@i" data-target-just="just-@i" />
                                    </td>
                                    <td>
                                        <strong>@Model.Subsidiaries[i].EmpresaNombre</strong>
                                    </td>
                                    <td>
                                        <input type="text" asp-for="Subsidiaries[i].JustificacionNoAplica" id="just-@i" class="form-control form-control-sm input-justificacion" placeholder="Indique motivo por el que no participa en el proceso..." disabled />
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary px-4 btn-prev-tab" data-prev="#step1-tab">← Volver a Definición</button>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success px-4 fw-bold">
                            💾 Guardar Solicitud de Evaluación
                        </button>
                        <button type="button" class="btn btn-primary px-4 btn-next-tab" data-next="#step3-tab">Continuar a Diagnóstico AS-IS (Opcional) →</button>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 PASO 3: DIAGNÓSTICO AS-IS & CONTRATOS
                 ========================================== -->
            <div class="tab-pane fade" id="step3" role="tabpanel" aria-labelledby="step3-tab">
                <div class="card p-4 shadow-sm border-0 mb-4">
                    <div class="mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div>
                                <h2 class="h5 fw-bold text-primary mb-1">Diagnóstico AS-IS por Subsidiaria</h2>
                                <p class="text-muted small mb-0">
                                    Para cada empresa participante, registre si ya cuenta con tecnología desplegada, su proveedor local y fecha contractual.
                                </p>
                            </div>
                            <span class="badge bg-info text-dark px-3 py-2 fs-7 fw-semibold">Paso Opcional</span>
                        </div>
                        <div class="alert alert-info border-0 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div class="small">
                                <strong>💡 ¿No cuenta con contratos o tecnologías en este momento?</strong> Puede omitir este paso y <strong>Guardar la Solicitud ahora</strong>. Al entrar al detalle del proceso podrá registrar las tecnologías de cada empresa de forma individual (con el botón <em>+ Registrar Tecnología Implementada</em>).
                            </div>
                            <button type="submit" class="btn btn-sm btn-success fw-bold text-nowrap">
                                💾 Guardar Solicitud Ahora
                            </button>
                        </div>
                    </div>
                    <div id="alert-no-participating" class="alert alert-warning d-none mb-3 d-flex align-items-center gap-2" role="alert">
                        <span class="fs-5">⚠️</span>
                        <div>
                            <strong>No hay subsidiarias participantes seleccionadas.</strong>
                            <div class="small">En el Paso 2 no se ha marcado ninguna empresa como participante. Vuelva al <strong>Paso 2 (Subsidiarias Participantes)</strong> para marcar las empresas que participarán en esta evaluación.</div>
                        </div>
                    </div>

                    <div class="accordion" id="accordionAsIs">
                    @for (var i = 0; i < Model.SubsidiaryAsIsList.Count; i++)
                    {
                        var empId = Model.SubsidiaryAsIsList[i].EmpresaId;
                        var empNom = Model.SubsidiaryAsIsList[i].EmpresaNombre;
                        <div class="accordion-item mb-3 border rounded shadow-sm as-is-card" id="card-asis-@empId">
                            <h2 class="accordion-header" id="heading-asis-@i">
                                <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-asis-@i" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="collapse-asis-@i">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary">AS-IS</span>
                                        <strong>@empNom</strong>
                                        <span class="badge bg-secondary-subtle text-secondary ms-2" id="badge-tech-@i">Tecnología en evaluación</span>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapse-asis-@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="heading-asis-@i" data-bs-parent="#accordionAsIs">
                                <div class="accordion-body">
                                    <input type="hidden" asp-for="SubsidiaryAsIsList[i].EmpresaId" />
                                    <input type="hidden" asp-for="SubsidiaryAsIsList[i].EmpresaNombre" />

                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input switch-has-tech" type="checkbox" asp-for="SubsidiaryAsIsList[i].TieneTecnologia" data-container="tech-fields-@i" />
                                        <label class="form-check-label fw-semibold" asp-for="SubsidiaryAsIsList[i].TieneTecnologia">
                                            ¿La empresa cuenta con una solución tecnológica desplegada actualmente para este Building Block?
                                        </label>
                                    </div>

                                    <div id="tech-fields-@i">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label asp-for="SubsidiaryAsIsList[i].TecnologiaId" class="form-label fw-semibold">Tecnología AS-IS (Catálogo TTecnologiaTSI)</label>
                                                <div class="input-group">
                                                    <select asp-for="SubsidiaryAsIsList[i].TecnologiaId" class="form-select select-tech-asis" data-index="@i" id="select-tech-asis-@i" data-context-label="@empNom">
                                                        <option value="">-- Seleccionar o dejar no registrada --</option>
                                                        <option value="__open_modal__" class="fw-bold text-primary">🔍 Buscar o registrar nueva tecnología...</option>
                                                        @foreach (var t in Model.TecnologiasDisponibles)
                                                        {
                                                            <option value="@t.Id">@t.Label</option>
                                                        }
                                                    </select>
                                                    <button type="button" class="btn btn-outline-primary btn-open-tech-lookup" data-bs-toggle="modal" data-bs-target="#modal-technology-lookup" data-target-select="select-tech-asis-@i" data-context-label="@empNom" data-initial-tab="search" title="Buscar con filtros en catálogo">
                                                        🔍 Buscar
                                                    </button>
                                                    <button type="button" class="btn btn-outline-success btn-open-tech-lookup" data-bs-toggle="modal" data-bs-target="#modal-technology-lookup" data-target-select="select-tech-asis-@i" data-context-label="@empNom" data-initial-tab="create" title="Registrar nueva tecnología en catálogo">
                                                        ➕ Nueva
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <label asp-for="SubsidiaryAsIsList[i].VersionDesplegada" class="form-label fw-semibold">Versión Desplegada</label>
                                                <input asp-for="SubsidiaryAsIsList[i].VersionDesplegada" class="form-control" placeholder="Ej. v12.4.1" />
                                            </div>
                                            <div class="col-md-3">
                                                <label asp-for="SubsidiaryAsIsList[i].TipoOperacionId" class="form-label fw-semibold">Tipo Operación</label>
                                                <select asp-for="SubsidiaryAsIsList[i].TipoOperacionId" class="form-select">
                                                    <option value="">-- No definido --</option>
                                                    @foreach (var o in Model.TiposOperacion)
                                                    {
                                                        <option value="@o.Id">@o.Label</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="col-md-3">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <label asp-for="SubsidiaryAsIsList[i].VendorId" class="form-label fw-semibold mb-0">Fabricante / Vendor</label>
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-bold text-primary btn-quick-vendor" data-index="@i" title="Registrar nuevo Fabricante / Vendor">+ Nuevo</button>
                                                </div>
                                                <select asp-for="SubsidiaryAsIsList[i].VendorId" class="form-select select-vendor" data-index="@i">
                                                    <option value="">-- Seleccionar Vendor --</option>
                                                    @foreach (var v in Model.Vendors)
                                                    {
                                                        <option value="@v.Id">@v.Label</option>
                                                    }
                                                </select>
                                                <input type="hidden" asp-for="SubsidiaryAsIsList[i].VendorNombre" class="input-vendor-name" data-index="@i" />
                                            </div>
                                            <div class="col-md-3">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <label asp-for="SubsidiaryAsIsList[i].VendorContactoId" class="form-label fw-semibold mb-0">Contacto Vendor Local</label>
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-bold text-primary btn-quick-vendor-contact" data-index="@i" title="Registrar nuevo Contacto Vendor">+ Nuevo</button>
                                                </div>
                                                <select asp-for="SubsidiaryAsIsList[i].VendorContactoId" class="form-select select-vendor-contact" data-index="@i">
                                                    <option value="">-- Seleccionar Contacto --</option>
                                                </select>
                                                <input type="hidden" asp-for="SubsidiaryAsIsList[i].VendorContacto" class="input-vendor-contact-name" data-index="@i" />
                                            </div>
                                            <div class="col-md-3">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <label asp-for="SubsidiaryAsIsList[i].PartnerId" class="form-label fw-semibold mb-0">Partner / Integrador Local</label>
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-bold text-primary btn-quick-partner" data-index="@i" title="Registrar nuevo Partner">+ Nuevo</button>
                                                </div>
                                                <select asp-for="SubsidiaryAsIsList[i].PartnerId" class="form-select select-partner" data-index="@i">
                                                    <option value="">-- Directo (Sin Partner) --</option>
                                                    @foreach (var pt in Model.Partners)
                                                    {
                                                        <option value="@pt.Id">@pt.Label</option>
                                                    }
                                                </select>
                                                <input type="hidden" asp-for="SubsidiaryAsIsList[i].PartnerNombre" class="input-partner-name" data-index="@i" />
                                            </div>
                                            <div class="col-md-3">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <label asp-for="SubsidiaryAsIsList[i].PartnerContactoId" class="form-label fw-semibold mb-0">Contacto Partner Local</label>
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-bold text-primary btn-quick-partner-contact" data-index="@i" title="Registrar nuevo Contacto Partner">+ Nuevo</button>
                                                </div>
                                                <select asp-for="SubsidiaryAsIsList[i].PartnerContactoId" class="form-select select-partner-contact" data-index="@i">
                                                    <option value="">-- Seleccionar Contacto --</option>
                                                </select>
                                                <input type="hidden" asp-for="SubsidiaryAsIsList[i].PartnerContacto" class="input-partner-contact-name" data-index="@i" />
                                            </div>

                                            <!-- Contrato Local -->
                                            <div class="col-12 mt-3">
                                                <h6 class="fw-bold text-secondary border-bottom pb-2">Contrato Local Vigente</h6>
                                            </div>
                                            <div class="col-md-2">
                                                <label asp-for="SubsidiaryAsIsList[i].NumeroContrato" class="form-label fw-semibold">N° Contrato</label>
                                                <input asp-for="SubsidiaryAsIsList[i].NumeroContrato" class="form-control" placeholder="CT-LOCAL-2024-..." />
                                            </div>
                                            <div class="col-md-2">
                                                <label asp-for="SubsidiaryAsIsList[i].FechaInicioContrato" class="form-label fw-semibold">Fecha Inicio</label>
                                                <input asp-for="SubsidiaryAsIsList[i].FechaInicioContrato" type="date" class="form-control input-contract-start" data-index="@i" />
                                            </div>
                                            <div class="col-md-2">
                                                <label asp-for="SubsidiaryAsIsList[i].FechaFinContrato" class="form-label fw-semibold">Fecha Fin</label>
                                                <input asp-for="SubsidiaryAsIsList[i].FechaFinContrato" type="date" class="form-control input-contract-end" data-index="@i" />
                                            </div>
                                            <div class="col-md-2">
                                                <label asp-for="SubsidiaryAsIsList[i].MontoAnual" class="form-label fw-semibold">Monto Anual</label>
                                                <input asp-for="SubsidiaryAsIsList[i].MontoAnual" type="number" step="0.01" class="form-control input-monto-anual" data-index="@i" placeholder="0.00" />
                                            </div>
                                            <div class="col-md-2">
                                                <label asp-for="SubsidiaryAsIsList[i].MontoTrianual" class="form-label fw-semibold">Monto Tri-anual</label>
                                                <input asp-for="SubsidiaryAsIsList[i].MontoTrianual" type="number" step="0.01" class="form-control input-monto-trianual" data-index="@i" placeholder="0.00" />
                                            </div>
                                            <div class="col-md-1">
                                                <label asp-for="SubsidiaryAsIsList[i].MontoContratado" class="form-label fw-semibold">Total</label>
                                                <input asp-for="SubsidiaryAsIsList[i].MontoContratado" type="number" step="0.01" class="form-control input-monto-total" data-index="@i" placeholder="0.00" />
                                            </div>
                                            <div class="col-md-1">
                                                <label asp-for="SubsidiaryAsIsList[i].MonedaContrato" class="form-label fw-semibold">Moneda</label>
                                                <select asp-for="SubsidiaryAsIsList[i].MonedaContrato" class="form-select">
                                                    <option value="USD">USD</option>
                                                    <option value="PEN">PEN</option>
                                                </select>
                                            </div>
                                            <div class="col-12 mt-1">
                                                <div class="form-check form-switch">
                                                    <input asp-for="SubsidiaryAsIsList[i].EsPayg" class="form-check-input switch-payg" data-index="@i" type="checkbox" id="switchPayg_@i" />
                                                    <label class="form-check-label fw-semibold text-primary small" for="switchPayg_@i">
                                                        ⚡ Modalidad Pago por Uso / Pay as you Go (PAYG) - Fechas de contrato no aplican
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary px-4 btn-prev-tab" data-prev="#step2-tab">← Volver a Subsidiarias</button>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success px-4 fw-bold">
                            💾 Guardar Solicitud de Evaluación
                        </button>
                        <button type="button" class="btn btn-primary px-4 btn-next-tab" data-next="#step4-tab">Continuar a Estándar Corporativo (Opcional) →</button>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 PASO 4: ESTÁNDAR CORPORATIVO & CONVERGENCIA
                 ========================================== -->
            <div class="tab-pane fade" id="step4" role="tabpanel" aria-labelledby="step4-tab">
                <div class="card p-4 shadow-sm border-0 mb-4">
                    <div class="mb-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                            <h2 class="h5 fw-bold text-primary mb-0">4. Estándar Tecnológico Corporativo & Convergencia</h2>
                            <span class="badge bg-info text-dark px-3 py-2 fs-7 fw-semibold">Paso Opcional · Definición Flexible</span>
                        </div>
                        <p class="text-muted small mb-0">
                            En un proceso de evaluación técnica, es común que el estándar corporativo <strong>aún no esté definido</strong> y sea justamente el resultado final de la evaluación el que determine cuál será la tecnología estándar. Indique el modo aplicable para esta solicitud:
                        </p>
                    </div>

                    <!-- Selector de Modo de Estándar -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="card h-100 p-3 standard-option-card border-primary" id="card-mode-pending" style="cursor: pointer; border-width: 2px !important; background-color: #f8faff;">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="StandardDefinitionMode" id="modePending" value="pending" checked />
                                    <label class="form-check-label fw-bold text-dark fs-6" for="modePending">
                                        🎯 Determinar estándar oficial como resultado de la evaluación
                                    </label>
                                </div>
                                <p class="text-muted small mt-2 mb-2">
                                    <strong>Recomendado para nuevas solicitudes.</strong> La solicitud iniciará sin un estándar prefijado. Al concluir el análisis técnico o PoC, el estándar definitivo se oficializará desde la ficha técnica o al editar la evaluación.
                                </p>
                                <span class="badge bg-warning text-dark align-self-start">Estándar: Pendiente de adjudicación técnica</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card h-100 p-3 standard-option-card" id="card-mode-defined" style="cursor: pointer; border-width: 2px !important;">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="StandardDefinitionMode" id="modeDefined" value="defined" />
                                    <label class="form-check-label fw-bold text-dark fs-6" for="modeDefined">
                                        📌 Ya cuento con una tecnología corporativa propuesta o predefinida
                                    </label>
                                </div>
                                <p class="text-muted small mt-2 mb-2">
                                    Utilice esta opción si la corporación ya dispone de una tecnología estándar propuesta o contratada y la evaluación validará la homologación y convergencia de las subsidiarias convocadas.
                                </p>
                                <span class="badge bg-secondary align-self-start" id="badge-mode-defined">Estándar: Predefinido / Propuesto</span>
                            </div>
                        </div>
                    </div>

                    <!-- Panel Informativo: Modo Pendiente -->
                    <div id="panel-standard-pending" class="alert alert-light border border-info p-3 mb-4 rounded-3">
                        <div class="d-flex align-items-start gap-3">
                            <span class="fs-4">💡</span>
                            <div>
                                <h3 class="h6 fw-bold text-primary mb-1">Evaluación Abierta sin Estándar Previo</h3>
                                <p class="small text-muted mb-0">
                                    La evaluación técnica se registrará sin forzar un estándar. Una vez comparadas las alternativas de mercado con los comités de arquitectura, podrá definir la tecnología ganadora mediante el botón <strong>"Oficializar Estándar Resultante"</strong> en la ficha detallada o actualizándola desde <strong>"Editar Evaluación"</strong>.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Panel de Formulario: Modo Predefinido (Colapsable) -->
                    <div id="panel-standard-fields" style="display: none;" class="p-3 bg-light rounded-3 border mb-4">
                        <h3 class="h6 fw-bold text-primary mb-3">📋 Datos de la Tecnología Corporativa Preseleccionada</h3>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="TecnologiaEstandarId" class="form-label fw-semibold">Tecnología Corporativa Propuesta</label>
                                <div class="input-group">
                                    <select asp-for="TecnologiaEstandarId" class="form-select" id="selectStandardTech" disabled data-context-label="Estándar Corporativo">
                                        <option value="">-- Seleccionar Tecnología Propuesta --</option>
                                        <option value="__open_modal__" class="fw-bold text-primary">🔍 Buscar o registrar nueva tecnología...</option>
                                        @foreach (var t in Model.TecnologiasDisponibles)
                                        {
                                            <option value="@t.Id">@t.Label</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-outline-primary btn-open-tech-lookup" id="btn-open-tech-lookup-std" data-bs-toggle="modal" data-bs-target="#modal-technology-lookup" data-target-select="selectStandardTech" data-context-label="Estándar Corporativo" data-initial-tab="search" disabled title="Buscar con filtros en catálogo">
                                        🔍 Buscar
                                    </button>
                                    <button type="button" class="btn btn-outline-success btn-open-tech-lookup" id="btn-open-tech-lookup-std-new" data-bs-toggle="modal" data-bs-target="#modal-technology-lookup" data-target-select="selectStandardTech" data-context-label="Estándar Corporativo" data-initial-tab="create" disabled title="Registrar nueva tecnología en catálogo">
                                        ➕ Nueva
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="NumeroContratoCorporativo" class="form-label fw-semibold">N° Contrato Corporativo TSI</label>
                                <input asp-for="NumeroContratoCorporativo" class="form-control" placeholder="CT-CORP-TSI-2026-..." id="inputContratoCorp" disabled />
                            </div>

                            <div class="col-md-3">
                                <label asp-for="FechaAdjudicacionCorporativa" class="form-label fw-semibold">Fecha de Adjudicación</label>
                                <input asp-for="FechaAdjudicacionCorporativa" type="date" class="form-control" id="inputFechaAdjCorp" disabled />
                            </div>

                            <div class="col-md-3">
                                <label asp-for="VendorCorporativo" class="form-label fw-semibold">Vendor Corporativo</label>
                                <input asp-for="VendorCorporativo" class="form-control" placeholder="Fabricante Corporativo" id="inputVendorCorp" disabled />
                            </div>

                            <div class="col-md-3">
                                <label asp-for="ContactoVendorCorporativo" class="form-label fw-semibold">Contacto Vendor Corporativo</label>
                                <input asp-for="ContactoVendorCorporativo" class="form-control" placeholder="Email / Representante" id="inputContactoVendorCorp" disabled />
                            </div>

                            <div class="col-md-3">
                                <label asp-for="PartnerCorporativo" class="form-label fw-semibold">Partner Corporativo</label>
                                <input asp-for="PartnerCorporativo" class="form-control" placeholder="Integrador Corporativo" id="inputPartnerCorp" disabled />
                            </div>

                            <div class="col-md-3">
                                <label asp-for="ContactoPartnerCorporativo" class="form-label fw-semibold">Contacto Partner Corporativo</label>
                                <input asp-for="ContactoPartnerCorporativo" class="form-control" placeholder="Email / Representante" id="inputContactoPartnerCorp" disabled />
                            </div>
                        </div>
                    </div>

                    <!-- Cronograma de Convergencia TSI Calculado -->
                    <div class="p-3 bg-light rounded border">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h3 class="h6 fw-bold mb-0">📅 Proyección del Cronograma de Convergencia TSI</h3>
                            <span class="badge bg-primary" id="badge-convergence-mode">Modo: Estándar por Definir</span>
                        </div>
                        <p class="text-secondary small mb-3" id="text-convergence-mode">
                            Al iniciar la evaluación con estándar pendiente de definición, las subsidiarias permanecen en estado <strong>En Evaluación</strong> hasta que se adjudique el estándar tecnológico oficial:
                        </p>
                        <div id="alert-no-participating-conv" class="alert alert-warning d-none mb-3 d-flex align-items-center gap-2" role="alert">
                            <span class="fs-5">⚠️</span>
                            <div>
                                <strong>No hay subsidiarias participantes para convergencia.</strong>
                                <div class="small">Ninguna empresa se encuentra marcada como participante en el Paso 2.</div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-bordered bg-white mb-0" id="table-convergence">
                                <thead>
                                    <tr class="table-secondary">
                                        <th>Subsidiaria</th>
                                        <th>Tecnología AS-IS</th>
                                        <th>Vencimiento Contrato Local</th>
                                        <th>Estado de Convergencia Previsto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @for (var i = 0; i < Model.Subsidiaries.Count; i++)
                                {
                                    <tr class="conv-row" id="conv-row-@Model.Subsidiaries[i].EmpresaId">
                                        <td><strong>@Model.Subsidiaries[i].EmpresaNombre</strong></td>
                                        <td id="conv-tech-@i">Por definir</td>
                                        <td id="conv-date-@i">Sin fecha registrada</td>
                                        <td>
                                            <span class="badge bg-warning text-dark" id="conv-badge-@i">En Evaluación (Estándar por definir)</span>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary px-4 btn-prev-tab" data-prev="#step3-tab">← Volver a Diagnóstico AS-IS</button>
                    <div class="d-flex gap-2">
                        <a asp-action="Evaluations" class="btn btn-outline-danger">Cancelar</a>
                        <button type="submit" class="btn btn-success px-4 fw-bold">
                            💾 Guardar Solicitud de Evaluación
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</section>

<!-- Hidden trigger for programmatic modal opening -->
<button type="button" id="btn-trigger-tech-modal" class="d-none" data-bs-toggle="modal" data-bs-target="#modal-technology-lookup" aria-hidden="true"></button>

<script type="application/json" id="initialTechCatalog">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TecnologiasCatalogo ?? (IReadOnlyList<Landscape.Tsi.Web.Models.TechnologyCatalogItem>)Array.Empty<Landscape.Tsi.Web.Models.TechnologyCatalogItem>(), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
</script>

