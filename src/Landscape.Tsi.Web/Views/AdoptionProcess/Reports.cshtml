                                            <td class="text-end text-warning td-driver-val">@FormatSmart(tot)</td>
                                        }
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- PESTAÑA 4: CAPACIDADES POR EMPRESA -->
        <div class="tab-pane fade" id="pane-capacidades" role="tabpanel" aria-labelledby="tab-capacidades">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div>
                        <h2 class="h5 mb-0">Matriz de Cobertura de Capacidades por Subsidiaria</h2>
                        <small class="text-muted">Mapeo de estado técnico: Activo (A), Funcionalidad futura (F) y No aplica (NA). Puede ordenar arrastrando mediante el icono <span class="fw-bold">⠿</span>.</small>
                    </div>
                    <div class="d-flex gap-3 align-items-center flex-wrap">
                        <span class="badge bg-success-subtle text-success border border-success-subtle small d-none order-saved-feedback-reports">✓ Orden sincronizado con Convocatoria</span>
                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.AdoptionExport))
                        {
                            <a asp-action="ExportEvaluationExcel" asp-route-id="@Model.ProcesoId" asp-route-section="capacidades"
                               class="btn btn-outline-success btn-sm fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                               title="Exportar matriz de capacidades por subsidiaria a formato Excel">
                                <span>📥 Exportar a Excel</span>
                            </a>
                        }
                        <span class="d-inline-flex align-items-center gap-1 small">
                            <span class="badge bg-success">A</span> <strong>Activo</strong>
                        </span>
                        <span class="d-inline-flex align-items-center gap-1 small">
                            <span class="badge bg-primary">F</span> <strong>Futuro</strong>
                        </span>
                        <span class="d-inline-flex align-items-center gap-1 small">
                            <span class="badge bg-secondary">NA</span> <strong>No aplica</strong>
                        </span>
                    </div>
                </div>
                @if (Model.CapacidadesMatrixReport.ColumnasCapacidades.Count == 0)
                {
                    <div class="alert alert-info d-flex align-items-start gap-3 m-4" role="alert">
                        <div>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-info-circle-fill text-info mt-1" viewBox="0 0 16 16">
                                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.399l-.254-.048.332-1.12h1.84zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                            </svg>
                        </div>
                        <div>
                            <h6 class="alert-heading fw-bold mb-1">No se han registrado capacidades técnicas para este Building Block</h6>
                            <p class="mb-1 small">
                                La matriz de cobertura de capacidades se generará automáticamente cuando se registren capacidades
                                en la Tabla Maestra del Building Block <strong>@Model.BuildingBlockNombre</strong>.
                            </p>
                            <p class="mb-0 small text-muted">
                                Navegue a <strong>Administración → Mapa del Catálogo → Tablas Maestras → Building Block</strong> para configurar las capacidades.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0 text-center" style="font-size:0.8rem;">
                        <thead class="table-light text-muted" style="font-size:0.75rem;">
                            <tr>
                                <th scope="col" class="text-start" style="min-width:160px; vertical-align:bottom; padding-bottom:8px;">Empresa</th>
                                <th scope="col" class="text-start" style="min-width:140px; vertical-align:bottom; padding-bottom:8px;">Tecnología AS-IS</th>
                                @foreach (var col in Model.CapacidadesMatrixReport.ColumnasCapacidades)
                                {
                                    <th scope="col" class="th-driver-vertical th-cap-vertical" title="@col">
                                        <div class="th-driver-vertical-cell">
                                            <div class="th-driver-vertical-container">
                                                <span class="th-driver-vertical-text">@col</span>
                                            </div>
                                        </div>
                                    </th>
                                }
                                <th scope="col" class="text-start" style="min-width:200px; vertical-align:bottom; padding-bottom:8px;">Comentario Subsidiaria</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyCapacidadesReport">
                        @foreach (var row in Model.CapacidadesMatrixReport.Filas)
                        {
                            <tr class="report-draggable-row" data-empresa-id="@row.EmpresaId">
                                <td class="text-start fw-bold text-dark text-nowrap">
                                    <span class="company-drag-handle text-secondary cursor-grab me-1" title="Arrastrar para ordenar" style="cursor: grab; user-select: none;">
                                        <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>
                                    </span>
                                    @row.EmpresaNombre
                                <td class="text-start small">
                                    @if (string.IsNullOrWhiteSpace(row.TecnologiaAsIs) || row.TecnologiaAsIs == "Sin tecnología registrada" || row.TecnologiaAsIs == "No configurada")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Sin tecnología registrada</span>
                                    }
                                    else
                                    {
                                        <span class="text-primary fw-medium">@row.TecnologiaAsIs</span>
                                    }
                                </td>
                                @foreach (var col in Model.CapacidadesMatrixReport.ColumnasCapacidades)
                                {
                                    var cell = row.Capacidades.TryGetValue(col, out var c) ? c : null;
                                    var code = cell?.EstadoCodigo ?? "NA";
                                    var capId = cell?.CapacidadId ?? 0;
                                    <td>
                                        <button type="button" 
                                                class="btn btn-sm p-0 border-0 report-cap-toggle-btn"
                                                data-empresa-id="@row.EmpresaId"
                                                data-capacidad-id="@capId"
                                                data-capacidad-name="@col"
                                                data-state="@code"
                                                title="Clic para cambiar: A -> F -> NA">
                                            @if (code == "A")
                                            {
                                                <span class="badge bg-success text-white px-2 py-1 shadow-sm">A</span>
                                            }
                                            else if (code == "F")
                                            {
                                                <span class="badge bg-primary text-white px-2 py-1 shadow-sm">F</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">NA</span>
                                            }
                                        </button>
                                    </td>
                                }
                                <td class="text-start small editable-report-comment-cell text-muted fst-italic"
                                    contenteditable="true"
                                    data-empresa-id="@row.EmpresaId"
                                    title="Haga clic para editar comentario de la subsidiaria">
                                    @(row.ComentarioSubsidiaria ?? "")
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                }
            </div>
        </div>

        <!-- PESTAÑA 5: PROYECCIÓN DE COSTOS AS-IS -->
        <div class="tab-pane fade" id="pane-costos" role="tabpanel" aria-labelledby="tab-costos">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div>
                        <h2 class="h5 mb-0">💰 Proyección de Costos AS-IS (Valorización Financiera)</h2>
                        <small class="text-muted">
                            Valorización financiera de la tecnología instalada en cada subsidiaria a partir de sus drivers operativos, cantidades y precios unitarios
                        </small>
                    </div>
                    @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.AdoptionExport))
                    {
                        <a asp-action="ExportEvaluationExcel" asp-route-id="@Model.ProcesoId" asp-route-section="costos"
                           class="btn btn-outline-success btn-sm fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                           title="Exportar proyección de costos AS-IS a formato Excel">
                            <span>📥 Exportar a Excel</span>
                        </a>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0" style="font-size:0.85rem;">
                        <thead class="table-light text-muted text-uppercase" style="font-size:0.75rem;">
                            <tr>
                                <th scope="col" style="min-width:180px;">Empresa</th>
                                <th scope="col" style="min-width:160px;">Tecnología AS-IS</th>
                                <th scope="col">Descripción del Driver</th>
                                <th scope="col">Unidad de Medida</th>
                                <th scope="col" class="text-end">Cantidad</th>
                                <th scope="col" class="text-end">Precio Unitario</th>
                                <th scope="col" class="text-center">Moneda</th>
                                <th scope="col" class="text-end">Costo Total Proyectado</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyCostosReport">
                        @if (Model.CostosAsIsReport != null && Model.CostosAsIsReport.Filas.Count > 0)
                        {
                            foreach (var drv in Model.CostosAsIsReport.Filas)
                            {
                                <tr data-empresa-id="@drv.EmpresaId">
                                    <td class="fw-bold text-dark">@drv.EmpresaNombre</td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(drv.TecnologiaAsIs) || drv.TecnologiaAsIs == "Sin tecnología registrada" || drv.TecnologiaAsIs == "No configurada")
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border">Sin tecnología registrada</span>
                                        }
                                        else
                                        {
                                            <span class="text-primary fw-semibold">@drv.TecnologiaAsIs</span>
                                        }
                                    </td>
                                    <td>
                                        @if (drv.DriverId > 0)
                                        {
                                            <span class="fw-semibold">@drv.DescripcionDriver</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">@drv.DescripcionDriver</span>
                                        }
                                    </td>
                                    <td>@(drv.DriverId > 0 ? drv.UnidadMedida : "—")</td>
                                    <td class="text-end fw-semibold">@(drv.DriverId > 0 ? drv.Cantidad.ToString("N2") : "—")</td>
                                    <td class="text-end">@(drv.DriverId > 0 ? drv.PrecioUnitario.ToString("N2") : "—")</td>
                                    <td class="text-center"><span class="badge bg-light text-secondary border">@drv.Moneda</span></td>
                                    <td class="text-end fw-bold @(drv.CostoTotal > 0 ? "text-success" : "text-muted")">
                                        @(drv.DriverId > 0 ? $"{drv.Moneda} {drv.CostoTotal:N2}" : "—")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No se registran empresas convocadas en este proceso.</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-dark fw-bold" style="font-size:0.85rem;">
                            <tr>
                                <td colspan="4" class="text-start text-uppercase">TOTALES CONSOLIDADOS:</td>
                                <td class="text-end">@(Model.CostosAsIsReport?.TotalItemsConCosto ?? 0) driver(s) con costo</td>
                                <td colspan="2" class="text-end text-uppercase">INVERSIÓN PROYECTADA TOTAL:</td>
                                <td class="text-end text-warning">USD @((Model.CostosAsIsReport?.TotalInversionGeneral ?? 0m).ToString("N2"))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tokenEl = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]') ||
                        document.querySelector('input[name="__RequestVerificationToken"]');
        const getVerificationToken = () => tokenEl ? tokenEl.value : '';
        const procesoId = '@Model.ProcesoId';

        // ==========================================
        // REPORTE 3: EDICIÓN EN LÍNEA DE VOLUMETRÍA
        // ==========================================
        const formatNumber = (num, decimals) => {
            const n = Number(num);
            if (isNaN(n)) return '0';
            if (n === 0 || n % 1 === 0) {
                return n.toLocaleString('en-US', { maximumFractionDigits: 0 });
            }
            const maxDec = (decimals !== undefined && decimals > 0) ? Math.max(decimals, 3) : 4;
            return n.toLocaleString('en-US', {
                minimumFractionDigits: 0,
                maximumFractionDigits: maxDec
            });
        };

        const parseCellNumber = (text) => {
            if (!text) return 0;
            const cleaned = text.replace(/,/g, '').trim();
            const val = parseFloat(cleaned);
            return isNaN(val) ? 0 : val;
        };

        const updateVolTotals = (driverKey, decimals) => {
            const cells = document.querySelectorAll(`.editable-vol-cell[data-driver-key="${driverKey}"]`);
            let sum = 0;
            cells.forEach(c => {
                sum += parseCellNumber(c.textContent);
            });
            const totEl = document.querySelector(`.tot-${driverKey}`);
            if (totEl) {
                totEl.textContent = formatNumber(sum, decimals);
            }

            // Actualizar total consolidado Antibot + WAF en el pie
            if (driverKey === 'antibot' || driverKey === 'waf') {
                const totAntibot = parseCellNumber(document.querySelector('.tot-antibot')?.textContent || '0');
                const totWaf = parseCellNumber(document.querySelector('.tot-waf')?.textContent || '0');
                const totCombined = document.querySelector('.tot-antibot-waf');
                if (totCombined) {
                    totCombined.textContent = formatNumber(totAntibot + totWaf, 3);
                }
            }
        };

        document.querySelectorAll('.editable-vol-cell').forEach(cell => {
            let originalText = '';

            cell.addEventListener('focus', function () {
                originalText = this.textContent.trim();
            });

            cell.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    this.blur();
                } else if (e.key === 'Escape') {
                    this.textContent = originalText;
                    this.blur();
                }
            });

            cell.addEventListener('blur', async function () {
                const newText = this.textContent.trim();
                if (newText === originalText) return;

                const val = parseCellNumber(newText);
                const decimals = parseInt(this.dataset.decimals || '3', 10);
                this.textContent = formatNumber(val, decimals);

                const row = this.closest('tr');
                const empresaId = row ? row.dataset.empresaId : null;
                const driverKey = this.dataset.driverKey;

                if (!empresaId || !driverKey) return;

                // Actualizar celda sumatoria fila (Antibot + WAF) si corresponde
                if (driverKey === 'antibot' || driverKey === 'waf') {
                    const rowAntibot = parseCellNumber(row.querySelector('.col-antibot')?.textContent || '0');
                    const rowWaf = parseCellNumber(row.querySelector('.col-waf')?.textContent || '0');
                    const combinedCell = row.querySelector('.col-antibot-waf');
                    if (combinedCell) {
                        combinedCell.textContent = formatNumber(rowAntibot + rowWaf, 3);
                    }
                }

                updateVolTotals(driverKey, decimals);

                try {
                    const res = await fetch(`@Url.Content("~/Administration/AdoptionProcess/")${procesoId}/empresa/${empresaId}/driver-volume`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getVerificationToken()
                        },
                        body: JSON.stringify({
                            driverKey: driverKey,
                            cantidad: val
                        })
                    });

                    if (res.ok) {
                        this.classList.add('cell-flash-success');
                        setTimeout(() => this.classList.remove('cell-flash-success'), 900);
                    } else {
                        this.classList.add('cell-flash-error');
                        setTimeout(() => this.classList.remove('cell-flash-error'), 1200);
                    }
                } catch (err) {
                    console.error('Error al guardar driver de volumetría:', err);
                    this.classList.add('cell-flash-error');
                    setTimeout(() => this.classList.remove('cell-flash-error'), 1200);
                }
            });
        });

        // Edición de celdas de matriz dinámica (no-WAAP)
        document.querySelectorAll('.editable-matrix-driver-cell').forEach(cell => {
            let origVal = '';
            cell.addEventListener('focus', function () {
                origVal = this.textContent.trim();
            });
            cell.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    this.blur();
                } else if (e.key === 'Escape') {
                    this.textContent = origVal;
                    this.blur();
                }
            });
            cell.addEventListener('blur', async function () {
                const newText = this.textContent.trim();
                if (newText === origVal) return;

                const val = parseCellNumber(newText);
                this.textContent = formatNumber(val, 3);

                const row = this.closest('tr');
                const empresaId = row ? row.dataset.empresaId : null;
                const driverKey = this.dataset.driverKey;

                if (!empresaId || !driverKey) return;

                try {
                    const res = await fetch(`@Url.Content("~/Administration/AdoptionProcess/")${procesoId}/empresa/${empresaId}/driver-volume`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getVerificationToken()
                        },
                        body: JSON.stringify({
                            driverKey: driverKey,
                            cantidad: val
                        })
                    });

                    if (res.ok) {
                        this.classList.add('cell-flash-success');
                        setTimeout(() => this.classList.remove('cell-flash-success'), 900);
                    }
                } catch (err) {
                    console.error('Error al actualizar driver:', err);
                }
            });
        });

        // ====================================================
        // REPORTE 4: INTERACTIVIDAD DE MATRIZ DE CAPACIDADES
        // ====================================================
        const badgeTemplates = {
            'A': '<span class="badge bg-success text-white px-2 py-1 shadow-sm">A</span>',
            'F': '<span class="badge bg-primary text-white px-2 py-1 shadow-sm">F</span>',
            'NA': '<span class="badge bg-secondary-subtle text-secondary border px-2 py-1">NA</span>'
        };

        const nextStateCycle = {
            'A': 'F',
            'F': 'NA',
            'NA': 'A'
        };

        document.querySelectorAll('.report-cap-toggle-btn').forEach(btn => {
            btn.addEventListener('click', async function () {
                const empresaId = this.dataset.empresaId;
                const capacidadId = parseInt(this.dataset.capacidadId, 10);
                const currentState = (this.dataset.state || 'NA').trim().toUpperCase();
                const nextState = nextStateCycle[currentState] || 'A';

                this.dataset.state = nextState;
                this.innerHTML = badgeTemplates[nextState] || badgeTemplates['NA'];

                try {
                    const res = await fetch(`@Url.Content("~/Administration/AdoptionProcess/")${procesoId}/empresa/${empresaId}/capability-state`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getVerificationToken()
                        },
                        body: JSON.stringify({
                            capacidadId: capacidadId,
                            estadoCodigo: nextState
                        })
                    });

                    if (!res.ok) {
                        // revert on failure
                        this.dataset.state = currentState;
                        this.innerHTML = badgeTemplates[currentState] || badgeTemplates['NA'];
                    }
                } catch (err) {
                    console.error('Error al cambiar estado de capacidad en reporte:', err);
                    this.dataset.state = currentState;
                    this.innerHTML = badgeTemplates[currentState] || badgeTemplates['NA'];
                }
            });
        });

        // Edición en línea del comentario de subsidiaria en el Reporte 4
        document.querySelectorAll('.editable-report-comment-cell').forEach(cell => {
            let origComment = '';
            cell.addEventListener('focus', function () {
                origComment = this.textContent.trim();
            });
            cell.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    this.blur();
                } else if (e.key === 'Escape') {
                    this.textContent = origComment;
                    this.blur();
                }
            });
            cell.addEventListener('blur', async function () {
                const newComment = this.textContent.trim();
                if (newComment === origComment) return;

                const empresaId = this.dataset.empresaId;
                if (!empresaId) return;

                try {
                    const res = await fetch(`@Url.Content("~/Administration/AdoptionProcess/")${procesoId}/empresa/${empresaId}/capability-comment`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getVerificationToken()
                        },
                        body: JSON.stringify({
                            comentario: newComment
                        })
                    });

                    if (res.ok) {
                        this.classList.add('cell-flash-success');
                        setTimeout(() => this.classList.remove('cell-flash-success'), 900);
                    }
                } catch (err) {
                    console.error('Error al guardar comentario de subsidiaria:', err);
                }
            });
        });
        // ====================================================
        // REPORTE 5: SELECCIÓN DINÁMICA DE DRIVERS Y TIMELINE
        // ====================================================
        const rawVencimientoDataEl = document.getElementById('vencimientoReportData');
        if (rawVencimientoDataEl) {
            let vData = null;
            try {
                vData = JSON.parse(rawVencimientoDataEl.textContent);
            } catch (e) {
                console.error('Error parsing vencimientoReportData:', e);
            }

            if (vData) {
                const chkDrivers = document.querySelectorAll('.chk-vencimiento-driver');
                const badgeCount = document.getElementById('badgeSelectedDriversCount');
                const statusBadge = document.getElementById('statusDriverSave');
                const thGroupDrivers = document.getElementById('thGroupDrivers');
                const trDriverHeaders = document.getElementById('trDriverHeaders');
                const tbodyVencimientos = document.getElementById('tbodyVencimientosReport');
                const tfootVencimientos = document.getElementById('tfootVencimientosReport');
                const tdSubAcumLabel = document.getElementById('tdSubsidiariasAcumuladasLabel');

                const escapeHtml = (str) => {
                    if (!str) return '';
                    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                };

                const formatDriverNumber = (val, zeroDisplay = '—') => {
                    if (val === null || val === undefined || isNaN(val) || val === '') return zeroDisplay;
                    const num = Number(val);
                    if (num === 0) return zeroDisplay;
                    if (num % 1 === 0) return num.toLocaleString('en-US', { maximumFractionDigits: 0 });
                    return num.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 4 });
                };

                const getSelectedDrivers = () => {
                    const sel = [];
                    document.querySelectorAll('.chk-vencimiento-driver:checked').forEach(c => {
                        sel.push(c.value);
                    });
                    return sel;
                };

                let saveTimer = null;
                const debouncedPersistDrivers = (drivers) => {
                    clearTimeout(saveTimer);
                    saveTimer = setTimeout(async () => {
                        try {
                            const res = await fetch(`@Url.Content("~/Administration/AdoptionProcess/")${vData.procesoId}/update-vencimientos-drivers`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': getVerificationToken()
                                },
                                body: JSON.stringify({ drivers: drivers })
                            });
                            if (res.ok) {
                                if (statusBadge) {
                                    statusBadge.style.display = 'inline-block';
                                    setTimeout(() => {
                                        statusBadge.style.display = 'none';
                                    }, 2500);
                                }
                            }
                        } catch (err) {
                            console.error('Error al persistir drivers en BD:', err);
                        }
                    }, 400);
                };

                const renderVencimientoTable = (selectedDrivers) => {
                    if (badgeCount) badgeCount.textContent = selectedDrivers.length;

                    if (thGroupDrivers) {
                        thGroupDrivers.colSpan = Math.max(1, selectedDrivers.length);
                    }

                    if (trDriverHeaders) {
                        trDriverHeaders.querySelectorAll('.th-driver-vertical').forEach(el => el.remove());
                        const firstMilestoneTh = trDriverHeaders.querySelector('.th-milestone');

                        selectedDrivers.forEach(d => {
                            const unit = vData.driverUnits[d] || '';
                            const th = document.createElement('th');
                            th.scope = 'col';
                            th.className = 'th-driver-vertical';
                            th.dataset.driverHeader = d;
                            th.title = unit ? `${d} (${unit})` : d;
                            th.innerHTML = `
                                <div class="th-driver-vertical-cell">
                                    <div class="th-driver-vertical-container">
                                        <span class="th-driver-vertical-text">${escapeHtml(d)}</span>
                                    </div>
                                    ${unit ? `<span class="th-driver-unit-badge" title="Unidad: ${escapeHtml(unit)}">${escapeHtml(unit)}</span>` : ''}
                                </div>`;
                            if (firstMilestoneTh) {
                                trDriverHeaders.insertBefore(th, firstMilestoneTh);
                            } else {
                                trDriverHeaders.appendChild(th);
                            }
                        });
                    }

                    if (tbodyVencimientos) {
                        tbodyVencimientos.querySelectorAll('tr').forEach(row => {
                            const empresaId = parseInt(row.dataset.empresaId, 10);
                            const compData = vData.companies.find(c => c.empresaId === empresaId);

                            row.querySelectorAll('.td-driver-val').forEach(el => el.remove());
                            const firstMilestoneTd = row.querySelector('.td-milestone');

                            selectedDrivers.forEach(d => {
                                const val = (compData && compData.drivers && compData.drivers[d] !== undefined) ? compData.drivers[d] : 0;
                                const td = document.createElement('td');
                                td.className = 'text-end fw-semibold small td-driver-val';
                                td.dataset.driverKey = d;
                                td.textContent = formatDriverNumber(val);

                                if (firstMilestoneTd) {
                                    row.insertBefore(td, firstMilestoneTd);
                                } else {
                                    row.appendChild(td);
                                }
                            });
                        });
                    }

                    if (tfootVencimientos) {
                        const trTotalMonto = document.getElementById('trTotalMontoContrato');
                        if (trTotalMonto) {
                            trTotalMonto.querySelectorAll('.td-driver-monto-placeholder').forEach(el => el.remove());
                            const firstMontoMilestone = trTotalMonto.querySelector('[data-monto-accum]');
                            selectedDrivers.forEach(d => {
                                const td = document.createElement('td');
                                td.className = 'text-center text-muted td-driver-monto-placeholder';
                                td.dataset.driverPlaceholder = d;
                                td.textContent = '—';
                                if (firstMontoMilestone) {
                                    trTotalMonto.insertBefore(td, firstMontoMilestone);
                                } else {
                                    trTotalMonto.appendChild(td);
                                }
                            });
                        }

                        tfootVencimientos.querySelectorAll('tr[data-footer-driver]').forEach(el => el.remove());
                        const trSubAcum = document.getElementById('trSubsidiariasAcumuladas');

                        selectedDrivers.forEach(d => {
                            const unit = vData.driverUnits[d] || '';
                            const totalVal = vData.companies.reduce((sum, c) => sum + (c.drivers[d] || 0), 0);

                            const driverColsHtml = selectedDrivers.map(otherD => {
                                if (otherD === d) {
                                    return `<td class="text-end fw-bold bg-secondary bg-opacity-25" data-driver-total="${escapeHtml(d)}">${formatDriverNumber(totalVal)}</td>`;
                                }
                                return `<td class="text-center text-muted" data-driver-placeholder="${escapeHtml(otherD)}">—</td>`;
                            }).join('');

                            let runSum = 0;
                            const milestoneCellsHtml = vData.milestones.map(m => {
                                const sumInHito = vData.companies
                                    .filter(c => c.assignedHito === m)
                                    .reduce((sum, c) => sum + (c.drivers[d] || 0), 0);
                                runSum += sumInHito;
                                return `<td class="text-center fw-bold bg-dark border-start" data-hito-accum="${escapeHtml(m)}">${formatDriverNumber(runSum, '0')}</td>`;
                            }).join('');

                            const tr = document.createElement('tr');
                            tr.dataset.footerDriver = d;
                            tr.innerHTML = `
                                <td colspan="3" class="text-end fw-bold text-uppercase text-nowrap" style="letter-spacing:0.5px;">
                                    ${escapeHtml(d)} ${unit ? `(${escapeHtml(unit)})` : ''} ACUM:
                                </td>
                                <td class="text-center text-muted td-monto-col" data-monto-placeholder="true">—</td>
                                ${driverColsHtml}
                                ${milestoneCellsHtml}
                            `;

                            if (trSubAcum) {
                                tfootVencimientos.insertBefore(tr, trSubAcum);
                            } else {
                                tfootVencimientos.appendChild(tr);
                            }
                        });

                        if (trSubAcum) {
                            trSubAcum.querySelectorAll('.td-driver-sub-placeholder').forEach(el => el.remove());
                            const firstSubMilestone = trSubAcum.querySelector('[data-sub-accum]');
                            selectedDrivers.forEach(d => {
                                const td = document.createElement('td');
                                td.className = 'text-center text-muted td-driver-sub-placeholder';
                                td.dataset.driverPlaceholder = d;
                                td.textContent = '—';
                                if (firstSubMilestone) {
                                    trSubAcum.insertBefore(td, firstSubMilestone);
                                } else {
                                    trSubAcum.appendChild(td);
                                }
                            });
                        }
                    }
                };

                chkDrivers.forEach(chk => {
                    chk.addEventListener('change', function () {
                        let sel = getSelectedDrivers();
                        if (sel.length === 0) {
                            this.checked = true;
                            sel = [this.value];
                        }
                        renderVencimientoTable(sel);
                        debouncedPersistDrivers(sel);
                    });
                });

                const btnDefault = document.getElementById('btnDriversDefault');
                if (btnDefault) {
                    btnDefault.addEventListener('click', () => {
                        const defaults = vData.defaultDrivers || [];
                        chkDrivers.forEach(chk => {
                            chk.checked = defaults.some(def => def.toLowerCase() === chk.value.toLowerCase());
                        });
                        let sel = getSelectedDrivers();
                        if (sel.length === 0 && chkDrivers.length > 0) {
                            chkDrivers[0].checked = true;
                            sel = [chkDrivers[0].value];
                        }
                        renderVencimientoTable(sel);
                        debouncedPersistDrivers(sel);
                    });
                }

                const btnAll = document.getElementById('btnDriversAll');
                if (btnAll) {
                    btnAll.addEventListener('click', () => {
                        chkDrivers.forEach(chk => { chk.checked = true; });
                        const sel = getSelectedDrivers();
                        renderVencimientoTable(sel);
                        debouncedPersistDrivers(sel);
                    });
                }

                const btnClear = document.getElementById('btnDriversClear');
                if (btnClear) {
                    btnClear.addEventListener('click', () => {
                        chkDrivers.forEach((chk, idx) => {
                            chk.checked = (idx === 0);
                        });
                        const sel = getSelectedDrivers();
                        renderVencimientoTable(sel);
                        debouncedPersistDrivers(sel);
                    });
                }
            }
        }

        // ====================================================
        // VISIBILIDAD DE COLUMNA MONTO CONTRATO (CON PERSISTENCIA)
        // ====================================================
        const tableVenc = document.getElementById('tableVencimientosProyeccion');
        const btnToggleMonto = document.getElementById('btnToggleMontoContrato');
        const badgeMonto = document.getElementById('badgeMontoVisibility');

        const setMontoVisibility = (visible) => {
            if (!tableVenc || !badgeMonto) return;
            if (visible) {
                tableVenc.classList.remove('hide-monto-col');
                badgeMonto.className = 'badge bg-success text-white';
                badgeMonto.textContent = 'Visible';
            } else {
                tableVenc.classList.add('hide-monto-col');
                badgeMonto.className = 'badge bg-secondary text-white';
                badgeMonto.textContent = 'Oculto';
            }
        };

        if (btnToggleMonto) {
            const savedVisibility = localStorage.getItem('vencimiento_monto_visible');
            if (savedVisibility === 'false') {
                setMontoVisibility(false);
            } else {
                setMontoVisibility(true);
            }

            btnToggleMonto.addEventListener('click', () => {
                const isCurrentlyHidden = tableVenc && tableVenc.classList.contains('hide-monto-col');
                const makeVisible = isCurrentlyHidden;
                setMontoVisibility(makeVisible);
                localStorage.setItem('vencimiento_monto_visible', makeVisible ? 'true' : 'false');
            });
        }

        // ====================================================
        // SINCRONIZACIÓN Y REORDENAMIENTO DE EMPRESAS (DRAG & DROP BIDIRECCIONAL)
        // ====================================================
        const reportTbodySelectors = [
            '#tbodyAlcanceReport',
            '#tbodyVolumetriaWaapReport',
            '#tbodyVolumetriaGenericReport',
            '#tbodyCapacidadesReport'
        ];

        const syncAllTablesOrder = (newOrder) => {
            if (!Array.isArray(newOrder) || newOrder.length === 0) return;

            // 1. Sincronizar tablas con filas directas (Alcance, Volumetría, Capacidades)
            reportTbodySelectors.forEach(sel => {
                const tb = document.querySelector(sel);
                if (!tb) return;
                const rowsMap = new Map();
                Array.from(tb.querySelectorAll('tr[data-empresa-id]')).forEach(r => rowsMap.set(r.dataset.empresaId, r));
                newOrder.forEach(id => {
                    const r = rowsMap.get(id.toString());
                    if (r) tb.appendChild(r);
                });
            });

            // 2. Actualizar numeración secuencial de Alcance
            const alcanceBadges = document.querySelectorAll('#tbodyAlcanceReport .row-seq-badge');
            alcanceBadges.forEach((badge, idx) => {
                badge.textContent = idx + 1;
            });

            // 3. Sincronizar tabla de Costos AS-IS (múltiples filas por empresa agrupadas)
            const tbodyCostos = document.getElementById('tbodyCostosReport');
            if (tbodyCostos) {
                const rows = Array.from(tbodyCostos.querySelectorAll('tr[data-empresa-id]'));
                const grouped = new Map();
                rows.forEach(r => {
                    const empId = r.dataset.empresaId;
                    if (!grouped.has(empId)) grouped.set(empId, []);
                    grouped.get(empId).push(r);
                });
                newOrder.forEach(id => {
                    const list = grouped.get(id.toString());
                    if (list) {
                        list.forEach(r => tbodyCostos.appendChild(r));
                    }
                });
            }

            // 4. Sincronizar tabla de Vencimientos: desempatar dentro del mismo hito temporal
            const tbodyVenc = document.getElementById('tbodyVencimientosReport');
            if (tbodyVenc) {
                const rows = Array.from(tbodyVenc.querySelectorAll('tr[data-empresa-id]'));
                const orderIndexMap = new Map(newOrder.map((id, idx) => [id.toString(), idx]));

                const byHito = new Map();
                const hitoOrder = [];
                rows.forEach(r => {
                    const hito = r.dataset.assignedHito || 'PAYG';
                    if (!byHito.has(hito)) {
                        byHito.set(hito, []);
                        hitoOrder.push(hito);
                    }
                    byHito.get(hito).push(r);
                });

                byHito.forEach(groupRows => {
                    groupRows.sort((a, b) => {
                        const idxA = orderIndexMap.has(a.dataset.empresaId) ? orderIndexMap.get(a.dataset.empresaId) : 999999;
                        const idxB = orderIndexMap.has(b.dataset.empresaId) ? orderIndexMap.get(b.dataset.empresaId) : 999999;
                        return idxA - idxB;
                    });
                });

                let seq = 1;
                hitoOrder.forEach(hito => {
                    const group = byHito.get(hito) || [];
                    group.forEach(r => {
                        const seqCell = r.querySelector('.td-venc-seq');
                        if (seqCell) seqCell.textContent = seq++;
                        tbodyVenc.appendChild(r);
                    });
                });
            }
        };

        let persistOrderTimer = null;
        const persistCompanyOrder = (order) => {
            clearTimeout(persistOrderTimer);
            persistOrderTimer = setTimeout(async () => {
                try {
                    const token = getVerificationToken();
                    const res = await fetch(`@Url.Content("~/Administration/AdoptionProcess/")${procesoId}/update-company-order`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ orderedCompanyIds: order })
                    });
                    if (res.ok) {
                        document.querySelectorAll('.order-saved-feedback-reports').forEach(el => {
                            el.textContent = '✓ Orden sincronizado con Convocatoria';
                            el.classList.remove('d-none');
                            setTimeout(() => el.classList.add('d-none'), 3000);
                        });
                        const btnReset = document.getElementById('btnResetCompanyOrderReports');
                        if (btnReset) btnReset.classList.remove('d-none');

                        try {
                            localStorage.setItem(`adoption_process_${procesoId}_order`, JSON.stringify(order));
                        } catch (e) {}
                    }
                } catch (err) {
                    console.error('Error al persistir orden de empresas desde reportería:', err);
                }
            }, 300);
        };

        const initTableDragAndDrop = (tbodyEl) => {
            if (!tbodyEl) return;

            let draggedRow = null;

            const bindRow = (row) => {
                const handle = row.querySelector('.company-drag-handle');
                if (handle) {
                    handle.addEventListener('mouseenter', () => {
                        row.setAttribute('draggable', 'true');
                    });
                    handle.addEventListener('mouseleave', () => {
                        if (!row.classList.contains('dragging')) {
                            row.setAttribute('draggable', 'false');
                        }
                    });
                }

                row.addEventListener('dragstart', (e) => {
                    draggedRow = row;
                    row.classList.add('dragging');
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', row.dataset.empresaId || '');
                });

                row.addEventListener('dragend', () => {
                    if (draggedRow) {
                        draggedRow.classList.remove('dragging');
                        draggedRow.setAttribute('draggable', 'false');
                        draggedRow = null;
                    }
                    tbodyEl.querySelectorAll('.report-draggable-row').forEach(r => {
                        r.classList.remove('drag-over-top', 'drag-over-bottom');
                    });
                });

                row.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    if (!draggedRow || draggedRow === row) return;
                    e.dataTransfer.dropEffect = 'move';

                    const rect = row.getBoundingClientRect();
                    const offset = e.clientY - rect.top;
                    if (offset < rect.height / 2) {
                        row.classList.add('drag-over-top');
                        row.classList.remove('drag-over-bottom');
                    } else {
                        row.classList.add('drag-over-bottom');
                        row.classList.remove('drag-over-top');
                    }
                });

                row.addEventListener('dragleave', () => {
                    row.classList.remove('drag-over-top', 'drag-over-bottom');
                });

                row.addEventListener('drop', (e) => {
                    e.preventDefault();
                    row.classList.remove('drag-over-top', 'drag-over-bottom');
                    if (!draggedRow || draggedRow === row) return;

                    const rect = row.getBoundingClientRect();
                    const offset = e.clientY - rect.top;
                    if (offset < rect.height / 2) {
                        tbodyEl.insertBefore(draggedRow, row);
                    } else {
                        tbodyEl.insertBefore(draggedRow, row.nextSibling);
                    }

                    const newOrder = Array.from(tbodyEl.querySelectorAll('.report-draggable-row'))
                        .map(r => parseInt(r.dataset.empresaId, 10))
                        .filter(id => !isNaN(id) && id > 0);

                    syncAllTablesOrder(newOrder);
                    persistCompanyOrder(newOrder);
                });
            };

            tbodyEl.querySelectorAll('.report-draggable-row').forEach(bindRow);
        };

        reportTbodySelectors.forEach(sel => {
            const tb = document.querySelector(sel);
            if (tb) initTableDragAndDrop(tb);
        });

        // Botón Restablecer Orden Alfabético desde Reportería
        const btnResetCompanyOrder = document.getElementById('btnResetCompanyOrderReports');
        if (btnResetCompanyOrder) {
            btnResetCompanyOrder.addEventListener('click', async () => {
                const tbodyAlcance = document.getElementById('tbodyAlcanceReport');
                if (!tbodyAlcance) return;

                const rows = Array.from(tbodyAlcance.querySelectorAll('.report-draggable-row'));
                rows.sort((a, b) => {
                    const nameA = a.querySelector('.text-dark')?.textContent.trim() || '';
                    const nameB = b.querySelector('.text-dark')?.textContent.trim() || '';
                    return nameA.localeCompare(nameB, 'es', { sensitivity: 'base' });
                });

                const alphaOrder = rows.map(r => parseInt(r.dataset.empresaId, 10)).filter(id => !isNaN(id) && id > 0);
                syncAllTablesOrder(alphaOrder);

                try {
                    const token = getVerificationToken();
                    await fetch(`@Url.Content("~/Administration/AdoptionProcess/")${procesoId}/update-company-order`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ orderedCompanyIds: alphaOrder })
                    });
                    btnResetCompanyOrder.classList.add('d-none');
                    document.querySelectorAll('.order-saved-feedback-reports').forEach(el => {
                        el.textContent = '✓ Orden alfabético restablecido';
                        el.classList.remove('d-none');
                        setTimeout(() => el.classList.add('d-none'), 3000);
                    });
                } catch (e) {
                    console.error('Error al restablecer orden:', e);
                }
            });
        }
    });
</script>

<style>
    /* Drag & Drop de Empresas en Reportes */
    .report-draggable-row.dragging {
        opacity: 0.45;
        background-color: #f0f7ff !important;
    }
    .report-draggable-row.drag-over-top td {
        border-top: 3px solid #0d6efd !important;
    }
    .report-draggable-row.drag-over-bottom td {
        border-bottom: 3px solid #0d6efd !important;
    }
    .company-drag-handle {
        cursor: grab;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 2px;
        border-radius: 4px;
        vertical-align: middle;
        color: #6c757d;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .company-drag-handle:hover {
        background-color: rgba(13, 110, 253, 0.15);
        color: #0d6efd;
    }
    .company-drag-handle:active {
        cursor: grabbing;
    }

    /* Ocultar columna Monto Contrato en reporte de vencimientos */
    #tableVencimientosProyeccion.hide-monto-col .th-monto-col,
    #tableVencimientosProyeccion.hide-monto-col .td-monto-col {
        display: none !important;
    }

    .editable-vol-cell, .editable-matrix-driver-cell, .editable-report-comment-cell {
        cursor: cell;
        transition: background-color 0.2s ease, outline 0.15s ease;
    }
    .editable-vol-cell:hover, .editable-matrix-driver-cell:hover, .editable-report-comment-cell:hover {
        background-color: rgba(13, 110, 253, 0.08) !important;
        outline: 1px dashed #0d6efd;
    }
    .editable-vol-cell:focus, .editable-matrix-driver-cell:focus, .editable-report-comment-cell:focus {
        background-color: #fff9db !important;
        outline: 2px solid #fd7e14 !important;
        color: #000 !important;
    }
    .cell-flash-success {
        background-color: #d1e7dd !important;
        color: #0f5132 !important;
        transition: background-color 0.4s ease;
    }
    .cell-flash-error {
        background-color: #f8d7da !important;
        color: #842029 !important;
        transition: background-color 0.4s ease;
    }
    .report-cap-toggle-btn {
        background: transparent;
        cursor: pointer;
        transition: transform 0.15s ease;
    }
    .report-cap-toggle-btn:hover {
        transform: scale(1.25);
    }

    /* ==================================================== */
    /* ENCABEZADOS VERTICALES A 90 GRADOS (DRIVERS & CAPACIDADES) */
    /* ==================================================== */
    .th-driver-vertical {
        vertical-align: bottom !important;
        text-align: center;
        width: 52px;
        min-width: 48px;
        max-width: 62px;
        height: 165px;
        padding: 6px 2px 4px 2px !important;
        background-color: #f8fafc;
        border-bottom: 2px solid #cbd5e1 !important;
    }
    .th-cap-vertical {
        width: 54px;
        min-width: 50px;
        max-width: 68px;
    }
    .th-cap-vertical .th-driver-vertical-container {
        max-height: 145px;
    }
    .th-driver-vertical-cell {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        height: 155px;
        margin: 0 auto;
        gap: 3px;
    }
    .th-driver-vertical-container {
        display: inline-block;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        max-height: 118px;
        line-height: 1.15;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 0 auto;
    }
    .th-driver-vertical-text {
        font-weight: 700;
        font-size: 0.72rem;
        color: #1e293b;
        letter-spacing: 0.2px;
        display: inline-block;
    }
    .th-driver-unit-badge {
        display: inline-block;
        font-size: 0.62rem;
        color: #475569;
        font-weight: 600;
        background-color: #e2e8f0;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        padding: 1px 3px;
        max-width: 48px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.1;
    }
    .td-driver-val {
        font-size: 0.8rem;
        font-variant-numeric: tabular-nums;
    }
    #dropdownVencimientoDrivers .dropdown-menu {
        z-index: 1050;
    }
</style>
}

