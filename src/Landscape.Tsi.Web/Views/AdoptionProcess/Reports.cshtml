                                    <td class="text-end tot-antibot">@FormatSmart(Model.VolumetriaReport.TotalMillonesRequestAntibot)</td>
                                    <td class="text-end tot-waf">@FormatSmart(Model.VolumetriaReport.TotalMillonesRequestWaf)</td>
                                    <td class="text-end text-info tot-antibot-waf">@FormatSmart(Model.VolumetriaReport.TotalMillonesRequestAntibotWaf)</td>
                                    <td class="text-end tot-data_transfer">@FormatSmart(Model.VolumetriaReport.TotalDataTransferTbMensual)</td>
                                    <td>-</td>
                                    <td>-</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    var matriz = Model.VolumetriaReport.MatrizDrivers;
