                <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div>
                        <h2 class="h5 mb-0">💰 Proyección de Costos AS-IS (Valorización Financiera)</h2>
                        <small class="text-muted">
                            Valorización financiera de la tecnología instalada en cada subsidiaria a partir de sus drivers operativos, cantidades y precios unitarios
                        </small>
                    </div>
                    @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.AdoptionExport))
