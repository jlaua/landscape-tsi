                                    <td class="text-start fw-bold text-dark text-nowrap">
                                        <span class="company-drag-handle text-secondary cursor-grab me-1" title="Arrastrar para ordenar" style="cursor: grab; user-select: none;">
                                            <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>
                                        </span>
                                        @row.EmpresaNombre
                                    </td>
                                    <td class="text-start text-primary">@(row.TecnologiaAsIs ?? "WAF Local")</td>
                                     <td class="text-end fw-semibold editable-vol-cell" contenteditable="true" data-driver-key="throughput" data-decimals="3" title="Haga clic para editar Throughput (mensual)">@FormatSmart(row.ThroughputMensualGbps)</td>
                                     <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="ancho_banda" data-decimals="3" title="Haga clic para editar Ancho de Banda (mensual)">@FormatSmart(row.AnchoBandaMensualGbps)</td>
                                     <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="dominio" data-decimals="0" title="Haga clic para editar Dominio">@row.Dominio</td>
                                     <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="subdominios" data-decimals="0" title="Haga clic para editar Sub Dominios">@row.SubDominios</td>
                                     <td class="text-end fw-bold editable-vol-cell" contenteditable="true" data-driver-key="apps_fqdn" data-decimals="0" title="Haga clic para editar Cantidad de aplicaciones (FQDN)">@row.CantidadAppsFqdn</td>
                                     <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="apps_api_sec" data-decimals="0" title="Haga clic para editar Cantidad de Aplicaciones FQDN en API Security">@row.CantidadAppsFqdnApiSecurity</td>
                                     <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="api_prot" data-decimals="3" title="Haga clic para editar API Protection / API Security Request">@FormatSmart(row.ApiProtectionRequestMillonesMes)</td>
                                     <td class="text-end editable-vol-cell col-antibot" contenteditable="true" data-driver-key="antibot" data-decimals="3" title="Haga clic para editar Millones de Request (mensual / antibot)">@FormatSmart(row.MillonesRequestAntibot)</td>
                                     <td class="text-end fw-semibold editable-vol-cell col-waf" contenteditable="true" data-driver-key="waf" data-decimals="3" title="Haga clic para editar Millones Request WAF (mensual)">@FormatSmart(row.MillonesRequestWaf)</td>
                                     <td class="text-end fw-bold text-primary col-antibot-waf">@FormatSmart(row.MillonesRequestAntibotWaf)</td>
                                     <td class="text-end fw-bold editable-vol-cell" contenteditable="true" data-driver-key="data_transfer" data-decimals="3" title="Haga clic para editar Data Transfer (mensual)">@FormatSmart(row.DataTransferTbMensual)</td>
                                     <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="request_size" data-decimals="0" title="Haga clic para editar Request Size (mensual)">@(row.RequestSize ?? "—")</td>
