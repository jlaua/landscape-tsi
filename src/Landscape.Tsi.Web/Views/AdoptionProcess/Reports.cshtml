                        <a asp-action="ExportEvaluationExcel" asp-route-id="@Model.ProcesoId" asp-route-section="costos"
                           class="btn btn-outline-success btn-sm fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                           title="Exportar proyección de costos AS-IS a formato Excel">
                            <span>📥 Exportar a Excel</span>
                        </a>
