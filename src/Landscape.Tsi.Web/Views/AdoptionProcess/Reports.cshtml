                                            <div class="th-driver-vertical-container">
                                                <span class="th-driver-vertical-text">Ancho Banda</span>
                                            </div>
                                            <span class="th-driver-unit-badge" title="Unidad: Gbps/mes">Gbps/mes</span>
                                        </div>
                                    </th>
