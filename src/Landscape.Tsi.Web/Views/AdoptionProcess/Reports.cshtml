                                                @FormatSmart(cant)
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                @foreach (var alc in Model.AlcanceReport)
                                {
                                    <tr class="report-draggable-row" data-empresa-id="@alc.EmpresaId">
                                        <td class="fw-bold text-dark text-nowrap">
                                            <span class="company-drag-handle text-secondary cursor-grab me-1" title="Arrastrar para ordenar" style="cursor: grab; user-select: none;">
                                                <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>
