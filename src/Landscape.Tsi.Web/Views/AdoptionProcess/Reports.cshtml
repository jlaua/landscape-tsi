                                            </div>
                                            <span class="th-driver-unit-badge" title="Unidad: KB/GB">KB/GB</span>
                                        </div>
                                    </th>
                                    <th scope="col" class="th-driver-vertical" title="Response Size (mensual)">
                                        <div class="th-driver-vertical-cell">
                                            <div class="th-driver-vertical-container">
                                                <span class="th-driver-vertical-text">Response Size</span>
                                            </div>
                                            <span class="th-driver-unit-badge" title="Unidad: KB/GB/TB">KB/TB</span>
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="tbodyVolumetriaWaapReport">
                            @foreach (var row in Model.VolumetriaReport.Filas)
