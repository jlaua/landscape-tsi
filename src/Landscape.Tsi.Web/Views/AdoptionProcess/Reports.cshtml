                                <div class="flex-grow-1">
                                    <strong>No se han registrado drivers operativos para @Model.BuildingBlockNombre.</strong>
                                    <div class="small text-muted">Puede agregar drivers específicos de dimensionamiento y consumo (ej. datastores, repositorios, TB escaneados, licencias) desde el detalle del proceso de evaluación en la sección de Convocatoria.</div>
                                </div>
                                <a asp-action="Details" asp-route-id="@Model.ProcesoId" class="btn btn-sm btn-outline-primary text-nowrap">Configurar Drivers en el Proceso →</a>
                            </div>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-striped align-middle mb-0" style="font-size:0.85rem;">
                            <thead class="table-light text-muted text-uppercase" style="font-size:0.75rem;">
                                <tr>
                                    <th scope="col" style="min-width:180px; vertical-align:bottom; padding-bottom:8px;">Empresa</th>
                                    <th scope="col" style="min-width:160px; vertical-align:bottom; padding-bottom:8px;">Tecnología AS-IS</th>
                                    @if (tieneColumnas)
                                    {
                                        @foreach (var col in matriz!.ColumnasDrivers)
                                        {
                                            var lastSlash = col.LastIndexOf(" / ");
