@model Landscape.Tsi.Application.Adoption.EvaluationReportsDto
@using Landscape.Tsi.Application.Identity
@{
    ViewData["Title"] = $"Seguimiento y Reportería - {Model.NombreProceso}";
}

<nav aria-label="Ruta de navegación">
    <ol class="breadcrumb-list">
        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li><a asp-action="Evaluations">Evaluaciones TSI</a></li>
        <li><a asp-action="Details" asp-route-id="@Model.ProcesoId">@Model.CodigoProceso</a></li>
        <li aria-current="page">Reportería & Seguimiento</li>
    </ol>
</nav>

<section class="admin-shell" aria-labelledby="reports-page-title">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">@Model.DominioNombre</span>
                <span class="badge bg-secondary-subtle text-secondary border">BB: @Model.BuildingBlockNombre</span>
                <span class="badge bg-info text-dark">@Model.EstadoAdopcionNombre</span>
            </div>
            <h1 id="reports-page-title" class="h2 mb-1">📊 Seguimiento y Reportería Operacional</h1>
            <p class="supporting-text mb-0">
                Evaluación: <strong>@Model.NombreProceso</strong> (<code class="fw-bold">@Model.CodigoProceso</code>) · Líder: @(Model.LiderCorporativo ?? "No asignado") · Vigencia: @Model.FechaInicio.ToString("dd/MM/yyyy") @(Model.FechaEstimadaCierre.HasValue ? $"al {Model.FechaEstimadaCierre.Value:dd/MM/yyyy}" : "")
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.AdoptionExport))
            {
                <a asp-action="ExportEvaluationExcel" asp-route-id="@Model.ProcesoId" asp-route-section="all"
                   class="btn btn-success btn-sm fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                   title="Exportar libro Excel completo con las 4 pestañas de reportería y seguimiento">
                    <span>📥 Exportar Todo a Excel</span>
                </a>
            }
            <button type="button" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" onclick="window.print()">
                <span>🖨️ Imprimir / Guardar PDF</span>
            </button>
            <a asp-action="Details" asp-route-id="@Model.ProcesoId" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <span>← Volver al Proceso</span>
            </a>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div class="kpi-grid mb-4" aria-label="Resumen Ejecutivo de la Evaluación">
        <div class="kpi-card">
            <span>Subsidiarias Participantes</span>
            <strong>@Model.AlcanceReport.Count</strong>
        </div>
        @if (Model.EsWaap)
        {
            <div class="kpi-card">
                <span>Throughput Global Proyectado</span>
                <strong>@Model.VencimientoContratosReport.TotalThroughputGbMes.ToString("N1") GB/m</strong>
            </div>
            <div class="kpi-card">
                <span>Total Apps FQDN Protegidas</span>
                <strong>@Model.VencimientoContratosReport.TotalAppsFqdn</strong>
            </div>
            <div class="kpi-card">
                <span>Tráfico WAF Corporativo</span>
                <strong>@Model.VencimientoContratosReport.TotalRequestWafMillonesMes.ToString("N1") M req/m</strong>
            </div>
        }
        else
        {
            <div class="kpi-card">
                <span>Building Block Evaluado</span>
                <strong class="text-truncate" title="@Model.BuildingBlockNombre">@Model.BuildingBlockNombre</strong>
            </div>
            <div class="kpi-card">
                <span>Drivers de Consumo</span>
                <strong>@Model.VolumetriaReport.TotalCantidadDrivers Registrados</strong>
            </div>
            <div class="kpi-card">
                <span>Inversión Total Drivers</span>
                <strong>USD @Model.VolumetriaReport.TotalInversionDrivers.ToString("N2")</strong>
            </div>
        }
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4" id="reportTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold" id="tab-alcance" data-bs-toggle="tab" data-bs-target="#pane-alcance" type="button" role="tab" aria-controls="pane-alcance" aria-selected="true">
                📋 a) Alcance del Proceso
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="tab-vencimientos" data-bs-toggle="tab" data-bs-target="#pane-vencimientos" type="button" role="tab" aria-controls="pane-vencimientos" aria-selected="false">
                ⏱️ b) Vencimiento de Contratos & Proyección
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="tab-volumetria" data-bs-toggle="tab" data-bs-target="#pane-volumetria" type="button" role="tab" aria-controls="pane-volumetria" aria-selected="false">
                📈 3) Volumetría por Empresa
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="tab-capacidades" data-bs-toggle="tab" data-bs-target="#pane-capacidades" type="button" role="tab" aria-controls="pane-capacidades" aria-selected="false">
                🛡️ 4) Capacidades por Empresa
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="tab-costos" data-bs-toggle="tab" data-bs-target="#pane-costos" type="button" role="tab" aria-controls="pane-costos" aria-selected="false">
                💰 5) Proyección de Costos AS-IS
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="reportTabsContent">
        
        <!-- PESTAÑA A: ALCANCE DEL PROCESO -->
        <div class="tab-pane fade show active" id="pane-alcance" role="tabpanel" aria-labelledby="tab-alcance">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div>
                        <h2 class="h5 mb-0">Alcance del Proceso de Evaluación</h2>
                        <small class="text-muted">Resumen consolidado de empresas participantes, tecnología AS-IS, contratos, partners y modo de operación</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.AdoptionExport))
                        {
                            <a asp-action="ExportEvaluationExcel" asp-route-id="@Model.ProcesoId" asp-route-section="as-is"
                               class="btn btn-outline-success btn-sm fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                               title="Exportar esta tabla a formato Excel">
                                <span>📥 Exportar a Excel</span>
                            </a>
                        }
                        <span class="badge bg-primary fs-6">@Model.AlcanceReport.Count Empresas</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted text-uppercase" style="font-size:0.75rem; letter-spacing:0.5px;">
                            <tr>
                                <th scope="col">Empresa</th>
                                <th scope="col">País</th>
                                <th scope="col">Fecha Vencimiento</th>
                                <th scope="col">@(Model.EsWaap ? "WAF AS-IS" : "Tecnología AS-IS")</th>
                                <th scope="col">Tipo Contrato</th>
                                <th scope="col">Fabricante / Vendor</th>
                                <th scope="col">Partner / Integrador</th>
                                <th scope="col">Operación</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.AlcanceReport)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@row.EmpresaNombre</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">@(row.Pais ?? "Global")</span>
                                </td>
                                <td>
                                    @if (row.TipoContrato == "PAYG" || !row.FechaVencimientoContrato.HasValue)
                                    {
                                        <span class="badge bg-info-subtle text-dark border border-info">PAYG</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning">@row.FechaVencimientoContrato.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold text-primary">@row.TecnologiaAsIs</span>
                                </td>
                                <td>
                                    <span class="badge @(row.TipoContrato == "PAYG" ? "bg-info-subtle text-dark border border-info" : "bg-light text-secondary border")">
                                        @(row.TipoContrato ?? "Contrato")
                                    </span>
                                </td>
                                <td>
                                    <span class="small fw-semibold text-dark">@(row.Vendor ?? "-")</span>
                                </td>
                                <td>
                                    <span class="small">@(row.Partner ?? "Directo")</span>
                                </td>
                                <td>
                                    <span class="badge @(row.TipoOperacion == "Autogestionado" ? "bg-success-subtle text-success border border-success" : "bg-primary-subtle text-primary border border-primary")">
                                        @(row.TipoOperacion ?? "Autogestionado")
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- PESTAÑA B: VENCIMIENTO DE CONTRATOS & PROYECCIÓN ACUMULADA -->
        @{
            var activeDrivers = Model.VencimientoContratosReport.DriversSeleccionados?.ToList() ??
                (Model.EsWaap ? new List<string> { "Throughput (mensual)", "Cantidad de aplicaciones (FQDN)", "Millones Request WAF (mensual)" } : new List<string>());
            var availableDrivers = Model.VencimientoContratosReport.TodosLosDriversDisponibles?.ToList() ?? activeDrivers;
            var driverUnits = Model.VencimientoContratosReport.UnidadesPorDriver ?? new Dictionary<string, string>();
        }
        <div class="tab-pane fade" id="pane-vencimientos" role="tabpanel" aria-labelledby="tab-vencimientos">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div>
                        <h2 class="h5 mb-0">Fechas de Vencimiento de Contratos y Proyección Acumulada</h2>
                        <small class="text-muted">Línea de tiempo cronológica según el vencimiento más cercano de cada subsidiaria y absorción paulatina de volumetría</small>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (availableDrivers.Count > 0)
                        {
                            <div class="dropdown" id="dropdownVencimientoDrivers">
                                <button class="btn btn-outline-primary btn-sm dropdown-toggle fw-semibold shadow-sm d-inline-flex align-items-center gap-1"
                                        type="button" id="btnVencimientoDriversDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                                        title="Seleccionar qué drivers proyectar en la línea de tiempo">
                                    <span>📊 Drivers a Proyectar</span>
                                    <span class="badge bg-primary text-white ms-1" id="badgeSelectedDriversCount">@activeDrivers.Count</span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg p-3" aria-labelledby="btnVencimientoDriversDropdown" style="min-width: 340px; max-height: 480px; overflow-y: auto;">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                        <span class="fw-bold small text-dark">Drivers para la Proyección</span>
                                        <span class="badge bg-success-subtle text-success border border-success small" id="statusDriverSave" style="display:none;">Guardado en BD ✓</span>
                                    </div>
                                    <div class="d-flex gap-1 mb-2">
                                        <button type="button" class="btn btn-outline-secondary py-0 px-2" id="btnDriversDefault" style="font-size:0.75rem;">Estándar</button>
                                        <button type="button" class="btn btn-outline-secondary py-0 px-2" id="btnDriversAll" style="font-size:0.75rem;">Todos</button>
                                        <button type="button" class="btn btn-outline-secondary py-0 px-2" id="btnDriversClear" style="font-size:0.75rem;">Limpiar</button>
                                    </div>
                                    <div id="driversCheckboxContainer">
                                        @for (var i = 0; i < availableDrivers.Count; i++)
                                        {
                                            var driverName = availableDrivers[i];
                                            var isChecked = activeDrivers.Contains(driverName, StringComparer.OrdinalIgnoreCase);
                                            var unit = driverUnits.GetValueOrDefault(driverName) ?? "";
                                            <div class="form-check py-1">
                                                <input class="form-check-input chk-vencimiento-driver" type="checkbox" value="@driverName" id="chk_driver_@i" @(isChecked ? "checked" : "") />
                                                <label class="form-check-label small text-dark" for="chk_driver_@i">
                                                    <strong>@driverName</strong>
                                                    @if (!string.IsNullOrWhiteSpace(unit))
                                                    {
                                                        <span class="text-muted small ms-1">(@unit)</span>
                                                    }
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.AdoptionExport))
                        {
                            <a asp-action="ExportEvaluationExcel" asp-route-id="@Model.ProcesoId" asp-route-section="vencimientos"
                                class="btn btn-outline-success btn-sm fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                                title="Exportar matriz de vencimientos y timeline a formato Excel">
                                <span>📥 Exportar a Excel</span>
                            </a>
                        }
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0 text-center" id="tableVencimientosProyeccion">
                        <thead class="table-light text-muted" style="font-size:0.75rem;">
                            <tr>
                                <th scope="col" rowspan="2" style="vertical-align:middle; width:40px;">#</th>
                                <th scope="col" rowspan="2" style="vertical-align:middle; text-align:left; min-width:180px;">Subsidiaria</th>
                                <th scope="col" rowspan="2" style="vertical-align:middle; text-align:left; min-width:160px;">Producto Actual</th>
                                <th scope="col" colspan="@(Math.Max(1, activeDrivers.Count))" class="bg-light" id="thGroupDrivers">Drivers Proyectados</th>
                                <th scope="col" colspan="@Model.VencimientoContratosReport.PeriodosHito.Count" class="bg-primary text-white">Línea Cronológica de Expiración Contractual</th>
                            </tr>
                            <tr id="trDriverHeaders">
                                @foreach (var d in activeDrivers)
                                {
                                    var unit = driverUnits.GetValueOrDefault(d) ?? "";
                                    <th scope="col" class="th-driver-vertical" data-driver-header="@d" title="@d @(!string.IsNullOrWhiteSpace(unit) ? $"({unit})" : "")">
                                        <div class="th-driver-vertical-cell">
                                            <div class="th-driver-vertical-container">
                                                <span class="th-driver-vertical-text">@d</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(unit))
                                            {
                                                <span class="th-driver-unit-badge" title="Unidad: @unit">@unit</span>
                                            }
                                        </div>
                                    </th>
                                }
                                @foreach (var h in Model.VencimientoContratosReport.PeriodosHito)
                                {
                                    <th scope="col" class="th-milestone fw-bold text-nowrap" style="min-width:75px; vertical-align:bottom; padding-bottom:8px;">@h.PeriodoLabel</th>
                                }
                            </tr>
                        </thead>
                        <tbody id="tbodyVencimientosReport">
                        @foreach (var row in Model.VencimientoContratosReport.Filas)
                        {
                            var assignedHito = row.HitoExpiracionPorPeriodo.FirstOrDefault(kv => kv.Value).Key ?? (row.TipoContrato == "PAYG" ? "PAYG" : "PAYG");
                            <tr data-empresa-id="@row.EmpresaId" data-assigned-hito="@assignedHito">
                                <td class="text-muted small">@row.Secuencia</td>
                                <td class="text-start fw-bold text-dark">@row.EmpresaNombre</td>
                                <td class="text-start small text-primary">@(row.ProductoActual ?? (Model.EsWaap ? "WAF Local" : "No configurada"))</td>
                                @foreach (var d in activeDrivers)
                                {
                                    var val = row.DriversPorNombre != null && row.DriversPorNombre.TryGetValue(d, out var v) ? v : 0m;
                                    var fmt = (val > 0 && val < 0.05m) ? val.ToString("0.###") : (val % 1 == 0 ? val.ToString("N0") : val.ToString("N1"));
                                    <td class="text-end fw-semibold small td-driver-val" data-driver-key="@d">@(val == 0 ? "—" : fmt)</td>
                                }
                                @foreach (var h in Model.VencimientoContratosReport.PeriodosHito)
                                {
                                    var isMarked = row.HitoExpiracionPorPeriodo.TryGetValue(h.PeriodoLabel, out var active) && active;
                                    <td class="@(isMarked ? "bg-primary-subtle" : "") td-milestone" data-milestone="@h.PeriodoLabel">
                                        @if (isMarked)
                                        {
                                            <span class="badge bg-primary text-white fw-bold px-2 py-1" title="Expiración: @row.VencimientoLabel">X</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted opacity-25">·</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-dark" id="tfootVencimientosReport" style="font-size:0.85rem;">
                        @foreach (var d in activeDrivers)
                        {
                            var totalVal = Model.VencimientoContratosReport.Filas
                                .Sum(r => (r.DriversPorNombre != null && r.DriversPorNombre.TryGetValue(d, out var v)) ? v : 0m);
                            var fmtTotal = (totalVal > 0 && totalVal < 0.05m) ? totalVal.ToString("0.###") : (totalVal % 1 == 0 ? totalVal.ToString("N0") : totalVal.ToString("N1"));
                            var unit = driverUnits.GetValueOrDefault(d) ?? "";
                            
                            <tr data-footer-driver="@d">
                                <td colspan="3" class="text-end fw-bold text-uppercase text-nowrap" style="letter-spacing:0.5px;">
                                    @d @(!string.IsNullOrWhiteSpace(unit) ? $"({unit})" : "") ACUM:
                                </td>
                                @foreach (var otherD in activeDrivers)
                                {
                                    if (string.Equals(otherD, d, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <td class="text-end fw-bold bg-secondary bg-opacity-25" data-driver-total="@d">@fmtTotal</td>
                                    }
                                    else
                                    {
                                        <td class="text-center text-muted" data-driver-placeholder="@otherD">—</td>
                                    }
                                }
                                @{
                                    decimal runSum = 0m;
                                    foreach (var h in Model.VencimientoContratosReport.PeriodosHito)
                                    {
                                        var rowsInHito = Model.VencimientoContratosReport.Filas
                                            .Where(r => r.HitoExpiracionPorPeriodo.TryGetValue(h.PeriodoLabel, out var active) && active)
                                            .ToList();
                                        runSum += rowsInHito.Sum(r => (r.DriversPorNombre != null && r.DriversPorNombre.TryGetValue(d, out var v)) ? v : 0m);
                                        var fmtRun = (runSum > 0 && runSum < 0.05m) ? runSum.ToString("0.###") : (runSum % 1 == 0 ? runSum.ToString("N0") : runSum.ToString("N1"));
                                        <td class="text-center fw-bold bg-dark border-start" data-hito-accum="@h.PeriodoLabel">
                                            @fmtRun
                                        </td>
                                    }
                                }
                            </tr>
                        }
                            <tr class="table-secondary text-dark fw-bold" id="trSubsidiariasAcumuladas">
                                <td colspan="@(3 + activeDrivers.Count)" class="text-end fw-bold text-uppercase" id="tdSubsidiariasAcumuladasLabel" style="letter-spacing:0.5px;">
                                    SUBSIDIARIAS ACUMULADAS:
                                </td>
                                @foreach (var h in Model.VencimientoContratosReport.PeriodosHito)
                                {
                                    <td class="text-center fw-bold bg-dark border-start text-white" data-sub-accum="@h.PeriodoLabel">
                                        @(Model.VencimientoContratosReport.SubsidiariasAcumuladasPorPeriodo != null && Model.VencimientoContratosReport.SubsidiariasAcumuladasPorPeriodo.TryGetValue(h.PeriodoLabel, out var v) ? v : 0)
                                    </td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <script id="vencimientoReportData" type="application/json">
                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                        procesoId = Model.ProcesoId,
                        milestones = Model.VencimientoContratosReport.PeriodosHito.Select(h => h.PeriodoLabel).ToList(),
                        defaultDrivers = Model.EsWaap 
                            ? new List<string> { "Throughput (mensual)", "Cantidad de aplicaciones (FQDN)", "Millones Request WAF (mensual)" }
                            : (availableDrivers.Take(3).ToList()),
                        driverUnits = driverUnits,
                        companies = Model.VencimientoContratosReport.Filas.Select(f => new {
                            empresaId = f.EmpresaId,
                            empresaNombre = f.EmpresaNombre,
                            assignedHito = f.HitoExpiracionPorPeriodo.FirstOrDefault(kv => kv.Value).Key ?? (f.TipoContrato == "PAYG" ? "PAYG" : "PAYG"),
                            drivers = f.DriversPorNombre ?? new Dictionary<string, decimal>()
                        }).ToList()
                    }))
                </script>
            </div>
        </div>

        <!-- PESTAÑA 3: VOLUMETRÍA / DRIVERS POR EMPRESA -->
        <div class="tab-pane fade" id="pane-volumetria" role="tabpanel" aria-labelledby="tab-volumetria">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div>
                        <h2 class="h5 mb-0">@(Model.EsWaap ? "Volumetría Detallada y Dimensionamiento por Empresa" : "Drivers de Consumo y Dimensionamiento por Empresa")</h2>
                        <small class="text-muted">
                            @(Model.EsWaap 
                                ? "Drivers de consumo mensual por subsidiaria, capacidad de throughput, transacciones y transferencia de datos" 
                                : $"Métricas y drivers operativos registrados para el Building Block {Model.BuildingBlockNombre}")
                        </small>
                    </div>
                    @if (User.HasClaim(CustomClaimTypes.Permission, Permissions.AdoptionExport))
                    {
                        <a asp-action="ExportEvaluationExcel" asp-route-id="@Model.ProcesoId" asp-route-section="volumetria"
                           class="btn btn-outline-success btn-sm fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                           title="Exportar volumetría y drivers por empresa a formato Excel">
                            <span>📥 Exportar a Excel</span>
                        </a>
                    }
                </div>

                @if (Model.EsWaap)
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0 text-center" style="font-size:0.8rem;">
                            <thead class="table-light text-muted text-uppercase" style="font-size:0.7rem;">
                                <tr>
                                    <th scope="col" class="text-start" style="min-width:160px;">Empresa</th>
                                    <th scope="col" class="text-start" style="min-width:140px;">Tecnología AS-IS</th>
                                    <th scope="col" title="Throughput (mensual)">Throughput<br/><small class="text-muted text-lowercase fw-normal">(Gbps/mes)</small></th>
                                    <th scope="col" title="Ancho de Banda (mensual)">Ancho Banda<br/><small class="text-muted text-lowercase fw-normal">(Gbps/mes)</small></th>
                                    <th scope="col" title="Dominio">Dominio<br/><small class="text-muted fw-normal">(Dominio)</small></th>
                                    <th scope="col" title="Sub Dominios">Sub Dominios<br/><small class="text-muted fw-normal">(Sub Dominios)</small></th>
                                    <th scope="col" title="Cantidad de aplicaciones (FQDN)">Cant. Apps<br/><small class="text-muted fw-normal">FQDN</small></th>
                                    <th scope="col" title="Cantidad de Aplicaciones FQDN en API Security">Apps FQDN<br/><small class="text-muted fw-normal">API Security</small></th>
                                    <th scope="col" title="API Protection / API Security Request">API Protection<br/><small class="text-muted text-lowercase fw-normal">Req (M/mes)</small></th>
                                    <th scope="col" title="Millones de Request (mensual / antibot)">Req Antibot<br/><small class="text-muted text-lowercase fw-normal">(M/mes)</small></th>
                                    <th scope="col" title="Millones Request WAF (mensual)">Req WAF<br/><small class="text-muted text-lowercase fw-normal">(M/mes)</small></th>
                                    <th scope="col" title="Millones Request Antibot+WAF (mensual)">Req Total<br/><small class="text-muted fw-normal">Antibot+WAF</small></th>
                                    <th scope="col" title="Data Transfer (mensual)">Data Transfer<br/><small class="text-muted text-lowercase fw-normal">(TB/mes)</small></th>
                                    <th scope="col" title="Request Size (mensual)">Request Size<br/><small class="text-muted fw-normal">(KB/GB)</small></th>
                                    <th scope="col" title="Response Size (mensual)">Response Size<br/><small class="text-muted fw-normal">(KB/GB/TB)</small></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in Model.VolumetriaReport.Filas)
                            {
                                <tr data-empresa-id="@row.EmpresaId">
                                    <td class="text-start fw-bold text-dark">@row.EmpresaNombre</td>
                                    <td class="text-start text-primary">@(row.TecnologiaAsIs ?? "WAF Local")</td>
                                    <td class="text-end fw-semibold editable-vol-cell" contenteditable="true" data-driver-key="throughput" data-decimals="1" title="Haga clic para editar Throughput (mensual)">@row.ThroughputMensualGbps.ToString("N1")</td>
                                    <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="ancho_banda" data-decimals="2" title="Haga clic para editar Ancho de Banda (mensual)">@row.AnchoBandaMensualGbps.ToString("N2")</td>
                                    <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="dominio" data-decimals="0" title="Haga clic para editar Dominio">@row.Dominio</td>
                                    <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="subdominios" data-decimals="0" title="Haga clic para editar Sub Dominios">@row.SubDominios</td>
                                    <td class="text-end fw-bold editable-vol-cell" contenteditable="true" data-driver-key="apps_fqdn" data-decimals="0" title="Haga clic para editar Cantidad de aplicaciones (FQDN)">@row.CantidadAppsFqdn</td>
                                    <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="apps_api_sec" data-decimals="0" title="Haga clic para editar Cantidad de Aplicaciones FQDN en API Security">@row.CantidadAppsFqdnApiSecurity</td>
                                    <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="api_prot" data-decimals="1" title="Haga clic para editar API Protection / API Security Request">@row.ApiProtectionRequestMillonesMes.ToString("N1")</td>
                                    <td class="text-end editable-vol-cell col-antibot" contenteditable="true" data-driver-key="antibot" data-decimals="1" title="Haga clic para editar Millones de Request (mensual / antibot)">@row.MillonesRequestAntibot.ToString("N1")</td>
                                    <td class="text-end fw-semibold editable-vol-cell col-waf" contenteditable="true" data-driver-key="waf" data-decimals="1" title="Haga clic para editar Millones Request WAF (mensual)">@row.MillonesRequestWaf.ToString("N1")</td>
                                    <td class="text-end fw-bold text-primary col-antibot-waf">@row.MillonesRequestAntibotWaf.ToString("N1")</td>
                                    <td class="text-end fw-bold editable-vol-cell" contenteditable="true" data-driver-key="data_transfer" data-decimals="1" title="Haga clic para editar Data Transfer (mensual)">@row.DataTransferTbMensual.ToString("N1")</td>
                                    <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="request_size" data-decimals="0" title="Haga clic para editar Request Size (mensual)">@(row.RequestSize ?? "—")</td>
                                    <td class="text-end editable-vol-cell" contenteditable="true" data-driver-key="response_size" data-decimals="0" title="Haga clic para editar Response Size (mensual)">@(row.ResponseSize ?? "—")</td>
                                </tr>
                            }
                            </tbody>
                            <tfoot class="table-dark fw-bold" style="font-size:0.8rem;">
                                <tr>
                                    <td colspan="2" class="text-start text-uppercase">TOTALES CONSOLIDADOS:</td>
                                    <td class="text-end tot-throughput">@Model.VolumetriaReport.TotalThroughputMensualGbps.ToString("N1")</td>
                                    <td class="text-end tot-ancho_banda">@Model.VolumetriaReport.TotalAnchoBandaMensualGbps.ToString("N2")</td>
                                    <td class="text-end tot-dominio">@Model.VolumetriaReport.TotalDominio</td>
                                    <td class="text-end tot-subdominios">@Model.VolumetriaReport.TotalSubDominios</td>
                                    <td class="text-end tot-apps_fqdn">@Model.VolumetriaReport.TotalAppsFqdn</td>
                                    <td class="text-end tot-apps_api_sec">@Model.VolumetriaReport.TotalAppsFqdnApiSecurity</td>
                                    <td class="text-end tot-api_prot">@Model.VolumetriaReport.TotalApiProtectionRequestMillonesMes.ToString("N1")</td>
                                    <td class="text-end tot-antibot">@Model.VolumetriaReport.TotalMillonesRequestAntibot.ToString("N1")</td>
                                    <td class="text-end tot-waf">@Model.VolumetriaReport.TotalMillonesRequestWaf.ToString("N1")</td>
                                    <td class="text-end text-info tot-antibot-waf">@Model.VolumetriaReport.TotalMillonesRequestAntibotWaf.ToString("N1")</td>
                                    <td class="text-end tot-data_transfer">@Model.VolumetriaReport.TotalDataTransferTbMensual.ToString("N1")</td>
