                                                <span class="badge bg-primary text-white px-2 py-1 shadow-sm">F</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">NA</span>
                                            }
                                        </button>
                                    </td>
                                }
                                <td class="text-start small editable-report-comment-cell text-muted fst-italic"
                                    contenteditable="true"
                                    data-empresa-id="@row.EmpresaId"
                                    title="Haga clic para editar comentario de la subsidiaria">
