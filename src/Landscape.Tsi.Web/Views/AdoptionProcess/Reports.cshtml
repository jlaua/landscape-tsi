                                            <div class="th-driver-vertical-container">
                                                <span class="th-driver-vertical-text">Req Antibot</span>
                                            </div>
                                            <span class="th-driver-unit-badge" title="Unidad: M/mes">M/mes</span>
                                        </div>
                                    </th>
                                    <th scope="col" class="th-driver-vertical" title="Millones Request WAF (mensual) (M/mes)">
                                        <div class="th-driver-vertical-cell">
                                            <div class="th-driver-vertical-container">
                                                <span class="th-driver-vertical-text">Req WAF</span>
                                            </div>
                                            <span class="th-driver-unit-badge" title="Unidad: M/mes">M/mes</span>
                                        </div>
                                    </th>
                                    <th scope="col" class="th-driver-vertical" title="Millones Request Antibot+WAF (mensual)">
                                        <div class="th-driver-vertical-cell">
                                            <div class="th-driver-vertical-container">
