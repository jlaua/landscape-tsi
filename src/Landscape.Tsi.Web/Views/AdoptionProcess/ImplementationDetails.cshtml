@section Scripts {
    <script>
        const specialistsCatalog = {
            companyContacts: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EspecialistasEmpresas)),
            partnerContacts: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EspecialistasPartners)),
            processStandardTechId: @(p.TecnologiaEstandarId ?? 0)
        };

        document.addEventListener('DOMContentLoaded', function () {
            const modalEl = document.getElementById('modalEditCompanyProgress');
            const chkAplica = document.getElementById('modalAplica');
            const groupJust = document.getElementById('groupJustificacion');
            const selEstado = document.getElementById('modalEstado');
            const selTech = document.getElementById('modalTecnologiaAsIsSelect');
            const groupCustom = document.getElementById('groupCustomTecnologia');
            const txtCustom = document.getElementById('modalTecnologiaAsIsCustom');
            const hidTech = document.getElementById('modalTecnologiaAsIs');

            const selEsp = document.getElementById('modalEspecialistaSelect');
            const groupCustomEsp = document.getElementById('groupCustomEspecialista');
            const txtCustomEsp = document.getElementById('modalEspecialistaCustom');
            const hidEsp = document.getElementById('modalEspecialista');
            const hidContactId = document.getElementById('modalIdContactoEspecialista');
            const optgroupCompany = document.getElementById('optgroupSubsidiarySpecialists');
            const optgroupPartner = document.getElementById('optgroupPartnerSpecialists');

            function syncTechValue() {
                if (selTech.value === '__CUSTOM__') {
                    groupCustom.style.display = 'block';
                    hidTech.value = txtCustom.value.trim();
                } else {
                    groupCustom.style.display = 'none';
                    hidTech.value = selTech.value;
                }
            }

            function syncSpecialistValue() {
                if (!selEsp) return;
                if (selEsp.value === '__CUSTOM__') {
                    groupCustomEsp.style.display = 'block';
                    hidEsp.value = txtCustomEsp.value.trim();
                    hidContactId.value = '';
                } else if (selEsp.value) {
                    groupCustomEsp.style.display = 'none';
                    const selectedOpt = selEsp.selectedOptions[0];
                    if (selectedOpt && selectedOpt.dataset && selectedOpt.dataset.type === 'empresa') {
                        hidContactId.value = selectedOpt.dataset.contactId || '';
                        hidEsp.value = selectedOpt.dataset.name || selectedOpt.value;
                    } else {
                        hidContactId.value = '';
                        hidEsp.value = selEsp.value;
                    }
                } else {
                    groupCustomEsp.style.display = 'none';
                    hidEsp.value = '';
                    hidContactId.value = '';
                }
            }

            if (selTech) {
                selTech.addEventListener('change', function () {
                    syncTechValue();
                    if (selTech.value === '__CUSTOM__') {
                        txtCustom.focus();
                    }
                });
            }

            if (txtCustom) {
                txtCustom.addEventListener('input', function () {
                    if (selTech.value === '__CUSTOM__') {
                        hidTech.value = this.value.trim();
                    }
                });
            }

            if (selEsp) {
                selEsp.addEventListener('change', function () {
                    syncSpecialistValue();
                    if (selEsp.value === '__CUSTOM__') {
                        txtCustomEsp.focus();
                    }
                });
            }

            if (txtCustomEsp) {
                txtCustomEsp.addEventListener('input', function () {
                    if (selEsp.value === '__CUSTOM__') {
                        hidEsp.value = this.value.trim();
                        hidContactId.value = '';
                    }
                });
            }

            chkAplica.addEventListener('change', function () {
                if (!this.checked) {
                    groupJust.style.display = 'block';
                    selEstado.value = 'NO_APLICA';
                } else {
                    groupJust.style.display = 'none';
                    if (selEstado.value === 'NO_APLICA') selEstado.value = 'PENDIENTE';
                }
            });

            document.querySelectorAll('.btn-edit-company-progress').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('modalProcesoEmpresaId').value = this.dataset.id;
                    document.getElementById('modalEmpresaNombre').textContent = this.dataset.name;

                    const aplica = this.dataset.aplica === 'true';
                    chkAplica.checked = aplica;
                    groupJust.style.display = aplica ? 'none' : 'block';
                    document.getElementById('modalJustificacion').value = this.dataset.justifica || '';

                    document.getElementById('modalFecha').value = this.dataset.fecha || '';
                    document.getElementById('modalUrl').value = this.dataset.url || '';
                    selEstado.value = this.dataset.estado || (aplica ? 'PENDIENTE' : 'NO_APLICA');

                    // Poblar y sincronizar Especialistas (Empresa Subsidiaria y Partner)
                    const empresaId = parseInt(this.dataset.empresaId || '0', 10);
                    const currentEsp = (this.dataset.especialista || '').trim();
                    const currentContactId = parseInt(this.dataset.contactoId || '0', 10);

                    if (optgroupCompany && optgroupPartner) {
                        optgroupCompany.innerHTML = '';
                        optgroupCompany.label = `🏢 Especialistas de ${this.dataset.name || 'la Empresa'}`;

                        const compContacts = specialistsCatalog.companyContacts.filter(c => c.EmpresaId === empresaId);
                        if (compContacts.length === 0) {
                            const emptyOpt = document.createElement('option');
                            emptyOpt.disabled = true;
                            emptyOpt.value = '';
                            emptyOpt.textContent = 'Sin especialistas registrados para esta subsidiaria';
                            optgroupCompany.appendChild(emptyOpt);
                        } else {
                            compContacts.forEach(c => {
                                const opt = document.createElement('option');
                                opt.value = c.Nombre;
                                opt.dataset.type = 'empresa';
                                opt.dataset.contactId = c.Id;
                                opt.dataset.name = c.Nombre;
                                const details = [c.Rol, c.Plataformas ? `Plat: ${c.Plataformas}` : null, c.Email ? c.Email : null].filter(Boolean).join(' · ');
                                opt.textContent = `👤 ${c.Nombre}${details ? ` (${details})` : ''}`;
                                optgroupCompany.appendChild(opt);
                            });
                        }

                        optgroupPartner.innerHTML = '';
                        if (specialistsCatalog.partnerContacts.length === 0) {
                            const emptyOpt = document.createElement('option');
                            emptyOpt.disabled = true;
                            emptyOpt.value = '';
                            emptyOpt.textContent = 'Sin especialistas de partner registrados';
                            optgroupPartner.appendChild(emptyOpt);
                        } else {
                            const sortedPartners = [...specialistsCatalog.partnerContacts].sort((a, b) => {
                                const aIsStd = specialistsCatalog.processStandardTechId > 0 && a.TecnologiaId === specialistsCatalog.processStandardTechId ? 1 : 0;
                                const bIsStd = specialistsCatalog.processStandardTechId > 0 && b.TecnologiaId === specialistsCatalog.processStandardTechId ? 1 : 0;
                                if (aIsStd !== bIsStd) return bIsStd - aIsStd;
                                return (a.PartnerNombre || '').localeCompare(b.PartnerNombre || '');
                            });

                            sortedPartners.forEach(p => {
                                const opt = document.createElement('option');
                                const isStdPartner = specialistsCatalog.processStandardTechId > 0 && p.TecnologiaId === specialistsCatalog.processStandardTechId;
                                const star = isStdPartner ? '⭐ ' : '';
                                const badge = isStdPartner ? ' [Partner Adjudicado]' : '';
                                opt.value = `${p.Nombre} (Partner: ${p.PartnerNombre})`;
                                opt.dataset.type = 'partner';
                                opt.dataset.partnerContactId = p.Id;
                                opt.dataset.name = p.Nombre;
                                opt.dataset.partner = p.PartnerNombre;
                                const roleInfo = p.Rol ? ` · ${p.Rol}` : '';
                                opt.textContent = `🤝 ${star}${p.Nombre} - ${p.PartnerNombre}${badge}${roleInfo}`;
                                optgroupPartner.appendChild(opt);
                            });
                        }

                        let espMatched = false;
                        if (currentContactId > 0) {
                            for (let opt of optgroupCompany.querySelectorAll('option')) {
                                if (opt.dataset && parseInt(opt.dataset.contactId || '0', 10) === currentContactId) {
                                    selEsp.value = opt.value;
                                    hidContactId.value = currentContactId;
                                    hidEsp.value = opt.dataset.name || opt.value;
                                    espMatched = true;
                                    break;
                                }
                            }
                        }

                        if (!espMatched && currentEsp) {
                            for (let opt of optgroupCompany.querySelectorAll('option')) {
                                if (opt.value && opt.value.toLowerCase() === currentEsp.toLowerCase()) {
                                    selEsp.value = opt.value;
                                    hidContactId.value = opt.dataset.contactId || '';
                                    hidEsp.value = opt.dataset.name || opt.value;
                                    espMatched = true;
                                    break;
                                }
                            }
                            if (!espMatched) {
                                for (let opt of optgroupPartner.querySelectorAll('option')) {
                                    if (opt.value && (opt.value.toLowerCase() === currentEsp.toLowerCase() || (opt.dataset.name && opt.dataset.name.toLowerCase() === currentEsp.toLowerCase()))) {
                                        selEsp.value = opt.value;
                                        hidContactId.value = '';
                                        hidEsp.value = opt.value;
                                        espMatched = true;
                                        break;
                                    }
                                }
                            }
                        }

                        if (espMatched) {
                            groupCustomEsp.style.display = 'none';
                            txtCustomEsp.value = '';
                        } else if (currentEsp.length > 0) {
                            selEsp.value = '__CUSTOM__';
                            groupCustomEsp.style.display = 'block';
                            txtCustomEsp.value = currentEsp;
                            hidEsp.value = currentEsp;
                            hidContactId.value = '';
                        } else {
                            selEsp.value = '';
                            groupCustomEsp.style.display = 'none';
                            txtCustomEsp.value = '';
                            hidEsp.value = '';
                            hidContactId.value = '';
                        }
                    }

                    // Sincronizar Tecnologia AS-IS
                    const techVal = (this.dataset.tecnologiaasis || '').trim();
                    let matched = false;
                    if (selTech) {
                        for (let i = 0; i < selTech.options.length; i++) {
                            const opt = selTech.options[i];
                            if (opt.value && opt.value !== '__CUSTOM__' && opt.value.toLowerCase() === techVal.toLowerCase()) {
                                selTech.value = opt.value;
                                matched = true;
                                break;
                            }
                        }

                        if (matched) {
                            groupCustom.style.display = 'none';
                            txtCustom.value = '';
                            hidTech.value = selTech.value;
                        } else if (techVal.length > 0) {
                            selTech.value = '__CUSTOM__';
                            groupCustom.style.display = 'block';
                            txtCustom.value = techVal;
                            hidTech.value = techVal;
                        } else {
                            selTech.value = '';
                            groupCustom.style.display = 'none';
                            txtCustom.value = '';
                            hidTech.value = '';
                        }
                    }

                    const currFile = this.dataset.archivo;
                    const badgeFile = document.getElementById('currentFileBadge');
                    if (currFile) {
                        badgeFile.textContent = 'Actual: ' + currFile;
                        badgeFile.style.display = 'inline-block';
                    } else {
                        badgeFile.style.display = 'none';
                    }
                });
            });

            const form = document.getElementById('formUpdateCompany');
            if (form) {
                form.addEventListener('submit', function () {
                    syncTechValue();
                    syncSpecialistValue();
                });
            }

            // GESTIÓN DE CONVOCATORIA (Filtro y Selección Masiva)
            const inputFilterConvo = document.getElementById('inputFilterConvocatoria');
            if (inputFilterConvo) {
                inputFilterConvo.addEventListener('input', function () {
                    const term = this.value.toLowerCase().trim();
                    document.querySelectorAll('.tr-convo-row').forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(term) ? '' : 'none';
                    });
                });
            }

            const btnCheckAllConvo = document.getElementById('btnCheckAllModalConvo');
            const btnUncheckAllConvo = document.getElementById('btnUncheckAllModalConvo');
            if (btnCheckAllConvo) {
                btnCheckAllConvo.addEventListener('click', () => {
                    document.querySelectorAll('.chk-modal-convo-item').forEach(c => c.checked = true);
                });
            }
            if (btnUncheckAllConvo) {
                btnUncheckAllConvo.addEventListener('click', () => {
                    document.querySelectorAll('.chk-modal-convo-item').forEach(c => c.checked = false);
                });
            }

            // MODAL PICKER DE ESPECIALISTA DESDE AVANCE
            let currentEditingEmpresaId = null;
            let currentEditingEmpresaName = '';
            document.querySelectorAll('.btn-edit-company-progress').forEach(btn => {
                btn.addEventListener('click', function () {
                    currentEditingEmpresaId = parseInt(this.dataset.empresaId, 10);
                    currentEditingEmpresaName = this.dataset.name || '';
                });
            });

            const modalPickerEl = document.getElementById('modalEspecialistaPicker');
            const bsPickerModal = modalPickerEl ? new bootstrap.Modal(modalPickerEl) : null;
            const btnOpenPicker = document.getElementById('btnOpenSpecialistModalFromProgress');

            if (btnOpenPicker) {
                btnOpenPicker.addEventListener('click', function () {
                    if (!currentEditingEmpresaId) return;

                    const labelComp = document.getElementById('modalEspCompanyLabel');
                    if (labelComp) labelComp.textContent = currentEditingEmpresaName;

                    const inputFilter = document.getElementById('inputFilterDetailSpecialists');
                    if (inputFilter) inputFilter.value = '';

                    const formNew = document.getElementById('formDetailCreateNewSpecialist');
                    if (formNew) formNew.reset();

                    const tabBtn = document.getElementById('tab-detail-existentes-btn');
                    if (tabBtn) new bootstrap.Tab(tabBtn).show();

                    loadDetailSpecialists(currentEditingEmpresaId);

                    if (bsPickerModal) bsPickerModal.show();
                });
            }

            let detailSpecialists = [];
            const tbodyDetail = document.getElementById('tbodyDetailSpecialists');
            const loadingDetail = document.getElementById('loadingDetailSpecialists');
            const noDetailMsg = document.getElementById('noDetailSpecialistsMessage');

            async function loadDetailSpecialists(empresaId) {
                if (!tbodyDetail) return;
                tbodyDetail.innerHTML = '';
                if (loadingDetail) loadingDetail.classList.remove('d-none');
                if (noDetailMsg) noDetailMsg.classList.add('d-none');

                try {
                    const res = await fetch(`/AdoptionProcess/Implementations/Api/SpecialistsLookup?empresaId=${empresaId}`);
                    if (!res.ok) throw new Error('Error al cargar especialistas');
                    const data = await res.json();

                    detailSpecialists = [];
                    if (data.companyContacts) {
                        data.companyContacts.forEach(c => {
                            detailSpecialists.push({
                                id: c.id,
                                nombre: c.nombre,
                                rol: c.rol || 'Especialista',
                                email: c.email || '—',
                                origen: 'Subsidiaria',
                                isCompany: true
                            });
                        });
                    }
                    if (data.partnerContacts) {
                        data.partnerContacts.forEach(p => {
                            detailSpecialists.push({
                                id: p.id,
                                nombre: p.nombre,
                                rol: p.rol || 'Especialista Partner',
                                email: p.email || '—',
                                origen: p.partnerNombre || 'Partner',
                                isCompany: false
                            });
                        });
                    }

                    renderDetailSpecialistsTable(detailSpecialists);
                } catch (e) {
                    console.error('Error cargando especialistas:', e);
                } finally {
                    if (loadingDetail) loadingDetail.classList.add('d-none');
                }
            }

            function renderDetailSpecialistsTable(list) {
                if (!tbodyDetail) return;
                tbodyDetail.innerHTML = '';

                if (list.length === 0) {
                    if (noDetailMsg) noDetailMsg.classList.remove('d-none');
                    return;
                }
                if (noDetailMsg) noDetailMsg.classList.add('d-none');

                list.forEach(item => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td><strong>${escapeHtml(item.nombre)}</strong></td>
                        <td class="text-muted small">${escapeHtml(item.rol)}</td>
                        <td class="text-muted small">${escapeHtml(item.email)}</td>
                        <td><span class="badge ${item.isCompany ? 'bg-primary-subtle text-primary border' : 'bg-secondary-subtle text-secondary border'}" style="font-size: 0.7rem;">${escapeHtml(item.origen)}</span></td>
                        <td class="text-end">
                            <button type="button" class="btn btn-primary btn-sm py-0 px-2 btn-pick-spec" data-name="${escapeHtml(item.nombre)}" data-rol="${escapeHtml(item.rol)}">
                                Asignar
                            </button>
                        </td>
                    `;
                    tbodyDetail.appendChild(tr);
                });

                tbodyDetail.querySelectorAll('.btn-pick-spec').forEach(b => {
                    b.addEventListener('click', function () {
                        const name = this.getAttribute('data-name');
                        const rol = this.getAttribute('data-rol');
                        applySpecialistToProgress(name, rol);
                    });
                });
            }

            function applySpecialistToProgress(name, rol) {
                const fullName = name + (rol ? ` (${rol})` : '');
                if (txtCustomEsp) txtCustomEsp.value = fullName;
                if (hidEsp) hidEsp.value = fullName;
                if (selEsp) selEsp.value = '__CUSTOM__';
                if (groupCustomEsp) groupCustomEsp.style.display = 'block';

                if (bsPickerModal) bsPickerModal.hide();
            }

            const inputFilterDetail = document.getElementById('inputFilterDetailSpecialists');
            if (inputFilterDetail) {
                inputFilterDetail.addEventListener('input', function () {
                    const term = this.value.toLowerCase().trim();
                    if (!term) {
                        renderDetailSpecialistsTable(detailSpecialists);
                        return;
                    }
                    const filtered = detailSpecialists.filter(s =>
                        s.nombre.toLowerCase().includes(term) ||
                        s.rol.toLowerCase().includes(term) ||
                        s.email.toLowerCase().includes(term)
                    );
                    renderDetailSpecialistsTable(filtered);
                });
            }

            // Registrar nuevo especialista desde detalle
            const formDetailNew = document.getElementById('formDetailCreateNewSpecialist');
            if (formDetailNew) {
                formDetailNew.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    if (!currentEditingEmpresaId) return;

                    const nombre = document.getElementById('newDetailEspNombre').value.trim();
                    const rol = document.getElementById('newDetailEspRol').value.trim();
                    const email = document.getElementById('newDetailEspEmail').value.trim();
                    const telefono = document.getElementById('newDetailEspTelefono').value.trim();
                    const plataformas = document.getElementById('newDetailEspPlataformas').value.trim();

                    if (!nombre) {
                        alert('El nombre es obligatorio.');
                        return;
                    }

                    const submitBtn = document.getElementById('btnSubmitDetailNewSpecialist');
                    if (submitBtn) submitBtn.disabled = true;

                    try {
                        const res = await fetch('/AdoptionProcess/Implementations/Api/CreateSpecialist', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                empresaId: currentEditingEmpresaId,
                                nombre,
                                rol,
                                email,
                                telefono,
                                plataformas
                            })
                        });

                        const result = await res.json();
                        if (result.success) {
                            applySpecialistToProgress(result.nombre, result.rol);
                        } else {
                            alert(result.message || 'Error al guardar especialista.');
                        }
                    } catch (err) {
                        console.error('Error registrando especialista:', err);
                        alert('Ocurrió un error al guardar.');
                    } finally {
                        if (submitBtn) submitBtn.disabled = false;
                    }
                });
            }

            function escapeHtml(str) {
                if (!str) return '';
                return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
            }
        });
    </script>
}
