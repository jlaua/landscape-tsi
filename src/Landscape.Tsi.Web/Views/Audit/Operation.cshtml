@model Landscape.Tsi.Application.Identity.AuditEventRow
@{
    ViewData["Title"] = "Detalle de auditoría";
}
<section class="admin-shell" aria-labelledby="audit-operation-title">
    <p class="eyebrow">TRAZABILIDAD</p>
    <h1 id="audit-operation-title">Detalle de auditoría</h1>
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="app-alert app-alert-success" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="app-alert app-alert-error" role="alert">@error</div>
    }
    <dl class="detail-grid">
        <dt>Fecha UTC</dt><dd>@Model.OccurredAtUtc.ToString("u")</dd>
        <dt>Usuario</dt><dd>@(Model.ActorUserName ?? "Sistema")</dd>
        <dt>Acción</dt><dd>@Model.Action</dd>
        <dt>Entidad</dt><dd>@(Model.Entity ?? "-")</dd>
        <dt>Registro</dt><dd>@(Model.RecordDisplayName ?? Model.RecordId ?? "-")</dd>
        <dt>Impacto</dt><dd>@Model.AffectedRecordCount</dd>
        <dt>Estado</dt><dd>@Model.Result</dd>
    </dl>
    @if (Model.OperationId is Guid operationId && string.Equals(Model.Action, "DELETE", StringComparison.OrdinalIgnoreCase) && Model.CanRestore)
    {
        <p class="supporting-text">La eliminación original permanece registrada. La restauración crea una operación independiente y no modifica el evento original.</p>
        <form method="post" asp-controller="Audit" asp-action="Restore" asp-route-operationId="@operationId">
            @Html.AntiForgeryToken()
            <button class="md-button md-button-filled" type="submit">Deshacer eliminación</button>
        </form>
    }
    <a class="md-button md-button-text" asp-controller="Audit" asp-action="Index">Volver a auditoría</a>
</section>
