@model Landscape.Tsi.Application.Reporting.CompanyAdoptionReport
@{
    ViewData["Title"] = "Adopción de Empresas por Tecnología";
}
<nav class="breadcrumbs" aria-label="Migas de pan">
    <a asp-controller="Home" asp-action="Index">Inicio</a>
    <span aria-hidden="true">›</span>
    <a asp-controller="Reporting" asp-action="Index">Reportería</a>
    <span aria-hidden="true">›</span>
    <span>Adopción de Empresas por Tecnología</span>
</nav>

<section class="page-heading" aria-labelledby="adoption-report-title">
    <div>
        <p class="eyebrow">REPORTERÍA ESTRATÉGICA</p>
        <h1 id="adoption-report-title">Adopción de Empresas por Tecnología</h1>
        <p class="supporting-text">Supervisión integral de cobertura por dominio y grado de alineación de empresas subsidiarias con respecto al estándar tecnológico corporativo TSI.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="md-button md-button-outlined" asp-controller="Reporting" asp-action="Index">Catálogos</a>
        <a class="md-button md-button-outlined" asp-controller="Reporting" asp-action="CompaniesAndCiso">Empresas y CISO</a>
    </div>
</section>

<!-- KPIs Globales -->
<section class="report-kpi-grid mb-4" aria-label="Indicadores de adopción y alineación">
    <div class="report-kpi">
        <span class="report-kpi-value">@Model.Kpis.TotalEmpresasParticipantes</span>
        <span class="report-kpi-label">Empresas Evaluadas</span>
    </div>
    <div class="report-kpi">
        <span class="report-kpi-value text-success">@Model.Kpis.TotalAlineadas</span>
        <span class="report-kpi-label">Alineadas al Estándar</span>
    </div>
    <div class="report-kpi">
        <span class="report-kpi-value text-info">@Model.Kpis.TotalHomologadas</span>
        <span class="report-kpi-label">Homologadas</span>
    </div>
    <div class="report-kpi">
        <span class="report-kpi-value text-warning">@Model.Kpis.TotalNoAlineadas</span>
        <span class="report-kpi-label">No Alineadas</span>
    </div>
    <div class="report-kpi">
        <span class="report-kpi-value text-secondary">@Model.Kpis.TotalPendientes</span>
        <span class="report-kpi-label">Pendientes</span>
    </div>
    <div class="report-kpi">
        <span class="report-kpi-value text-muted">@Model.Kpis.TotalNoAplica</span>
        <span class="report-kpi-label">No Aplica</span>
    </div>
    <div class="report-kpi">
        <span class="report-kpi-value">@Model.Kpis.PorcentajeAlineacionGlobal%</span>
        <span class="report-kpi-label">Alineación Global</span>
    </div>
</section>

<!-- Selector de Vistas / Pestañas -->
<ul class="nav nav-pills mb-4 gap-2" id="reportTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold px-4 py-2" id="tab-domain-btn" data-bs-toggle="pill" data-bs-target="#tab-domain" type="button" role="tab" aria-controls="tab-domain" aria-selected="true">
            1. Adopción de Empresas por Dominio
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-4 py-2" id="tab-alignment-btn" data-bs-toggle="pill" data-bs-target="#tab-alignment" type="button" role="tab" aria-controls="tab-alignment" aria-selected="false">
            2. Alineación a Tecnología Corporativa
        </button>
    </li>
</ul>

<div class="tab-content" id="reportTabsContent">
    <!-- SECCIÓN 1: Adopción de Empresas por Dominio -->
    <div class="tab-pane fade show active" id="tab-domain" role="tabpanel" aria-labelledby="tab-domain-btn">
        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-7">
                <section class="report-card h-100">
                    <h2>Empresas con Adopción por Dominio</h2>
                    <p class="supporting-text">Cantidad de empresas que cuentan con tecnologías implementadas en cada dominio arquitectural.</p>
                    <div class="report-chart-wrap" style="min-height: 320px;">
                        <canvas id="domainAdoptionChart" aria-label="Gráfico de empresas con adopción por dominio"></canvas>
                    </div>
                </section>
            </div>
            <div class="col-12 col-lg-5">
                <section class="report-card h-100">
                    <h2>Resumen de Cobertura</h2>
                    <p class="supporting-text">Distribución global de Building Blocks por dominio.</p>
                    <div class="report-table-wrap">
                        <table class="data-grid data-table">
                            <thead>
                                <tr>
                                    <th>Dominio</th>
                                    <th class="text-center">Building Blocks</th>
                                    <th class="text-center">Empresas con Adopción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dm in Model.DomainMetrics)
                                {
                                    <tr>
                                        <td><strong>@dm.DominioNombre</strong></td>
                                        <td class="text-center"><span class="badge bg-light text-dark border">@dm.TotalBuildingBlocks</span></td>
                                        <td class="text-center"><span class="badge bg-primary">@dm.TotalEmpresasConAdopcion</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>

        <section class="report-card">
            <h2>Matriz Detallada: Building Blocks y Adopción por Empresa</h2>
            <p class="supporting-text">Desglose de cada Building Block con el estándar corporativo y las subsidiarias que tienen implementada tecnología.</p>
            <div class="report-table-wrap">
                <table class="data-grid data-table">
                    <thead>
                        <tr>
                            <th>Dominio</th>
                            <th>Building Block</th>
                            <th>Estándar Corporativo TSI</th>
                            <th class="text-center">Convocadas</th>
                            <th class="text-center">Con Adopción</th>
                            <th>Empresas con Adopción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dm in Model.DomainMetrics)
                        {
                            @foreach (var bb in dm.BuildingBlocksCoverage)
                            {
                                <tr>
                                    <td>@dm.DominioNombre</td>
                                    <td><strong>@bb.BuildingBlockNombre</strong></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(bb.TecnologiaEstandarCorporativa))
                                        {
                                            <span class="badge bg-primary text-wrap text-start">@bb.TecnologiaEstandarCorporativa</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Por definir</span>
                                        }
                                    </td>
                                    <td class="text-center">@bb.EmpresasConvocadas</td>
                                    <td class="text-center">
                                        <span class="badge @(bb.EmpresasConAdopcion > 0 ? "bg-success" : "bg-secondary")">
                                            @bb.EmpresasConAdopcion
                                        </span>
                                    </td>
                                    <td>
                                        @if (bb.EmpresasNombres.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var emp in bb.EmpresasNombres)
                                                {
                                                    <span class="badge bg-light text-dark border">@emp</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Sin implementaciones registradas</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- SECCIÓN 2: Alineación a Tecnología Corporativa -->
    <div class="tab-pane fade" id="tab-alignment" role="tabpanel" aria-labelledby="tab-alignment-btn">
        <div class="row g-4 mb-4">
            <div class="col-12 col-md-5">
                <section class="report-card h-100">
                    <h2>Distribución de Alineación</h2>
                    <p class="supporting-text">Proporción de implementaciones locales alineadas frente al estándar corporativo.</p>
                    <div class="report-chart-wrap" style="min-height: 280px;">
                        <canvas id="alignmentChart" aria-label="Gráfico de distribución de alineación"></canvas>
                    </div>
                </section>
            </div>
            <div class="col-12 col-md-7">
                <section class="report-card h-100">
                    <h2>Filtros de Búsqueda</h2>
                    <form method="get" asp-action="CompanyAdoptionByTechnology" class="row g-3">
                        <div class="col-md-6">
                            <label for="search" class="form-label small fw-bold">Buscar</label>
                            <input id="search" name="search" value="@Model.Query.Search" class="form-control form-control-sm" placeholder="Empresa, tecnología, vendor..." />
                        </div>
                        <div class="col-md-6">
                            <label for="alignmentState" class="form-label small fw-bold">Estado de Alineación</label>
                            <select id="alignmentState" name="alignmentState" class="form-select form-select-sm">
                                <option value="">Todos los estados</option>
                                <option value="ALINEADO" selected="@(Model.Query.AlignmentState == "ALINEADO")">Alineado</option>
                                <option value="HOMOLOGADO" selected="@(Model.Query.AlignmentState == "HOMOLOGADO")">Homologado</option>
                                <option value="NO_ALINEADO" selected="@(Model.Query.AlignmentState == "NO_ALINEADO")">No Alineado</option>
                                <option value="PENDIENTE" selected="@(Model.Query.AlignmentState == "PENDIENTE")">Pendiente</option>
                                <option value="NO_APLICA" selected="@(Model.Query.AlignmentState == "NO_APLICA")">No Aplica</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="dominioId" class="form-label small fw-bold">Dominio</label>
                            <select id="dominioId" name="dominioId" class="form-select form-select-sm">
                                <option value="">Todos los dominios</option>
                                @foreach (var opt in Model.DominiosFilter)
                                {
                                    <option value="@opt.Id" selected="@(Model.Query.DominioId == opt.Id)">@opt.Label</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="buildingBlockId" class="form-label small fw-bold">Building Block</label>
                            <select id="buildingBlockId" name="buildingBlockId" class="form-select form-select-sm">
                                <option value="">Todos los building blocks</option>
                                @foreach (var opt in Model.BuildingBlocksFilter)
                                {
                                    <option value="@opt.Id" selected="@(Model.Query.BuildingBlockId == opt.Id)">@opt.Label</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="empresaId" class="form-label small fw-bold">Empresa</label>
                            <select id="empresaId" name="empresaId" class="form-select form-select-sm">
                                <option value="">Todas las empresas</option>
                                @foreach (var opt in Model.EmpresasFilter)
                                {
                                    <option value="@opt.Id" selected="@(Model.Query.EmpresaId == opt.Id)">@opt.Label</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 d-flex gap-2 justify-content-end mt-3">
                            <a class="md-button md-button-text" asp-action="CompanyAdoptionByTechnology">Limpiar filtros</a>
                            <button class="md-button md-button-filled" type="submit">Aplicar filtros</button>
                        </div>
                    </form>
                </section>
            </div>
        </div>

        <section class="report-card">
            <div class="report-detail-heading mb-3">
                <div>
                    <h2>Registros de Alineación Tecnológica</h2>
                    <p class="supporting-text">Comparativa directa entre la tecnología corporativa estándar y la solución implementada por cada subsidiaria.</p>
                </div>
                <span class="result-count badge bg-light text-dark border p-2">@Model.TotalAlignmentRows registros encontrados</span>
            </div>

            @if (Model.AlignmentRows.Count == 0)
            {
                <p class="empty-state" role="status">No se encontraron registros de alineación con los filtros seleccionados.</p>
            }
            else
            {
                <div class="report-table-wrap">
                    <table class="data-grid data-table">
                        <thead>
                            <tr>
                                <th>Empresa</th>
                                <th>Dominio</th>
                                <th>Building Block</th>
                                <th>Estándar Corporativo</th>
                                <th>Tecnología Local</th>
                                <th>Versión</th>
                                <th>Vendor / Contrato</th>
                                <th class="text-center">Estado</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.AlignmentRows)
                            {
                                <tr>
                                    <td>
                                        <strong>@row.EmpresaNombre</strong>
                                        @if (!string.IsNullOrWhiteSpace(row.Pais))
                                        {
                                            <span class="badge bg-light text-secondary border ms-1">@row.Pais</span>
                                        }
                                    </td>
                                    <td>@row.DominioNombre</td>
                                    <td>@row.BuildingBlockNombre</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.TecnologiaEstandarCorporativa))
                                        {
                                            <span class="badge bg-primary text-wrap text-start">@row.TecnologiaEstandarCorporativa</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Sin estándar</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.TecnologiaLocalImplementada))
                                        {
                                            <strong>@row.TecnologiaLocalImplementada</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@(row.VersionDesplegada ?? "—")</td>
                                    <td>
                                        <div>@(row.VendorLocal ?? "—")</div>
                                        @if (!string.IsNullOrWhiteSpace(row.NumeroContratoLocal))
                                        {
                                            <small class="text-muted d-block">Contrato: @row.NumeroContratoLocal @(row.FechaFinContratoLocal.HasValue ? $"· Vence {row.FechaFinContratoLocal.Value:yyyy-MM-dd}" : "")</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @switch (row.EstadoAlineacion)
                                        {
                                            case "ALINEADO":
                                                <span class="badge bg-success">Alineado</span>
                                                break;
                                            case "HOMOLOGADO":
                                                <span class="badge bg-info text-dark">Homologado</span>
                                                break;
                                            case "NO_ALINEADO":
                                                <span class="badge bg-warning text-dark">No Alineado</span>
                                                break;
                                            case "PENDIENTE":
                                                <span class="badge bg-secondary">Pendiente</span>
                                                break;
                                            case "NO_APLICA":
                                                <span class="badge bg-light text-muted border">No Aplica</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark">@row.EstadoAlineacion</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.JustificacionNoAplica))
                                        {
                                            <small class="text-muted fst-italic">@row.JustificacionNoAplica</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav class="report-pagination mt-4" aria-label="Paginación del reporte">
                    <a class="md-button md-button-outlined @(Model.Query.Page <= 1 ? "disabled" : "")"
                       asp-action="CompanyAdoptionByTechnology"
                       asp-route-page="@(Model.Query.Page - 1)"
                       asp-route-search="@Model.Query.Search"
                       asp-route-dominioId="@Model.Query.DominioId"
                       asp-route-buildingBlockId="@Model.Query.BuildingBlockId"
                       asp-route-empresaId="@Model.Query.EmpresaId"
                       asp-route-alignmentState="@Model.Query.AlignmentState">Anterior</a>
                    <span>Página @Model.Query.Page de @Model.TotalPages · @Model.TotalAlignmentRows registros</span>
                    <a class="md-button md-button-outlined @(Model.Query.Page >= Model.TotalPages ? "disabled" : "")"
                       asp-action="CompanyAdoptionByTechnology"
                       asp-route-page="@(Model.Query.Page + 1)"
                       asp-route-search="@Model.Query.Search"
                       asp-route-dominioId="@Model.Query.DominioId"
                       asp-route-buildingBlockId="@Model.Query.BuildingBlockId"
                       asp-route-empresaId="@Model.Query.EmpresaId"
                       asp-route-alignmentState="@Model.Query.AlignmentState">Siguiente</a>
                </nav>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" crossorigin="anonymous"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('alignmentState') || urlParams.has('search') || urlParams.has('dominioId') || urlParams.has('buildingBlockId') || urlParams.has('empresaId')) {
                const alignmentTabBtn = document.getElementById('tab-alignment-btn');
                if (alignmentTabBtn) {
                    const tab = new bootstrap.Tab(alignmentTabBtn);
                    tab.show();
                }
            }

            const domainLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DomainMetrics.Select(m => m.DominioNombre)));
            const domainValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DomainMetrics.Select(m => m.TotalEmpresasConAdopcion)));
            const domainCtx = document.getElementById('domainAdoptionChart');
            if (domainCtx && domainLabels.length > 0) {
                new Chart(domainCtx, {
                    type: 'bar',
                    data: {
                        labels: domainLabels,
                        datasets: [{
                            label: 'Empresas con adopción',
                            data: domainValues,
                            backgroundColor: '#087f8c',
                            borderColor: '#05565e',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: c => ` ${c.parsed.y} empresas con tecnologías`
                                }
                            }
                        },
                        scales: {
                            x: { ticks: { autoSkip: false, maxRotation: 45 } },
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            }

            const alignCtx = document.getElementById('alignmentChart');
            if (alignCtx) {
                new Chart(alignCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Alineadas', 'Homologadas', 'No Alineadas', 'Pendientes', 'No Aplica'],
                        datasets: [{
                            data: [
                                @Model.Kpis.TotalAlineadas,
                                @Model.Kpis.TotalHomologadas,
                                @Model.Kpis.TotalNoAlineadas,
                                @Model.Kpis.TotalPendientes,
                                @Model.Kpis.TotalNoAplica
                            ],
                            backgroundColor: ['#198754', '#0dcaf0', '#ffc107', '#6c757d', '#e9ecef'],
                            borderColor: '#ffffff',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, padding: 12 }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
