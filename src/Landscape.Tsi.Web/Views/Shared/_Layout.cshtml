<!DOCTYPE html>
@inject IWebHostEnvironment HostEnvironment
<html lang="es" data-environment="@HostEnvironment.EnvironmentName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Landscape TSI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Landscape.Tsi.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Landscape TSI</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.HasClaim(Landscape.Tsi.Application.Identity.CustomClaimTypes.Permission,
                                Landscape.Tsi.Application.Identity.Permissions.UserManage) ||
                            User.HasClaim(Landscape.Tsi.Application.Identity.CustomClaimTypes.Permission,
                                Landscape.Tsi.Application.Identity.Permissions.CatalogView))
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Administración
                                </button>
                                <ul class="dropdown-menu">
                                    @if (User.HasClaim(Landscape.Tsi.Application.Identity.CustomClaimTypes.Permission,
                                        Landscape.Tsi.Application.Identity.Permissions.UserManage))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Administration" asp-action="Users">Usuarios</a></li>
                                        <li><a class="dropdown-item" asp-controller="Administration" asp-action="Index">Identidad y acceso</a></li>
                                    }
                                    @if (User.HasClaim(Landscape.Tsi.Application.Identity.CustomClaimTypes.Permission,
                                        Landscape.Tsi.Application.Identity.Permissions.CatalogView))
                                    {
                                        <li><a class="dropdown-item" asp-controller="MasterTables" asp-action="Index">Tablas Maestras</a></li>
                                        <li><a class="dropdown-item" asp-controller="TechnologyMapping" asp-action="Index">Mapeo de Tecnologías TSI</a></li>
                                        <li><a class="dropdown-item" asp-controller="AdoptionProcess" asp-action="Index">Procesos de Adopción TSI</a></li>
                                        <li><a class="dropdown-item" asp-controller="EntityView" asp-action="Index">Vista de entidades</a></li>
                                        <li><a class="dropdown-item" asp-controller="Reporting" asp-action="Index">Reportería</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (User.HasClaim(Landscape.Tsi.Application.Identity.CustomClaimTypes.Permission,
                            Landscape.Tsi.Application.Identity.Permissions.AuditView))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Audit" asp-action="Index">Auditoría</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item ms-sm-auto d-flex align-items-center gap-2">
                                <span class="nav-user">@User.Identity.Name</span>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="md-button md-button-text" type="submit">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-sm-auto">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Ingresar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main id="main-content" role="main" class="pb-3" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Landscape TSI
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/cytoscape/cytoscape.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
