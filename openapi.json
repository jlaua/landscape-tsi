{
  "openapi": "3.1.0",
  "info": {
    "title": "Landscape TSI AI Integration API",
    "description": "API segura para asistentes de IA (ChatGPT, Gemini, etc.) que permite consultar arquitectura de seguridad, catálogos, contactos anonimizados y procesos de adopción en Landscape TSI.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://landscape-tsi-dev-jlau-aefngrhne0edgyeb.southcentralus-01.azurewebsites.net"
    }
  ],
  "paths": {
    "/api/ai/catalogs/search": {
      "get": {
        "operationId": "searchCatalogs",
        "summary": "Buscar elementos en los catálogos principales (dominio, building-block, funcionalidad, familia, tecnologia-tsi, empresa-subsidiaria, driver)",
        "parameters": [
          {
            "name": "catalog",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Catálogo a consultar (dominio, building-block, funcionalidad, familia, tecnologia-tsi, empresa-subsidiaria, driver)"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Texto para filtrar"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados sanitizados (sin correos ni teléfonos privados)"
          }
        }
      }
    },
    "/api/ai/catalogs/detail": {
      "get": {
        "operationId": "getCatalogDetail",
        "summary": "Obtener el detalle de un registro específico por ID",
        "parameters": [
          {
            "name": "catalog",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del registro"
          }
        }
      }
    },
    "/api/ai/contacts": {
      "get": {
        "operationId": "listContacts",
        "summary": "Consultar contactos de vendors, partners, especialistas y CISOs (excluye correos y teléfonos por política de seguridad)",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "vendor",
                "partner",
                "especialista_empresa",
                "ciso",
                "todos"
              ]
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de contactos sanitizada"
          }
        }
      }
    },
    "/api/ai/adoption-requests": {
      "get": {
        "operationId": "listAdoptionRequests",
        "summary": "Consultar solicitudes y procesos de adopción tecnológica TSI en curso o finalizados",
        "parameters": [
          {
            "name": "processId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "ID del proceso para ver el detalle de subsidiarias convocadas y tecnologías evaluadas"
          },
          {
            "name": "statusFilter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado o detalle del proceso de adopción"
          }
        }
      }
    },
    "/api/ai/mutate": {
      "post": {
        "operationId": "mutateEntity",
        "summary": "Registrar o actualizar dominios, building blocks, funcionalidades, contactos o drivers. Requiere confirmación humana en dos pasos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "entity": {
                    "type": "string",
                    "enum": [
                      "dominio",
                      "building-block",
                      "funcionalidad",
                      "contacto-vendor",
                      "contacto-partner",
                      "contacto-empresa",
                      "driver"
                    ]
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "create",
                      "update"
                    ]
                  },
                  "id": {
                    "type": "integer"
                  },
                  "fields": {
                    "type": "object"
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "preview",
                      "execute"
                    ],
                    "default": "preview"
                  },
                  "confirm": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "entity",
                  "action",
                  "fields"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado de la vista previa o confirmación de guardado"
          }
        }
      }
    },
    "/api/ai/interpret-ocr": {
      "post": {
        "operationId": "interpretOcrData",
        "summary": "Interpretar texto plano extraído de imagen/OCR y mapearlo a las tablas destino para posterior confirmación del usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rawText": {
                    "type": "string"
                  },
                  "targetEntitySuggestion": {
                    "type": "string"
                  }
                },
                "required": [
                  "rawText"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Campos mapeados y texto de confirmación para el usuario"
          }
        }
      }
    }
  }
}
